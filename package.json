{
  "name": "reels-homem-das-cavernas",
  "version": "1.0.0",
  "private": true,
  "description": "Vídeo animado vertical (Reels/TikTok) feito com Remotion: Como era a vida de um homem das cavernas",
  "scripts": {
    "audio": "python3 scripts/generate_audio.py",
    "studio": "remotion studio",
    "render": "remotion render HomemDasCavernas out/homem-das-cavernas.mp4",
    "still": "remotion still HomemDasCavernas out/preview.png --frame=60",
    "build": "npm run audio && npm run render"
  },
  "dependencies": {
    "@fontsource/luckiest-guy": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@remotion/cli": "^4.0.543",
    "@remotion/fonts": "^4.0.543",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.543"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "typescript": "^7.0.2"
  }
}
