{"video": "geladeira-demissao", "titulo": "A geladeira pediu demissão", "fps": 30, "durationInFrames": 1800, "durationSeconds": 60.0, "engine": "elevenlabs", "voz": {"estilo": "documentario", "ritmo": 1.022}, "scenes": [{"id": "gancho", "capitulo": "A GELADEIRA PEDIU DEMISSÃO", "startFrame": 0, "endFrame": 73, "lines": [{"text": "A geladeira do Tito pediu demissão.", "startFrame": 3, "endFrame": 69, "words": [{"text": "A", "startFrame": 5, "endFrame": 6}, {"text": "geladeira", "startFrame": 8, "endFrame": 19}, {"text": "do", "startFrame": 22, "endFrame": 24}, {"text": "Tito", "startFrame": 26, "endFrame": 36}, {"text": "pediu", "startFrame": 38, "endFrame": 45}, {"text": "demissão.", "startFrame": 48, "endFrame": 69}]}]}, {"id": "motivo", "capitulo": "", "startFrame": 73, "endFrame": 268, "lines": [{"text": "Disse que tava cansada de passar frio.", "startFrame": 77, "endFrame": 176, "words": [{"text": "Disse", "startFrame": 102, "endFrame": 107}, {"text": "que", "startFrame": 108, "endFrame": 109}, {"text": "tava", "startFrame": 112, "endFrame": 119}, {"text": "cansada", "startFrame": 120, "endFrame": 138}, {"text": "de", "startFrame": 139, "endFrame": 140}, {"text": "passar", "startFrame": 142, "endFrame": 152}, {"text": "frio.", "startFrame": 154, "endFrame": 175}]}, {"text": "Pegou os óculos escuros e foi pra praia.", "startFrame": 187, "endFrame": 264, "words": [{"text": "Pegou", "startFrame": 187, "endFrame": 193}, {"text": "os", "startFrame": 196, "endFrame": 198}, {"text": "óculos", "startFrame": 200, "endFrame": 210}, {"text": "escuros", "startFrame": 212, "endFrame": 226}, {"text": "e", "startFrame": 229, "endFrame": 231}, {"text": "foi", "startFrame": 233, "endFrame": 237}, {"text": "pra", "startFrame": 239, "endFrame": 240}, {"text": "praia.", "startFrame": 243, "endFrame": 264}]}]}, {"id": "praia", "capitulo": "GELADEIRA DE FÉRIAS", "startFrame": 268, "endFrame": 425, "lines": [{"text": "Agora ela toma sol o dia inteiro, e derrete os próprios cubinhos de gelo.", "startFrame": 272, "endFrame": 421, "words": [{"text": "Agora", "startFrame": 272, "endFrame": 283}, {"text": "ela", "startFrame": 284, "endFrame": 289}, {"text": "toma", "startFrame": 290, "endFrame": 298}, {"text": "sol", "startFrame": 302, "endFrame": 305}, {"text": "o", "startFrame": 308, "endFrame": 310}, {"text": "dia", "startFrame": 312, "endFrame": 317}, {"text": "inteiro,", "startFrame": 323, "endFrame": 344}, {"text": "e", "startFrame": 345, "endFrame": 346}, {"text": "derrete", "startFrame": 348, "endFrame": 357}, {"text": "os", "startFrame": 359, "endFrame": 364}, {"text": "próprios", "startFrame": 366, "endFrame": 376}, {"text": "cubinhos", "startFrame": 378, "endFrame": 387}, {"text": "de", "startFrame": 390, "endFrame": 392}, {"text": "gelo.", "startFrame": 394, "endFrame": 420}]}]}, {"id": "capivara", "capitulo": "CAPIVARA REFRIGERADORA", "startFrame": 425, "endFrame": 720, "lines": [{"text": "Sem geladeira, o Tito contratou uma capivara.", "startFrame": 429, "endFrame": 522, "words": [{"text": "Sem", "startFrame": 429, "endFrame": 436}, {"text": "geladeira,", "startFrame": 439, "endFrame": 461}, {"text": "o", "startFrame": 464, "endFrame": 466}, {"text": "Tito", "startFrame": 468, "endFrame": 476}, {"text": "contratou", "startFrame": 479, "endFrame": 490}, {"text": "uma", "startFrame": 492, "endFrame": 494}, {"text": "capivara.", "startFrame": 498, "endFrame": 522}]}, {"text": "Ela não gela nada…", "startFrame": 534, "endFrame": 585, "words": [{"text": "Ela", "startFrame": 535, "endFrame": 540}, {"text": "não", "startFrame": 542, "endFrame": 547}, {"text": "gela", "startFrame": 549, "endFrame": 561}, {"text": "nada…", "startFrame": 563, "endFrame": 584}]}, {"text": "mas é tão calma que o leite nem tem coragem de azedar.", "startFrame": 596, "endFrame": 716, "words": [{"text": "mas", "startFrame": 617, "endFrame": 622}, {"text": "é", "startFrame": 624, "endFrame": 629}, {"text": "tão", "startFrame": 631, "endFrame": 638}, {"text": "calma", "startFrame": 641, "endFrame": 650}, {"text": "que", "startFrame": 653, "endFrame": 655}, {"text": "o", "startFrame": 656, "endFrame": 657}, {"text": "leite", "startFrame": 658, "endFrame": 667}, {"text": "nem", "startFrame": 671, "endFrame": 676}, {"text": "tem", "startFrame": 678, "endFrame": 683}, {"text": "coragem", "startFrame": 685, "endFrame": 695}, {"text": "de", "startFrame": 696, "endFrame": 697}, {"text": "azedar.", "startFrame": 702, "endFrame": 716}]}]}, {"id": "zen", "capitulo": "COZINHA ZEN", "startFrame": 720, "endFrame": 903, "lines": [{"text": "Agora o queijo medita, a manteiga faz ioga,", "startFrame": 724, "endFrame": 823, "words": [{"text": "Agora", "startFrame": 724, "endFrame": 734}, {"text": "o", "startFrame": 735, "endFrame": 738}, {"text": "queijo", "startFrame": 740, "endFrame": 747}, {"text": "medita,", "startFrame": 752, "endFrame": 772}, {"text": "a", "startFrame": 773, "endFrame": 775}, {"text": "manteiga", "startFrame": 776, "endFrame": 792}, {"text": "faz", "startFrame": 794, "endFrame": 799}, {"text": "ioga,", "startFrame": 801, "endFrame": 822}]}, {"text": "e o Tito virou o rei da cozinha zen.", "startFrame": 827, "endFrame": 899, "words": [{"text": "e", "startFrame": 828, "endFrame": 829}, {"text": "o", "startFrame": 829, "endFrame": 834}, {"text": "Tito", "startFrame": 836, "endFrame": 846}, {"text": "virou", "startFrame": 848, "endFrame": 853}, {"text": "o", "startFrame": 855, "endFrame": 857}, {"text": "rei", "startFrame": 860, "endFrame": 864}, {"text": "da", "startFrame": 867, "endFrame": 869}, {"text": "cozinha", "startFrame": 871, "endFrame": 883}, {"text": "zen.", "startFrame": 889, "endFrame": 900}]}]}, {"id": "ciumes", "capitulo": "GELADEIRA COM CIÚMES", "startFrame": 903, "endFrame": 1230, "lines": [{"text": "Só que a geladeira viu tudo pelo celular.", "startFrame": 907, "endFrame": 985, "words": [{"text": "Só", "startFrame": 912, "endFrame": 914}, {"text": "que", "startFrame": 916, "endFrame": 917}, {"text": "a", "startFrame": 918, "endFrame": 919}, {"text": "geladeira", "startFrame": 921, "endFrame": 933}, {"text": "viu", "startFrame": 934, "endFrame": 943}, {"text": "tudo", "startFrame": 945, "endFrame": 952}, {"text": "pelo", "startFrame": 954, "endFrame": 959}, {"text": "celular.", "startFrame": 961, "endFrame": 985}]}, {"text": "Ficou com tanto ciúme que voltou correndo da praia…", "startFrame": 997, "endFrame": 1096, "words": [{"text": "Ficou", "startFrame": 997, "endFrame": 1006}, {"text": "com", "startFrame": 1011, "endFrame": 1015}, {"text": "tanto", "startFrame": 1019, "endFrame": 1025}, {"text": "ciúme", "startFrame": 1027, "endFrame": 1039}, {"text": "que", "startFrame": 1040, "endFrame": 1041}, {"text": "voltou", "startFrame": 1044, "endFrame": 1053}, {"text": "correndo", "startFrame": 1056, "endFrame": 1068}, {"text": "da", "startFrame": 1069, "endFrame": 1072}, {"text": "praia…", "startFrame": 1074, "endFrame": 1095}]}, {"text": "bronzeada, de chinelo e com a porta descascando.", "startFrame": 1107, "endFrame": 1226, "words": [{"text": "bronzeada,", "startFrame": 1130, "endFrame": 1156}, {"text": "de", "startFrame": 1159, "endFrame": 1161}, {"text": "chinelo", "startFrame": 1163, "endFrame": 1180}, {"text": "e", "startFrame": 1181, "endFrame": 1182}, {"text": "com", "startFrame": 1183, "endFrame": 1184}, {"text": "a", "startFrame": 1186, "endFrame": 1187}, {"text": "porta", "startFrame": 1189, "endFrame": 1197}, {"text": "descascando.", "startFrame": 1199, "endFrame": 1226}]}]}, {"id": "entrevista", "capitulo": "ENTREVISTA DE EMPREGO", "startFrame": 1230, "endFrame": 1538, "lines": [{"text": "O Tito fez uma entrevista com as duas.", "startFrame": 1234, "endFrame": 1304, "words": [{"text": "O", "startFrame": 1234, "endFrame": 1237}, {"text": "Tito", "startFrame": 1239, "endFrame": 1248}, {"text": "fez", "startFrame": 1251, "endFrame": 1254}, {"text": "uma", "startFrame": 1255, "endFrame": 1258}, {"text": "entrevista", "startFrame": 1260, "endFrame": 1274}, {"text": "com", "startFrame": 1276, "endFrame": 1279}, {"text": "as", "startFrame": 1281, "endFrame": 1284}, {"text": "duas.", "startFrame": 1286, "endFrame": 1304}]}, {"text": "A geladeira gelou um sorvete em três segundos.", "startFrame": 1316, "endFrame": 1400, "words": [{"text": "A", "startFrame": 1318, "endFrame": 1319}, {"text": "geladeira", "startFrame": 1320, "endFrame": 1332}, {"text": "gelou", "startFrame": 1334, "endFrame": 1341}, {"text": "um", "startFrame": 1343, "endFrame": 1344}, {"text": "sorvete", "startFrame": 1345, "endFrame": 1358}, {"text": "em", "startFrame": 1361, "endFrame": 1365}, {"text": "três", "startFrame": 1367, "endFrame": 1373}, {"text": "segundos.", "startFrame": 1374, "endFrame": 1400}]}, {"text": "A capivara só piscou… e o sorvete pediu pra ficar.", "startFrame": 1411, "endFrame": 1534, "words": [{"text": "A", "startFrame": 1412, "endFrame": 1414}, {"text": "capivara", "startFrame": 1418, "endFrame": 1433}, {"text": "só", "startFrame": 1436, "endFrame": 1440}, {"text": "piscou…", "startFrame": 1443, "endFrame": 1465}, {"text": "e", "startFrame": 1487, "endFrame": 1488}, {"text": "o", "startFrame": 1490, "endFrame": 1492}, {"text": "sorvete", "startFrame": 1493, "endFrame": 1506}, {"text": "pediu", "startFrame": 1508, "endFrame": 1513}, {"text": "pra", "startFrame": 1515, "endFrame": 1518}, {"text": "ficar.", "startFrame": 1519, "endFrame": 1534}]}]}, {"id": "final", "capitulo": "", "startFrame": 1538, "endFrame": 1800, "lines": [{"text": "Agora as duas dividem a cozinha: uma gela, a outra acalma.", "startFrame": 1542, "endFrame": 1656, "words": [{"text": "Agora", "startFrame": 1546, "endFrame": 1554}, {"text": "as", "startFrame": 1556, "endFrame": 1559}, {"text": "duas", "startFrame": 1561, "endFrame": 1566}, {"text": "dividem", "startFrame": 1568, "endFrame": 1577}, {"text": "a", "startFrame": 1579, "endFrame": 1580}, {"text": "cozinha:", "startFrame": 1582, "endFrame": 1601}, {"text": "uma", "startFrame": 1604, "endFrame": 1608}, {"text": 