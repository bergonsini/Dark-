{"video": "grande-eleicao", "titulo": "A grande eleição", "fps": 30, "durationInFrames": 1800, "durationSeconds": 60.0, "engine": "elevenlabs", "voz": {"estilo": "documentario", "ritmo": 1.037}, "scenes": [{"id": "gancho", "capitulo": "O CANDIDATO MISTERIOSO", "startFrame": 0, "endFrame": 99, "lines": [{"text": "O candidato misterioso era… um micro-ondas!", "startFrame": 3, "endFrame": 96, "words": [{"text": "O", "startFrame": 3, "endFrame": 5}, {"text": "candidato", "startFrame": 5, "endFrame": 16}, {"text": "misterioso", "startFrame": 18, "endFrame": 36}, {"text": "era…", "startFrame": 42, "endFrame": 52}, {"text": "um", "startFrame": 57, "endFrame": 59}, {"text": "micro-ondas!", "startFrame": 63, "endFrame": 95}]}]}, {"id": "promessas", "capitulo": "AS PROMESSAS", "startFrame": 99, "endFrame": 447, "lines": [{"text": "Ele prometeu tudo pronto em trinta segundos. Até as férias.", "startFrame": 103, "endFrame": 234, "words": [{"text": "Ele", "startFrame": 103, "endFrame": 110}, {"text": "prometeu", "startFrame": 112, "endFrame": 126}, {"text": "tudo", "startFrame": 129, "endFrame": 138}, {"text": "pronto", "startFrame": 140, "endFrame": 149}, {"text": "em", "startFrame": 153, "endFrame": 156}, {"text": "trinta", "startFrame": 159, "endFrame": 167}, {"text": "segundos.", "startFrame": 168, "endFrame": 200}, {"text": "Até", "startFrame": 203, "endFrame": 208}, {"text": "as", "startFrame": 210, "endFrame": 214}, {"text": "férias.", "startFrame": 217, "endFrame": 234}]}, {"text": "A planta prometeu sombra e água fresca.", "startFrame": 246, "endFrame": 324, "words": [{"text": "A", "startFrame": 246, "endFrame": 248}, {"text": "planta", "startFrame": 250, "endFrame": 260}, {"text": "prometeu", "startFrame": 262, "endFrame": 276}, {"text": "sombra", "startFrame": 278, "endFrame": 292}, {"text": "e", "startFrame": 293, "endFrame": 294}, {"text": "água", "startFrame": 297, "endFrame": 303}, {"text": "fresca.", "startFrame": 305, "endFrame": 324}]}, {"text": "E o Tito prometeu… pegar a coroa de volta.", "startFrame": 336, "endFrame": 443, "words": [{"text": "E", "startFrame": 336, "endFrame": 337}, {"text": "o", "startFrame": 338, "endFrame": 340}, {"text": "Tito", "startFrame": 343, "endFrame": 352}, {"text": "prometeu…", "startFrame": 356, "endFrame": 396}, {"text": "pegar", "startFrame": 398, "endFrame": 405}, {"text": "a", "startFrame": 406, "endFrame": 408}, {"text": "coroa", "startFrame": 410, "endFrame": 419}, {"text": "de", "startFrame": 421, "endFrame": 424}, {"text": "volta.", "startFrame": 428, "endFrame": 443}]}]}, {"id": "debate", "capitulo": "O DEBATE", "startFrame": 447, "endFrame": 656, "lines": [{"text": "No debate, o micro-ondas ficou nervoso e começou a girar.", "startFrame": 451, "endFrame": 581, "words": [{"text": "No", "startFrame": 451, "endFrame": 453}, {"text": "debate,", "startFrame": 455, "endFrame": 477}, {"text": "o", "startFrame": 478, "endFrame": 479}, {"text": "micro-ondas", "startFrame": 481, "endFrame": 495}, {"text": "ficou", "startFrame": 497, "endFrame": 504}, {"text": "nervoso", "startFrame": 508, "endFrame": 535}, {"text": "e", "startFrame": 537, "endFrame": 539}, {"text": "começou", "startFrame": 543, "endFrame": 550}, {"text": "a", "startFrame": 551, "endFrame": 552}, {"text": "girar.", "startFrame": 555, "endFrame": 580}]}, {"text": "E apitou no meio da resposta!", "startFrame": 592, "endFrame": 652, "words": [{"text": "E", "startFrame": 592, "endFrame": 594}, {"text": "apitou", "startFrame": 598, "endFrame": 611}, {"text": "no", "startFrame": 614, "endFrame": 618}, {"text": "meio", "startFrame": 620, "endFrame": 625}, {"text": "da", "startFrame": 626, "endFrame": 627}, {"text": "resposta!", "startFrame": 629, "endFrame": 652}]}]}, {"id": "votacao", "capitulo": "VOTAÇÃO", "startFrame": 656, "endFrame": 895, "lines": [{"text": "A geladeira votou. A nuvem votou… e choveu na urna.", "startFrame": 660, "endFrame": 781, "words": [{"text": "A", "startFrame": 660, "endFrame": 662}, {"text": "geladeira", "startFrame": 665, "endFrame": 679}, {"text": "votou.", "startFrame": 680, "endFrame": 703}, {"text": "A", "startFrame": 704, "endFrame": 706}, {"text": "nuvem", "startFrame": 709, "endFrame": 718}, {"text": "votou…", "startFrame": 719, "endFrame": 746}, {"text": "e", "startFrame": 748, "endFrame": 750}, {"text": "choveu", "startFrame": 754, "endFrame": 763}, {"text": "na", "startFrame": 764, "endFrame": 767}, {"text": "urna.", "startFrame": 769, "endFrame": 781}]}, {"text": "E a capivara? Nem votou. Ficou meditando.", "startFrame": 792, "endFrame": 891, "words": [{"text": "E", "startFrame": 792, "endFrame": 795}, {"text": "a", "startFrame": 796, "endFrame": 797}, {"text": "capivara?", "startFrame": 801, "endFrame": 827}, {"text": "Nem", "startFrame": 829, "endFrame": 834}, {"text": "votou.", "startFrame": 836, "endFrame": 857}, {"text": "Ficou", "startFrame": 858, "endFrame": 864}, {"text": "meditando.", "startFrame": 865, "endFrame": 891}]}]}, {"id": "apuracao", "capitulo": "APURAÇÃO", "startFrame": 895, "endFrame": 1255, "lines": [{"text": "Micro-ondas, dois votos. Planta, dois votos.", "startFrame": 899, "endFrame": 1013, "words": [{"text": "Micro-ondas,", "startFrame": 899, "endFrame": 929}, {"text": "dois", "startFrame": 931, "endFrame": 936}, {"text": "votos.", "startFrame": 938, "endFrame": 964}, {"text": "Planta,", "startFrame": 966, "endFrame": 984}, {"text": "dois", "startFrame": 987, "endFrame": 994}, {"text": "votos.", "startFrame": 996, "endFrame": 1013}]}, {"text": "Tito, um voto… o dele mesmo.", "startFrame": 1025, "endFrame": 1110, "words": [{"text": "Tito,", "startFrame": 1025, "endFrame": 1046}, {"text": "um", "startFrame": 1048, "endFrame": 1050}, {"text": "voto…", "startFrame": 1052, "endFrame": 1080}, {"text": "o", "startFrame": 1083, "endFrame": 1084}, {"text": "dele", "startFrame": 1085, "endFrame": 1092}, {"text": "mesmo.", "startFrame": 1094, "endFrame": 1110}]}, {"text": "Empate! E a regra de desempate era: vence o mais calmo.", "startFrame": 1122, "endFrame": 1251, "words": [{"text": "Empate!", "startFrame": 1122, "endFrame": 1154}, {"text": "E", "startFrame": 1155, "endFrame": 1156}, {"text": "a", "startFrame": 1159, "endFrame": 1161}, {"text": "regra", "startFrame": 1163, "endFrame": 1170}, {"text": "de", "startFrame": 1171, "endFrame": 1172}, {"text": "desempate", "startFrame": 1176, "endFrame": 1193}, {"text": "era:", "startFrame": 1198, "endFrame": 1211}, {"text": "vence", "startFrame": 1212, "endFrame": 1221}, {"text": "o", "startFrame": 1222, "endFrame": 1223}, {"text": "mais", "startFrame": 1226, "endFrame": 1235}, {"text": "calmo.", "startFrame": 1237, "endFrame": 1251}]}]}, {"id": "resultado", "capitulo": "RAINHA CAPIVARA", "startFrame": 1255, "endFrame": 1482, "lines": [{"text": "E quem é o ser mais calmo da cozinha?", "startFrame": 1259, "endFrame": 1341, "words": [{"text": "E", "startFrame": 1259, "endFrame": 1261}, {"text": "quem", "startFrame": 1263, "endFrame": 1270}, {"text": "é", "startFrame": 1273, "endFrame": 1274}, {"text": "o", "startFrame": 1275, "endFrame": 1277}, {"text": "ser", "startFrame": 1280, "endFrame": 1287}, {"text": "mais", "startFrame": 1289, "endFrame": 1301}, {"text": "calmo", "startFrame": 1303, "endFrame": 1310}, {"text": "da", "startFrame": 1312, "endFrame": 1314}, {"text": "cozinha?", "startFrame": 1317, "endFrame": 1341}]}, {"text": "A capivara! Nem era candidata… e virou rainha!", "startFrame": 1356, "endFrame": 1479, "words": [{"text": "A", "startFrame": 1359, "endFrame": 1360}, {"text": "capivara!", "startFrame": 1363, "endFrame": 1397}, {"text": "Nem", "startFrame": 1398, "endFrame": 1404}, {"text": "era", "startFrame": 1406, "endFrame": 1409}, {"text": "candidata…", "startFrame": 1410, "endFrame": 1436}, {"text": "e", "startFrame": 1437, "endFrame": 1438}, {"text": "virou", "startFrame": 1439, "endFrame": 1446}, {"text": "rainha!", "startFrame": 1448, "endFrame": 1478}]}]}, {"id": "final", "capitulo": "CONTINUA…", "startFrame": 1482, "endFrame": 1800, "lines": [{"text": "Mas o micro-ondas não aceitou a derrota…", "startFrame": 1486, "endFrame": 1562, "words": [{"text": "Mas", "startFrame": 1486, "endFrame": 1492}, {"text": "o", "startFrame": 1494, "endFrame": 1495}, {"text": "micro-ondas", "startFrame": 1499, "endFrame": 1518}, {"text": "não", "startFrame": 1519, "endFrame": 1523}, {"text": "aceitou", "startFrame": 1525, "endFrame": 1539}, {"text": "a", "startFrame": 1540, "endFrame": 1541}, {"text": "derrota…", "startFrame": 1541, "endFrame": 1561}]}, {"text": "e começou uma contagem regressiva.", "startFrame": 1573, "endFrame": 1643, "words": [{"text": "e", "startFrame": 1575, "endFrame": 1576}, {"text": "começou", "startFrame": 1581, "endFrame": 1590}, {"text": "uma", "startFrame": 1593, "endFrame": 1597}, {"text": "contagem", "startFrame": 1600, "endFrame": 1613}, {"text": "regressiva.", "startFrame": 1615, "endFrame": 1642}]}, {"text": "O que acontece no zero? Descobre no próximo episódio!", "startFrame": 1654, "endFrame": 1758, "words": [{"text": "O", "startFrame": 1654, "endFrame": 1656}, {"text": "que", "startFrame": 1658, "endFrame": 1659}, {"text": "acontece", "startFrame": 1661, "endFrame": 1677}, {"text": "no", "startFrame": 1679, "endFrame": 1681}, {"text": "zero?", "startFrame": 1684, "endFrame": 1703}, {"text": "Descobre", "startFrame": 1705, "endFrame": 1721}, {"text": "no", "startFrame": 1723, "endFrame": 1725}, {"text": "próximo", "startFrame": 1728, "endFrame": 1737}, {"text": "episódio!", "startFrame": 1738, "endFrame": 1758}]}]}], "mouth": [0.0, 0.0, 0.0, 0.162, 0.355, 0.109, 0.361, 0.687, 0.91, 0.682, 0.699, 0.583, 0.222, 0.956, 0.771, 0.527, 0.116, 0.384, 0.649, 0.697, 0.584, 0.641, 0.091, 0.687, 0.904, 0.58, 0.752, 0.753, 0.799, 0.803, 0.837, 0.631, 0.56, 0.558, 0.422, 0.589, 0.785, 0.844, 0.829, 0.857, 0.825, 0.882, 0.572, 0.87, 0.964, 1.0, 1.0, 0.896, 0.719, 0.365, 0.34, 0.187, 0.104, 0.0, 0.0, 0.0, 0.645, 1.0, 1.0, 0.817, 0.888, 0.98, 0.881, 0.804, 1.0, 1.0, 0.535, 0.21, 0.278, 0.85