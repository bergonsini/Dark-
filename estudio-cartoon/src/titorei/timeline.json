{"video": "geladeira-demissao", "titulo": "A geladeira pediu demissão", "fps": 30, "durationInFrames": 1050, "durationSeconds": 35.0, "engine": "kokoro", "voz": {"estilo": "documentario", "ritmo": 1.0}, "scenes": [{"id": "gancho", "capitulo": "A GELADEIRA PEDIU DEMISSÃO", "startFrame": 0, "endFrame": 91, "lines": [{"text": "A geladeira do Tito pediu demissão.", "startFrame": 3, "endFrame": 81, "words": [{"text": "A", "startFrame": 3, "endFrame": 7}, {"text": "geladeira", "startFrame": 7, "endFrame": 29}, {"text": "do", "startFrame": 29, "endFrame": 35}, {"text": "Tito", "startFrame": 35, "endFrame": 45}, {"text": "pediu", "startFrame": 45, "endFrame": 60}, {"text": "demissão.", "startFrame": 60, "endFrame": 81}]}]}, {"id": "motivo", "capitulo": "", "startFrame": 91, "endFrame": 281, "lines": [{"text": "Disse que tava cansada de passar frio.", "startFrame": 101, "endFrame": 180, "words": [{"text": "Disse", "startFrame": 101, "endFrame": 113}, {"text": "que", "startFrame": 113, "endFrame": 119}, {"text": "tava", "startFrame": 119, "endFrame": 128}, {"text": "cansada", "startFrame": 128, "endFrame": 151}, {"text": "de", "startFrame": 151, "endFrame": 155}, {"text": "passar", "startFrame": 155, "endFrame": 167}, {"text": "frio.", "startFrame": 167, "endFrame": 180}]}, {"text": "Pegou os óculos escuros e foi pra praia.", "startFrame": 191, "endFrame": 271, "words": [{"text": "Pegou", "startFrame": 191, "endFrame": 203}, {"text": "os", "startFrame": 203, "endFrame": 209}, {"text": "óculos", "startFrame": 209, "endFrame": 224}, {"text": "escuros", "startFrame": 224, "endFrame": 240}, {"text": "e", "startFrame": 240, "endFrame": 242}, {"text": "foi", "startFrame": 242, "endFrame": 249}, {"text": "pra", "startFrame": 249, "endFrame": 255}, {"text": "praia.", "startFrame": 255, "endFrame": 271}]}]}, {"id": "praia", "capitulo": "GELADEIRA DE FÉRIAS", "startFrame": 281, "endFrame": 433, "lines": [{"text": "Agora ela toma sol o dia inteiro, e derrete os próprios cubinhos de gelo.", "startFrame": 291, "endFrame": 423, "words": [{"text": "Agora", "startFrame": 291, "endFrame": 303}, {"text": "ela", "startFrame": 303, "endFrame": 308}, {"text": "toma", "startFrame": 308, "endFrame": 318}, {"text": "sol", "startFrame": 318, "endFrame": 325}, {"text": "o", "startFrame": 325, "endFrame": 327}, {"text": "dia", "startFrame": 327, "endFrame": 336}, {"text": "inteiro,", "startFrame": 336, "endFrame": 349}, {"text": "e", "startFrame": 356, "endFrame": 360}, {"text": "derrete", "startFrame": 360, "endFrame": 372}, {"text": "os", "startFrame": 372, "endFrame": 378}, {"text": "próprios", "startFrame": 378, "endFrame": 390}, {"text": "cubinhos", "startFrame": 390, "endFrame": 408}, {"text": "de", "startFrame": 408, "endFrame": 415}, {"text": "gelo.", "startFrame": 415, "endFrame": 423}]}]}, {"id": "capivara", "capitulo": "CAPIVARA REFRIGERADORA", "startFrame": 433, "endFrame": 719, "lines": [{"text": "Sem geladeira, o Tito contratou uma capivara.", "startFrame": 443, "endFrame": 534, "words": [{"text": "Sem", "startFrame": 443, "endFrame": 453}, {"text": "geladeira,", "startFrame": 453, "endFrame": 472}, {"text": "o", "startFrame": 475, "endFrame": 478}, {"text": "Tito", "startFrame": 478, "endFrame": 487}, {"text": "contratou", "startFrame": 487, "endFrame": 507}, {"text": "uma", "startFrame": 507, "endFrame": 517}, {"text": "capivara.", "startFrame": 517, "endFrame": 534}]}, {"text": "Ela não gela nada…", "startFrame": 546, "endFrame": 592, "words": [{"text": "Ela", "startFrame": 546, "endFrame": 553}, {"text": "não", "startFrame": 553, "endFrame": 569}, {"text": "gela", "startFrame": 569, "endFrame": 581}, {"text": "nada…", "startFrame": 581, "endFrame": 592}]}, {"text": "mas é tão calma que o leite nem tem coragem de azedar.", "startFrame": 603, "endFrame": 709, "words": [{"text": "mas", "startFrame": 603, "endFrame": 610}, {"text": "é", "startFrame": 610, "endFrame": 613}, {"text": "tão", "startFrame": 613, "endFrame": 621}, {"text": "calma", "startFrame": 621, "endFrame": 633}, {"text": "que", "startFrame": 633, "endFrame": 638}, {"text": "o", "startFrame": 638, "endFrame": 643}, {"text": "leite", "startFrame": 643, "endFrame": 657}, {"text": "nem", "startFrame": 657, "endFrame": 666}, {"text": "tem", "startFrame": 666, "endFrame": 674}, {"text": "coragem", "startFrame": 674, "endFrame": 690}, {"text": "de", "startFrame": 690, "endFrame": 697}, {"text": "azedar.", "startFrame": 697, "endFrame": 709}]}]}, {"id": "zen", "capitulo": "COZINHA ZEN", "startFrame": 719, "endFrame": 912, "lines": [{"text": "Agora o queijo medita, a manteiga faz ioga,", "startFrame": 730, "endFrame": 820, "words": [{"text": "Agora", "startFrame": 730, "endFrame": 743}, {"text": "o", "startFrame": 743, "endFrame": 746}, {"text": "queijo", "startFrame": 746, "endFrame": 760}, {"text": "medita,", "startFrame": 760, "endFrame": 774}, {"text": "a", "startFrame": 777, "endFrame": 779}, {"text": "manteiga", "startFrame": 779, "endFrame": 800}, {"text": "faz", "startFrame": 800, "endFrame": 809}, {"text": "ioga,", "startFrame": 809, "endFrame": 820}]}, {"text": "e o Tito virou o rei da cozinha zen.", "startFrame": 824, "endFrame": 902, "words": [{"text": "e", "startFrame": 824, "endFrame": 830}, {"text": "o", "startFrame": 830, "endFrame": 832}, {"text": "Tito", "startFrame": 832, "endFrame": 844}, {"text": "virou", "startFrame": 844, "endFrame": 858}, {"text": "o", "startFrame": 858, "endFrame": 860}, {"text": "rei", "startFrame": 860, "endFrame": 868}, {"text": "da", "startFrame": 868, "endFrame": 876}, {"text": "cozinha", "startFrame": 876, "endFrame": 892}, {"text": "zen.", "startFrame": 892, "endFrame": 902}]}]}, {"id": "final", "capitulo": "", "startFrame": 912, "endFrame": 1050, "lines": [{"text": "Segue pra ver o que o Tito contrata amanhã!", "startFrame": 922, "endFrame": 1002, "words": [{"text": "Segue", "startFrame": 922, "endFrame": 933}, {"text": "pra", "startFrame": 933, "endFrame": 939}, {"text": "ver", "startFrame": 939, "endF