{"video": "nuvem-funcionaria", "titulo": "O funcionário nuvem", "fps": 30, "durationInFrames": 1800, "durationSeconds": 60.0, "engine": "kokoro", "voz": {"estilo": "documentario", "ritmo": 1.0}, "scenes": [{"id": "gancho", "capitulo": "O NOVO FUNCIONÁRIO É UMA NUVEM", "startFrame": 0, "endFrame": 90, "lines": [{"text": "O novo funcionário do Tito… é uma nuvem.", "startFrame": 3, "endFrame": 81, "words": [{"text": "O", "startFrame": 3, "endFrame": 6}, {"text": "novo", "startFrame": 6, "endFrame": 16}, {"text": "funcionário", "startFrame": 16, "endFrame": 39}, {"text": "do", "startFrame": 39, "endFrame": 46}, {"text": "Tito…", "startFrame": 46, "endFrame": 53}, {"text": "é", "startFrame": 56, "endFrame": 60}, {"text": "uma", "startFrame": 60, "endFrame": 65}, {"text": "nuvem.", "startFrame": 65, "endFrame": 81}]}]}, {"id": "recap", "capitulo": "", "startFrame": 90, "endFrame": 326, "lines": [{"text": "Isso mesmo: uma nuvem de verdade.", "startFrame": 98, "endFrame": 169, "words": [{"text": "Isso", "startFrame": 98, "endFrame": 107}, {"text": "mesmo:", "startFrame": 107, "endFrame": 121}, {"text": "uma", "startFrame": 123, "endFrame": 130}, {"text": "nuvem", "startFrame": 130, "endFrame": 146}, {"text": "de", "startFrame": 146, "endFrame": 151}, {"text": "verdade.", "startFrame": 151, "endFrame": 169}]}, {"text": "Depois da geladeira e da capivara, faltava alguém pra regar as plantas.", "startFrame": 181, "endFrame": 317, "words": [{"text": "Depois", "startFrame": 181, "endFrame": 195}, {"text": "da", "startFrame": 195, "endFrame": 198}, {"text": "geladeira", "startFrame": 198, "endFrame": 219}, {"text": "e", "startFrame": 219, "endFrame": 222}, {"text": "da", "startFrame": 222, "endFrame": 225}, {"text": "capivara,", "startFrame": 225, "endFrame": 242}, {"text": "faltava", "startFrame": 250, "endFrame": 268}, {"text": "alguém", "startFrame": 268, "endFrame": 283}, {"text": "pra", "startFrame": 283, "endFrame": 287}, {"text": "regar", "startFrame": 287, "endFrame": 298}, {"text": "as", "startFrame": 298, "endFrame": 304}, {"text": "plantas.", "startFrame": 304, "endFrame": 317}]}]}, {"id": "jardineira", "capitulo": "NUVEM JARDINEIRA", "startFrame": 326, "endFrame": 590, "lines": [{"text": "A nuvem olhou o vaso… e choveu só nele.", "startFrame": 335, "endFrame": 412, "words": [{"text": "A", "startFrame": 335, "endFrame": 337}, {"text": "nuvem", "startFrame": 337, "endFrame": 351}, {"text": "olhou", "startFrame": 351, "endFrame": 364}, {"text": "o", "startFrame": 364, "endFrame": 369}, {"text": "vaso…", "startFrame": 369, "endFrame": 376}, {"text": "e", "startFrame": 378, "endFrame": 383}, {"text": "choveu", "startFrame": 383, "endFrame": 395}, {"text": "só", "startFrame": 395, "endFrame": 403}, {"text": "nele.", "startFrame": 403, "endFrame": 412}]}, {"text": "A planta cresceu tanto que pediu aumento.", "startFrame": 424, "endFrame": 502, "words": [{"text": "A", "startFrame": 424, "endFrame": 428}, {"text": "planta", "startFrame": 428, "endFrame": 438}, {"text": "cresceu", "startFrame": 438, "endFrame": 454}, {"text": "tanto", "startFrame": 454, "endFrame": 465}, {"text": "que", "startFrame": 465, "endFrame": 469}, {"text": "pediu", "startFrame": 469, "endFrame": 480}, {"text": "aumento.", "startFrame": 480, "endFrame": 502}]}, {"text": "Tudo perfeito… até ela espirrar.", "startFrame": 514, "endFrame": 581, "words": [{"text": "Tudo", "startFrame": 514, "endFrame": 523}, {"text": "perfeito…", "startFrame": 523, "endFrame": 546}, {"text": "até", "startFrame": 548, "endFrame": 558}, {"text": "ela", "startFrame": 558, "endFrame": 567}, {"text": "espirrar.", "startFrame": 567, "endFrame": 581}]}]}, {"id": "tempestade", "capitulo": "TEMPESTADE NA COZINHA", "startFrame": 590, "endFrame": 974, "lines": [{"text": "Atchim! O espirro virou tempestade.", "startFrame": 598, "endFrame": 670, "words": [{"text": "Atchim!", "startFrame": 598, "endFrame": 619}, {"text": "O", "startFrame": 621, "endFrame": 626}, {"text": "espirro", "startFrame": 626, "endFrame": 638}, {"text": "virou", "startFrame": 638, "endFrame": 646}, {"text": "tempestade.", "startFrame": 646, "endFrame": 670}]}, {"text": "A capivara nem se mexeu,", "startFrame": 682, "endFrame": 737, "words": [{"text": "A", "startFrame": 682, "endFrame": 686}, {"text": "capivara", "startFrame": 686, "endFrame": 707}, {"text": "nem", "startFrame": 707, "endFrame": 716}, {"text": "se", "startFrame": 716, "endFrame": 721}, {"text": "mexeu,", "startFrame": 721, "endFrame": 737}]}, {"text": "a geladeira adorou o friozinho,", "startFrame": 741, "endFrame": 802, "words": [{"text": "a", "startFrame": 741, "endFrame": 744}, {"text": "geladeira", "startFrame": 744, "endFrame": 768}, {"text": "adorou", "startFrame": 768, "endFrame": 782}, {"text": "o", "startFrame": 782, "endFrame": 784}, {"text": "friozinho,", "startFrame": 784, "endFrame": 802}]}, {"text": "até o queijo parou de meditar,", "startFrame": 807, "endFrame": 873, "words": [{"text": "até", "startFrame": 807, "endFrame": 817}, {"text": "o", "startFrame": 817, "endFrame": 820}, {"text": "queijo", "startFrame": 820, "endFrame": 834}, {"text": "parou", "startFrame": 834, "endFrame": 848}, {"text": "de", "startFrame": 848, "endFrame": 853}, {"text": "meditar,", "startFrame": 853, "endFrame": 873}]}, {"text": "e o Tito ficou encharcado da coroa ao tênis.", "startFrame": 877, "endFrame": 965, "words": [{"text": "e", "startFrame": 877, "endFrame": 880}, {"text": "o", "startFrame": 880, "endFrame": 884}, {"text": "Tito", "startFrame": 884, "endFrame": 893}, {"text": "ficou", "startFrame": 893, "endFrame": 903}, {"text": "encharcado", "startFrame": 903, "endFrame": 932}, {"text": "da", "startFrame": 932, "endFrame": 936}, {"text": "coroa", "startFrame": 936, "endFrame": 947}, {"text": "ao", "startFrame": 947, "endFrame": 956}, {"text": "tênis.", "startFrame": 956, "endFrame": 965}]}]}, {"id": "musica", "capitulo": "CANÇÃO PRA NUVEM", "startFrame": 974, "endFrame": 1245, "lines": [{"text": "Pra acalmar a nuvem, o Tito cantou uma música.", "startFrame": 983, "endFrame": 1075, "words": [{"text": "Pra", "startFrame": 983, "endFrame": 989}, {"text": "acalmar", "startFrame": 989, "endFrame": 1005}, {"text": "a", "startFrame": 1005, "endFrame": 1008}, {"text": "nuvem,", "startFrame": 1008, "endFrame": 1021}, {"text": "o", "startFrame": 1025, "endFrame": 1028}, {"text": "Tito", "startFrame": 1028, "endFrame": 1040}, {"text": "cantou", "startFrame": 1040, "endFrame": 1052}, {"text": "uma", "startFrame": 1052, "endFrame": 1062}, {"text": "música.", "startFrame": 1062, "endFrame": 1075}]}, {"text": "Desafinado, mas com coroa.", "startFrame": 1087, "endFrame": 1144, "words": [{"text": "Desafinado,", "startFrame": 1087, "endFrame": 1113}, {"text": "mas", "startFrame": 1113, "endFrame": 1120}, {"text": "com", "startFrame": 1120, "endFrame": 1127}, {"text": "coroa.", "startFrame": 1127, "endFrame": 1144}]}, {"text": "Ela gostou tanto que soltou um arco-íris!", "startFrame": 1155, "endFrame": 1237, "words": [{"text": "Ela", "startFrame": 1155, "endFrame": 1164}, {"text": "gostou", "startFrame": 1164, "endFrame": 1178}, {"text": "tanto", "startFrame": 1178, "endFrame": 1191}, {"text": "que", "startFrame": 1191, "endFrame": 1194}, {"text": "soltou", "startFrame": 1194, "endFrame": 1208}, {"text": "um", "startFrame": 1208, "endFrame": 1215}, {"text": "arco-íris!", "startFrame": 1215, "endFrame": 1237}]}]}, {"id": "arcoiris", "capitulo": "ESCORREGADOR DE ARCO-ÍRIS", "startFrame": 1245, "endFrame": 1477, "lines": [{"text": "E o leite, que era medroso, desceu o arco-íris gritando de alegria.", "startFrame": 1254, "endFrame": 1376, "words": [{"text": "E", "startFrame": 1254, "endFrame": 1257}, {"text": "o", "startFrame": 1257, "endFrame": 1261}, {"text": "leite,", "startFrame": 1261, "endFrame": 1275}, {"text": "que", "startFrame": 1275, "endFrame": 1278}, {"text": "era", "startFrame": 1278, "endFrame": 1287}, {"text": "medroso,", "startFrame": 1287, "endFrame": 1301}, {"text": "desceu", "startFr