{"video": "golpe-pipoca", "titulo": "O golpe da pipoca", "fps": 30, "durationInFrames": 1800, "durationSeconds": 60.0, "engine": "elevenlabs", "voz": {"estilo": "documentario", "ritmo": 1.0}, "scenes": [{"id": "gancho", "capitulo": "O ZERO", "startFrame": 0, "endFrame": 116, "lines": [{"text": "Chegou no zero e… PIM! Era só pipoca.", "startFrame": 3, "endFrame": 95, "words": [{"text": "Chegou", "startFrame": 5, "endFrame": 12}, {"text": "no", "startFrame": 15, "endFrame": 18}, {"text": "zero", "startFrame": 24, "endFrame": 29}, {"text": "e…", "startFrame": 32, "endFrame": 39}, {"text": "PIM!", "startFrame": 42, "endFrame": 52}, {"text": "Era", "startFrame": 65, "endFrame": 69}, {"text": "só", "startFrame": 72, "endFrame": 74}, {"text": "pipoca.", "startFrame": 76, "endFrame": 94}]}]}, {"id": "enchente", "capitulo": "ENCHENTE DE PIPOCA", "startFrame": 116, "endFrame": 419, "lines": [{"text": "Só que era pipoca DEMAIS.", "startFrame": 138, "endFrame": 196, "words": [{"text": "Só", "startFrame": 138, "endFrame": 143}, {"text": "que", "startFrame": 145, "endFrame": 148}, {"text": "era", "startFrame": 150, "endFrame": 152}, {"text": "pipoca", "startFrame": 156, "endFrame": 167}, {"text": "DEMAIS.", "startFrame": 169, "endFrame": 196}]}, {"text": "Encheu a cozinha até o teto.", "startFrame": 207, "endFrame": 285, "words": [{"text": "Encheu", "startFrame": 207, "endFrame": 221}, {"text": "a", "startFrame": 222, "endFrame": 223}, {"text": "cozinha", "startFrame": 224, "endFrame": 238}, {"text": "até", "startFrame": 243, "endFrame": 254}, {"text": "o", "startFrame": 255, "endFrame": 260}, {"text": "teto.", "startFrame": 262, "endFrame": 285}]}, {"text": "O leite saiu boiando, gritando de medo.", "startFrame": 297, "endFrame": 398, "words": [{"text": "O", "startFrame": 297, "endFrame": 299}, {"text": "leite", "startFrame": 302, "endFrame": 311}, {"text": "saiu", "startFrame": 314, "endFrame": 321}, {"text": "boiando,", "startFrame": 324, "endFrame": 346}, {"text": "gritando", "startFrame": 347, "endFrame": 366}, {"text": "de", "startFrame": 368, "endFrame": 369}, {"text": "medo.", "startFrame": 371, "endFrame": 398}]}]}, {"id": "golpe", "capitulo": "O GOLPE", "startFrame": 419, "endFrame": 662, "lines": [{"text": "Aí o micro-ondas gritou: quem tem a pipoca, manda!", "startFrame": 441, "endFrame": 551, "words": [{"text": "Aí", "startFrame": 441, "endFrame": 446}, {"text": "o", "startFrame": 448, "endFrame": 449}, {"text": "micro-ondas", "startFrame": 451, "endFrame": 465}, {"text": "gritou:", "startFrame": 467, "endFrame": 494}, {"text": "quem", "startFrame": 496, "endFrame": 499}, {"text": "tem", "startFrame": 501, "endFrame": 503}, {"text": "a", "startFrame": 505, "endFrame": 506}, {"text": "pipoca,", "startFrame": 509, "endFrame": 530}, {"text": "manda!", "startFrame": 532, "endFrame": 551}]}, {"text": "E a cozinha inteira foi pro lado dele.", "startFrame": 562, "endFrame": 640, "words": [{"text": "E", "startFrame": 562, "endFrame": 563}, {"text": "a", "startFrame": 565, "endFrame": 567}, {"text": "cozinha", "startFrame": 569, "endFrame": 584}, {"text": "inteira", "startFrame": 586, "endFrame": 608}, {"text": "foi", "startFrame": 610, "endFrame": 615}, {"text": "pro", "startFrame": 616, "endFrame": 617}, {"text": "lado", "startFrame": 620, "endFrame": 627}, {"text": "dele.", "startFrame": 631, "endFrame": 640}]}]}, {"id": "decreto", "capitulo": "DECRETO REAL", "startFrame": 662, "endFrame": 998, "lines": [{"text": "A rainha capivara nem se mexeu. Comeu uma pipoca… bem devagarinho.", "startFrame": 683, "endFrame": 844, "words": [{"text": "A", "startFrame": 683, "endFrame": 686}, {"text": "rainha", "startFrame": 688, "endFrame": 695}, {"text": "capivara", "startFrame": 698, "endFrame": 717}, {"text": "nem", "startFrame": 719, "endFrame": 727}, {"text": "se", "startFrame": 728, "endFrame": 729}, {"text": "mexeu.", "startFrame": 731, "endFrame": 761}, {"text": "Comeu", "startFrame": 769, "endFrame": 771}, {"text": "uma", "startFrame": 773, "endFrame": 775}, {"text": "pipoca…", "startFrame": 777, "endFrame": 809}, {"text": "bem", "startFrame": 811, "endFrame": 818}, {"text": "devagarinho.", "startFrame": 821, "endFrame": 844}]}, {"text": "E decretou: micro-ondas agora é ministro da pipoca!", "startFrame": 855, "endFrame": 976, "words": [{"text": "E", "startFrame": 855, "endFrame": 857}, {"text": "decretou:", "startFrame": 860, "endFrame": 891}, {"text": "micro-ondas", "startFrame": 896, "endFrame": 910}, {"text": "agora", "startFrame": 913, "endFrame": 927}, {"text": "é", "startFrame": 929, "endFrame": 932}, {"text": "ministro", "startFrame": 937, "endFrame": 949}, {"text": "da", "startFrame": 951, "endFrame": 953}, {"text": "pipoca!", "startFrame": 958, "endFrame": 976}]}]}, {"id": "tito", "capitulo": "E O TITO?", "startFrame": 998, "endFrame": 1208, "lines": [{"text": "O Tito pediu um cargo também.", "startFrame": 1019, "endFrame": 1080, "words": [{"text": "O", "startFrame": 1019, "endFrame": 1023}, {"text": "Tito", "startFrame": 1026, "endFrame": 1035}, {"text": "pediu", "startFrame": 1038, "endFrame": 1042}, {"text": "um", "startFrame": 1045, "endFrame": 1047}, {"text": "cargo", "startFrame": 1052, "endFrame": 1057}, {"text": "também.", "startFrame": 1059, "endFrame": 1080}]}, {"text": "Virou ministro do piruá.", "startFrame": 1091, "endFrame": 1186, "words": [{"text": "Virou", "startFrame": 1112, "endFrame": 1120}, {"text": "ministro", "startFrame": 1123, "endFrame": 1136}, {"text": "do", "startFrame": 1139, "endFrame": 1163}, {"text": "piruá.", "startFrame": 1165, "endFrame": 1186}]}]}, {"id": "relogio", "capitulo": "HORA DA FAXINA", "startFrame": 1208, "endFrame": 1466, "lines": [{"text": "O barulho acordou o relógio gerente.", "startFrame": 1230, "endFrame": 1295, "words": [{"text": "O", "startFrame": 1230, "endFrame": 1231}, {"text": "barulho", "startFrame": 1231, "endFrame": 1243}, {"text": "acordou", "startFrame": 1245, "endFrame": 1257}, {"text": "o", "startFrame": 1258, "endFrame": 1259}, {"text": "relógio", "startFrame": 1263, "endFrame": 1274}, {"text": "gerente.", "startFrame": 1276, "endFrame": 1295}]}, {"text": "Ele apitou: hora da faxina! E todo mundo fingiu que dormia.", "startFrame": 1307, "endFrame": 1444, "words": [{"text": "Ele", "startFrame": 1307, "endFrame": 1311}, {"text": "apitou:", "startFrame": 1314, "endFrame": 1338}, {"text": "hora", "startFrame": 1340, "endFrame": 1345}, {"text": "da", "startFrame": 1347, "endFrame": 1350}, {"text": "faxina!", "startFrame": 1353, "endFrame": 1380}, {"text": "E", "startFrame": 1387, "endFrame": 1388}, {"text": "todo", "startFrame": 1391, "endFrame": 1400}, {"text": "mundo", "startFrame": 1403, "endFrame": 1410}, {"text": "fingiu", "startFrame": 1412, "endFrame": 1422}, {"text": "que", "startFrame": 1424, "endFrame": 1427}, {"text": "dormia.", "startFrame": 1428, "endFrame": 1444}]}]}, {"id": "final", "capitulo": "CONTINUA…", "startFrame": 1466, "endFrame": 1800, "lines": [{"text": "Mas no fundo da pipoca tinha um ovo gigante…", "startFrame": 1488, "endFrame": 1586, "words": [{"text": "Mas", "startFrame": 1488, "endFrame": 1495}, {"text": "no", "startFrame": 1498, "endFrame": 1502}, {"text": "fundo", "startFrame": 1504, "endFrame": 1509}, {"text": "da", "startFrame": 1512, "endFrame": 1514}, {"text": "pipoca", "startFrame": 1518, "endFrame": 1531}, {"text": "tinha", "startFrame": 1533, "endFrame": 1538}, {"text": "um", "startFrame": 1540, "endFrame": 1543}, {"text": "ovo", "startFrame": 1545, "endFrame": 1555}, {"text": "gigante…", "startFrame": 1556, "endFrame": 1586}]}, {"text": "e ele começou a rachar.", "startFrame": 1597, "endFrame": 1648, "words": [{"text": "e", "startFrame": 1597, "endFrame": 1600}, {"text": "ele", "startFrame": 1602, "endFrame": 1607}, {"text": "começou", "startFrame": 1609, "endFrame": 1621}, {"text": "a", "startFrame": 1624, "endFrame": 1626}, {"text": "rachar.", "startFrame": 1627, "endFrame": 1648}]}, {"text": "O que vai nascer? Descobre no próximo episódio!", "startF