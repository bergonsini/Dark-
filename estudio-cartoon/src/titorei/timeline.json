{"video": "nuvem-funcionaria", "titulo": "O funcionário nuvem", "fps": 30, "durationInFrames": 1800, "durationSeconds": 60.0, "engine": "elevenlabs", "voz": {"estilo": "documentario", "ritmo": 1.07}, "scenes": [{"id": "gancho", "capitulo": "O NOVO FUNCIONÁRIO É UMA NUVEM", "startFrame": 0, "endFrame": 92, "lines": [{"text": "O novo funcionário do Tito… é uma nuvem.", "startFrame": 3, "endFrame": 88, "words": [{"text": "O", "startFrame": 7, "endFrame": 8}, {"text": "novo", "startFrame": 9, "endFrame": 14}, {"text": "funcionário", "startFrame": 16, "endFrame": 30}, {"text": "do", "startFrame": 32, "endFrame": 34}, {"text": "Tito…", "startFrame": 37, "endFrame": 57}, {"text": "é", "startFrame": 58, "endFrame": 59}, {"text": "uma", "startFrame": 61, "endFrame": 68}, {"text": "nuvem.", "startFrame": 71, "endFrame": 88}]}]}, {"id": "recap", "capitulo": "", "startFrame": 92, "endFrame": 309, "lines": [{"text": "Isso mesmo: uma nuvem de verdade.", "startFrame": 96, "endFrame": 170, "words": [{"text": "Isso", "startFrame": 96, "endFrame": 102}, {"text": "mesmo:", "startFrame": 105, "endFrame": 125}, {"text": "uma", "startFrame": 127, "endFrame": 129}, {"text": "nuvem", "startFrame": 134, "endFrame": 143}, {"text": "de", "startFrame": 145, "endFrame": 147}, {"text": "verdade.", "startFrame": 151, "endFrame": 170}]}, {"text": "Depois da geladeira e da capivara, faltava alguém pra regar as plantas.", "startFrame": 182, "endFrame": 305, "words": [{"text": "Depois", "startFrame": 182, "endFrame": 193}, {"text": "da", "startFrame": 194, "endFrame": 195}, {"text": "geladeira", "startFrame": 197, "endFrame": 215}, {"text": "e", "startFrame": 217, "endFrame": 218}, {"text": "da", "startFrame": 219, "endFrame": 220}, {"text": "capivara,", "startFrame": 222, "endFrame": 247}, {"text": "faltava", "startFrame": 248, "endFrame": 258}, {"text": "alguém", "startFrame": 260, "endFrame": 269}, {"text": "pra", "startFrame": 272, "endFrame": 274}, {"text": "regar", "startFrame": 277, "endFrame": 281}, {"text": "as", "startFrame": 283, "endFrame": 285}, {"text": "plantas.", "startFrame": 287, "endFrame": 305}]}]}, {"id": "jardineira", "capitulo": "NUVEM JARDINEIRA", "startFrame": 309, "endFrame": 610, "lines": [{"text": "A nuvem olhou o vaso… e choveu só nele.", "startFrame": 313, "endFrame": 414, "words": [{"text": "A", "startFrame": 313, "endFrame": 315}, {"text": "nuvem", "startFrame": 317, "endFrame": 326}, {"text": "olhou", "startFrame": 329, "endFrame": 335}, {"text": "o", "startFrame": 338, "endFrame": 340}, {"text": "vaso…", "startFrame": 345, "endFrame": 368}, {"text": "e", "startFrame": 370, "endFrame": 371}, {"text": "choveu", "startFrame": 374, "endFrame": 387}, {"text": "só", "startFrame": 389, "endFrame": 394}, {"text": "nele.", "startFrame": 396, "endFrame": 414}]}, {"text": "A planta cresceu tanto que pediu aumento.", "startFrame": 425, "endFrame": 517, "words": [{"text": "A", "startFrame": 443, "endFrame": 445}, {"text": "planta", "startFrame": 448, "endFrame": 454}, {"text": "cresceu", "startFrame": 456, "endFrame": 468}, {"text": "tanto", "startFrame": 470, "endFrame": 481}, {"text": "que", "startFrame": 484, "endFrame": 486}, {"text": "pediu", "startFrame": 488, "endFrame": 493}, {"text": "aumento.", "startFrame": 495, "endFrame": 517}]}, {"text": "Tudo perfeito… até ela espirrar.", "startFrame": 529, "endFrame": 606, "words": [{"text": "Tudo", "startFrame": 529, "endFrame": 536}, {"text": "perfeito…", "startFrame": 539, "endFrame": 572}, {"text": "até", "startFrame": 575, "endFrame": 581}, {"text": "ela", "startFrame": 583, "endFrame": 585}, {"text": "espirrar.", "startFrame": 588, "endFrame": 605}]}]}, {"id": "tempestade", "capitulo": "TEMPESTADE NA COZINHA", "startFrame": 610, "endFrame": 1010, "lines": [{"text": "Atchim! O espirro virou tempestade.", "startFrame": 613, "endFrame": 701, "words": [{"text": "Atchim!", "startFrame": 621, "endFrame": 631}, {"text": "O", "startFrame": 645, "endFrame": 647}, {"text": "espirro", "startFrame": 650, "endFrame": 661}, {"text": "virou", "startFrame": 663, "endFrame": 667}, {"text": "tempestade.", "startFrame": 672, "endFrame": 701}]}, {"text": "A capivara nem se mexeu,", "startFrame": 713, "endFrame": 767, "words": [{"text": "A", "startFrame": 713, "endFrame": 715}, {"text": "capivara", "startFrame": 717, "endFrame": 733}, {"text": "nem", "startFrame": 737, "endFrame": 742}, {"text": "se", "startFrame": 744, "endFrame": 745}, {"text": "mexeu,", "startFrame": 746, "endFrame": 766}]}, {"text": "a geladeira adorou o friozinho,", "startFrame": 771, "endFrame": 843, "words": [{"text": "a", "startFrame": 771, "endFrame": 773}, {"text": "geladeira", "startFrame": 776, "endFrame": 793}, {"text": "adorou", "startFrame": 796, "endFrame": 811}, {"text": "o", "startFrame": 813, "endFrame": 816}, {"text": "friozinho,", "startFrame": 817, "endFrame": 843}]}, {"text": "até o queijo parou de meditar,", "startFrame": 847, "endFrame": 905, "words": [{"text": "até", "startFrame": 847, "endFrame": 854}, {"text": "o", "startFrame": 856, "endFrame": 858}, {"text": "queijo", "startFrame": 861, "endFrame": 870}, {"text": "parou", "startFrame": 872, "endFrame": 879}, {"text": "de", "startFrame": 880, "endFrame": 881}, {"text": "meditar,", "startFrame": 883, "endFrame": 904}]}, {"text": "e o Tito ficou encharcado da coroa ao tênis.", "startFrame": 909, "endFrame": 1006, "words": [{"text": "e", "startFrame": 918, "endFrame": 920}, {"text": "o", "startFrame": 922, "endFrame": 924}, {"text": "Tito", "startFrame": 927, "endFrame": 936}, {"text": "ficou", "startFrame": 938, "endFrame": 945}, {"text": "encharcado", "startFrame": 947, "endFrame": 967}, {"text": "da", "startFrame": 968, "endFrame": 969}, {"text": "coroa", "startFrame": 972, "endFrame": 983}, {"text": "ao", "startFrame": 985, "endFrame": 987}, {"text": "tênis.", "startFrame": 990, "endFrame": 1006}]}]}, {"id": "musica", "capitulo": "CANÇÃO PRA NUVEM", "startFrame": 1010, "endFrame": 1265, "lines": [{"text": "Pra acalmar a 