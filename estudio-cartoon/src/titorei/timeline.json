{"video": "planta-rainha", "titulo": "A planta rainha", "fps": 30, "durationInFrames": 1800, "durationSeconds": 60.0, "engine": "elevenlabs", "voz": {"estilo": "documentario", "ritmo": 1.053}, "scenes": [{"id": "gancho", "capitulo": "QUEM LEVOU A COROA?", "startFrame": 0, "endFrame": 97, "lines": [{"text": "A coroa sumiu… e o Tito virou detetive!", "startFrame": 3, "endFrame": 93, "words": [{"text": "A", "startFrame": 3, "endFrame": 5}, {"text": "coroa", "startFrame": 7, "endFrame": 15}, {"text": "sumiu…", "startFrame": 17, "endFrame": 46}, {"text": "e", "startFrame": 47, "endFrame": 48}, {"text": "o", "startFrame": 49, "endFrame": 50}, {"text": "Tito", "startFrame": 54, "endFrame": 62}, {"text": "virou", "startFrame": 64, "endFrame": 68}, {"text": "detetive!", "startFrame": 71, "endFrame": 93}]}]}, {"id": "suspeitos", "capitulo": "OS SUSPEITOS", "startFrame": 97, "endFrame": 451, "lines": [{"text": "Suspeita número um: a geladeira.", "startFrame": 100, "endFrame": 173, "words": [{"text": "Suspeita", "startFrame": 100, "endFrame": 116}, {"text": "número", "startFrame": 119, "endFrame": 125}, {"text": "um:", "startFrame": 128, "endFrame": 144}, {"text": "a", "startFrame": 145, "endFrame": 146}, {"text": "geladeira.", "startFrame": 148, "endFrame": 173}]}, {"text": "Ela jurou que estava gelando.", "startFrame": 184, "endFrame": 240, "words": [{"text": "Ela", "startFrame": 184, "endFrame": 191}, {"text": "jurou", "startFrame": 193, "endFrame": 205}, {"text": "que", "startFrame": 206, "endFrame": 207}, {"text": "estava", "startFrame": 209, "endFrame": 216}, {"text": "gelando.", "startFrame": 220, "endFrame": 239}]}, {"text": "A nuvem tinha álibi: estava chovendo no banheiro.", "startFrame": 251, "endFrame": 341, "words": [{"text": "A", "startFrame": 251, "endFrame": 253}, {"text": "nuvem", "startFrame": 255, "endFrame": 265}, {"text": "tinha", "startFrame": 267, "endFrame": 274}, {"text": "álibi:", "startFrame": 276, "endFrame": 296}, {"text": "estava", "startFrame": 29