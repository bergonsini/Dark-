{"video": "tampa-coroa", "titulo": "A coroa de tampa", "fps": 30, "durationInFrames": 1800, "durationSeconds": 60.0, "engine": "kokoro", "voz": {"estilo": "documentario", "ritmo": 1.0}, "scenes": [{"id": "gancho", "capitulo": "VAI EXPLODIR!", "startFrame": 0, "endFrame": 166, "lines": [{"text": "A panela de pressão ia explodir!", "startFrame": 3, "endFrame": 72, "words": [{"text": "A", "startFrame": 3, "endFrame": 7}, {"text": "panela", "startFrame": 7, "endFrame": 20}, {"text": "de", "startFrame": 20, "endFrame": 28}, {"text": "pressão", "startFrame": 28, "endFrame": 46}, {"text": "ia", "startFrame": 46, "endFrame": 51}, {"text": "explodir!", "startFrame": 51, "endFrame": 72}]}, {"text": "E ninguém sabia desligar.", "startFrame": 83, "endFrame": 143, "words": [{"text": "E", "startFrame": 83, "endFrame": 87}, {"text": "ninguém", "startFrame": 87, "endFrame": 107}, {"text": "sabia", "startFrame": 107, "endFrame": 121}, {"text": "desligar.", "startFrame": 121, "endFrame": 143}]}]}, {"id": "panico", "capitulo": "PÂNICO NA COZINHA", "startFrame": 166, "endFrame": 450, "lines": [{"text": "O relógio acordou gritando: evacuar!", "startFrame": 188, "endFrame": 266, "words": [{"text": "O", "startFrame": 188, "endFrame": 192}, {"text": "relógio", "startFrame": 192, "endFrame": 205}, {"text": "acordou", "startFrame": 205, "endFrame": 221}, {"text": "gritando:", "startFrame": 221, "endFrame": 239}, {"text": "evacuar!", "startFrame": 241, "endFrame": 266}]}, {"text": "O leite suou tanto que virou iogurte.", "startFrame": 278, "endFrame": 354, "words": [{"text": "O", "startFrame": 278, "endFrame": 281}, {"text": "leite", "startFrame": 281, "endFrame": 297}, {"text": "suou", "startFrame": 297, "endFrame": 305}, {"text": "tanto", "startFrame": 305, "endFrame": 314}, {"text": "que", "startFrame": 314, "endFrame": 319}, {"text": "virou", "startFrame": 319, "endFrame": 332}, {"text": "iogurte.", "startFrame": 332, "endFrame": 354}]}, {"text": "E a Gelinha congelou de medo.", "startFrame": 366, "endFrame": 428, "words": [{"text": "E", "startFrame": 366, "endFrame": 368}, {"text": "a", "startFrame": 368, "endFrame": 372}, {"text": "Gelinha", "startFrame": 372, "endFrame": 390}, {"text": "congelou", "startFrame": 390, "endFrame": 409}, {"text": "de", "startFrame": 409, "endFrame": 418}, {"text": "medo.", "startFrame": 418, "endFrame": 428}]}]}, {"id": "capivara", "capitulo": "OPERAÇÃO CALMA", "startFrame": 450, "endFrame": 690, "lines": [{"text": "Só a rainha capivara não correu.", "startFrame": 473, "endFrame": 539, "words": [{"text": "Só", "startFrame": 473, "endFrame": 476}, {"text": "a", "startFrame": 476, "endFrame": 481}, {"text": "rainha", "startFrame": 481, "endFrame": 496}, {"text": "capivara", "startFrame": 496, "endFrame": 512}, {"text": "não", "startFrame": 512, "endFrame": 526}, {"text": "correu.", "startFrame": 526, "endFrame": 539}]}, {"text": "Ela foi até a panela… bem devagarinho. Um centímetro por hora.", "startFrame": 550, "endFrame": 668, "words": [{"text": "Ela", "startFrame": 550, "endFrame": 557}, {"text": "foi", "startFrame": 557, "endFrame": 565}, {"text": "até", "startFrame": 565, "endFrame": 571}, {"text": "a", "startFrame": 571, "endFrame": 575}, {"text": "panela…", "startFrame": 575, "endFrame": 587}, {"text": "bem", "startFrame": 587, "endFrame": 595}, {"text": "devagarinho.", "startFrame": 595, "endFrame": 616}, {"text": "Um", "startFrame": 623, "endFrame": 630}, {"text": "centímetro", "startFrame": 630, "endFrame": 654}, {"text": "por", "startFrame": 654, "endFrame": 661}, {"text": "hora.", "startFrame": 661, "endFrame": 668}]}]}, {"id": "abraco", "capitulo": "O ABRAÇO", "startFrame": 690, "endFrame": 894, "lines": [{"text": "Mas chegou. E deu um abraço na panela.", "startFrame": 713, "endFrame": 782, "words": [{"text": "Mas", "startFrame": 713, "endFrame": 720}, {"text": "chegou.", "startFrame": 720, "endFrame": 730}, {"text": "E", "startFrame": 734, "endFrame": 738}, {"text": "deu", "startFrame": 738, "endFrame": 744}, {"text": "um", "startFrame": 744, "endFrame": 750}, {"text": "abraço", "startFrame": 750, "endFrame": 764}, {"text": "na", "startFrame": 764, "endFrame": 768}, {"text": "panela.", "startFrame": 768, "endFrame": 782}]}, {"text": "A panela soltou todo o vapor de uma vez!", "startFrame": 793, "endFrame": 872, "words": [{"text": "A", "startFrame": 793, "endFrame": 797}, {"text": "panela", "startFrame": 797, "endFrame": 815}, {"text": "soltou", "startFrame": 815, "endFrame": 826}, {"text": "todo", "startFrame": 826, "endFrame": 836}, {"text": "o", "startFrame": 836, "endFrame": 840}, {"text": "vapor", "startFrame": 840, "endFrame": 851}, {"text": "de", "startFrame": 851, "endFrame": 857}, {"text": "uma", "startFrame": 857, "endFrame": 863}, {"text": "vez!", "startFrame": 863, "endFrame": 872}]}]}, {"id": "sauna", "capitulo": "SAUNA REAL", "startFrame": 894, "endFrame": 1018, "lines": [{"text": "A cozinha virou uma sauna. O queijo adorou.", "startFrame": 917, "endFrame": 995, "words": [{"text": "A", "startFrame": 917, "endFrame": 921}, {"text": "cozinha", "startFrame": 921, "endFrame": 934}, {"text": "virou", "startFrame": 934, "endFrame": 943}, {"text": "uma", "startFrame": 943, "endFrame": 951}, {"text": "sauna.", "startFrame": 951, "endFrame": 961}, {"text": "O", "startFrame": 965, "endFrame": 969}, {"text": "queijo", "startFrame": 969, "endFrame": 982}, {"text": "adorou.", "startFrame": 982, "endFrame": 995}]}]}, {"id": "coroa", "capitulo": "COROA DE TAMPA", "startFrame": 1018, "endFrame": 1246, "lines": [{"text": "E a tampa voou, girou… e caiu na cabeça do Tito!", "startFrame": 1040, "endFrame": 1133, "words": [{"text": "E", "startFrame": 1040, "endFrame": 1045}, {"text": "a", "startFrame": 1045, "endFrame": 1047}, {"text": "tampa", "startFrame": 1047, "endFrame": 1057}, {"text": "voou,", "startFrame": 1057, "endFrame": 1068}, {"text": "girou…", "startFrame": 1070, "endFrame": 1083}, {"text": "e", "startFrame": 1083, "endFrame": 1086}, {"text": "caiu", "startFrame": 1086, "endFrame": 1096}, {"text": "na", "startFrame": 1096, "endFrame": 1100}, {"text": "cabeça", "startFrame": 1100, "endFrame": 1115}, {"text": "do", "startFrame": 1115, "endFrame": 1123}, {"text": "Tito!", "startFrame": 1123, "endFrame": 1133}]}, {"text": "O Tito tem coroa de novo! De alumínio.", "startFrame": 1144, "endFrame": 1224, "words": [{"text": "O", "startFrame": 1144, "endFrame": 1147}, {"text": "Tito", "startFrame": 1147, "endFrame": 1159}, {"text": "tem", "startFrame": 1159, "endFrame": 1166}, {"text": "coroa", "startFrame": 1166, "endFrame": 1178}, {"text": "de", "startFrame": 1178, "endFrame": 1184}, {"text": "novo!", "startFrame": 1184, "endFrame": 1195}, {"text": "De", "startFrame": 1199, "endFrame": 1205}, {"text": "alumínio.", "startFrame": 1205, "endFrame": 1224}]}]}, {"id": "obrigado", "capitulo": "OBRIGADO, PANELA", "startFrame": 1246, "endFrame": 1516, "lines": [{"text": "A panela chorou: quarenta anos de feijão e ninguém nunca disse obrigado.", "startFrame": 1269, "endFrame": 1398, "words": [{"text": "A", "startFrame": 1269, "endFrame": 1272}, {"text": "panela", "startFrame": 1272, "endFrame": 1287}, {"text": "chorou:", "startFrame": 1287, "endFrame": 1297}, {"text": "quarenta", "startFrame": 1305, "endFrame": 1320}, {"text": "anos", "startFrame": 1320, "endFrame": 1329}, {"text": "de", "startFrame": 1329, "endFrame": 1333}, {"text": "feijão", "startFrame": 1333, "endFrame": 1350}, {"text": "e", "startFrame": 1350, "endFrame": 1353}, {"text": "ninguém", "startFrame": 1353, "endFrame": 1363}, {"text": "nunca", "startFrame": 1363, "endFrame": 1377}, {"text": "disse", "startFrame": 1377, "endFrame": 1380}, {"text": "obrigado.", "startFrame": 1380, "endFrame": 1398}]}, {"text": "Todo mundo agradeceu. E ela parou de apitar.", "startFrame": 1409, "endFrame": 1494, "words": [{"text": "Todo", "startFrame": 1409, "endFrame": 1416}, {"text": "mundo", "startFrame": 1416, "endFrame": 1428}, {"text": "agradeceu.", "startFrame": 1428, "endFrame": 1447}, {"text": "E", "startFrame": 1451, "endFrame": 1455}, {"text": "ela", "startFrame": 1455, "endFrame": 1462}, {"text": "parou", "startFrame": 1462, "endFrame": 1476}, {"text": "de", "startFrame": 1476, "endFrame": 1480}, {"text": "apitar.", "startFrame": 1480, "endFrame": 1494}]}]}, {"id": "final", "capitulo": "CONTINUA…", "startFrame": 1516, "endFrame": 1800, "lines": [{"text": "Mas no fundo da panela tinha um mapa… com um X atrás da geladeira.", "startFrame": 1539, "endFrame": 1662, "words": [{"text": "Mas", "startFrame": 1539, "endFrame": 1545}, {"text": "no", "startFrame": 1545, "endFrame": 1549}, {"text": "fundo", "startFrame": 1549, "endFrame": 1559}, {"text": "da", "startFrame": 1559, "endFrame": 1563}, {"text": "panela", "startFrame": 1563, "endFrame": 1576}, {"text": "tinha", "startFrame": 1576, "endFrame": 1587}, {"text": "um", "startFrame": 1587, "endFrame": 1589}, {"text": "mapa…", "startFrame": 1589, "endFrame": 1599}, {"text": "com", "startFrame": 1606, "endFrame": 1612}, {"text": "um", "startFrame": 1612, "endFrame": 1618}, {"text": "X", "startFrame": 1618, "endFrame": 1625}, {"text": "atrás", "startFrame": 1625, "endFrame": 1636}, {"text": "da", "startFrame": 1636, "endFrame": 1639}, {"text": "geladeira.", "startFrame": 1639, "endFrame": 1662}]}, {"text": "O que tem lá? Descobre no próximo episódio!", "startFrame": 1673, "endFrame": 1758, "words": [{"text": "O", "startFrame": 1673, "endFrame": 1676}, {"text": "que", "startFrame": 1676, "endFrame": 1682}, {"text": "tem", "startFrame": 1682, "endFrame": 1691}, {"text": "lá?", "startFrame": 1691, "endFrame": 1698}, {"text": "Descobre", "startFrame": 1702, "endFrame": 1721}, {"text": "no", "startFrame": 1721, "endFrame": 1724}, {"text": "próximo", "startFrame": 1724, "endFrame": 1737}, {"text": "episódio!", "startFrame": 1737, "endFrame": 1758}]}]}], "mouth": [0.0, 0.0, 0.0, 0.419, 1.0, 0.901, 0.072, 0.0, 0.768, 1.0, 0.913, 0.592, 0.763, 0.913, 0.977, 0.959, 0.812, 0.895, 0.994, 0.489, 0.183, 0.821, 0.