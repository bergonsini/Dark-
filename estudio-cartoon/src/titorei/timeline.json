{"video": "descongelar-tito", "titulo": "Descongelando o Tito", "fps": 30, "durationInFrames": 1800, "durationSeconds": 60.0, "engine": "kokoro", "voz": {"estilo": "documentario", "ritmo": 1.0}, "scenes": [{"id": "gancho", "capitulo": "PICOLÉ DE TITO", "startFrame": 0, "endFrame": 156, "lines": [{"text": "O Tito virou picolé!", "startFrame": 3, "endFrame": 56, "words": [{"text": "O", "startFrame": 3, "endFrame": 7}, {"text": "Tito", "startFrame": 7, "endFrame": 22}, {"text": "virou", "startFrame": 22, "endFrame": 38}, {"text": "picolé!", "startFrame": 38, "endFrame": 56}]}, {"text": "E ninguém sabia descongelar.", "startFrame": 67, "endFrame": 133, "words": [{"text": "E", "startFrame": 67, "endFrame": 71}, {"text": "ninguém", "startFrame": 71, "endFrame": 90}, {"text": "sabia", "startFrame": 90, "endFrame": 104}, {"text": "descongelar.", "startFrame": 104, "endFrame": 133}]}]}, {"id": "tentativa1", "capitulo": "TENTATIVA 1", "startFrame": 156, "endFrame": 426, "lines": [{"text": "O micro-ondas tentou esquentar.", "startFrame": 178, "endFrame": 243, "words": [{"text": "O", "startFrame": 178, "endFrame": 181}, {"text": "micro-ondas", "startFrame": 181, "endFrame": 204}, {"text": "tentou", "startFrame": 204, "endFrame": 222}, {"text": "esquentar.", "startFrame": 222, "endFrame": 244}]}, {"text": "Mas o Tito não coube na porta.", "startFrame": 255, "endFrame": 321, "words": [{"text": "Mas", "startFrame": 255, "endFrame": 262}, {"text": "o", "startFrame": 262, "endFrame": 264}, {"text": "Tito", "startFrame": 264, "endFrame": 275}, {"text": "não", "startFrame": 275, "endFrame": 286}, {"text": "coube", "startFrame": 286, "endFrame": 298}, {"text": "na", "startFrame": 298, "endFrame": 304}, {"text": "porta.", "startFrame": 304, "endFrame": 321}]}, {"text": "Só esquentou a coroa… que ele nem tem.", "startFrame": 332, "endFrame": 404, "words": [{"text": "Só", "startFrame": 332, "endFrame": 338}, {"text": "esquentou", "startFrame": 338, "endFrame": 364}, {"text": "a", "startFrame": 364, "endFrame": 369}, {"text": "coroa…", "startFrame": 369, "endFrame": 385}, {"text": "que", "startFrame": 387, "endFrame": 389}, {"text": "ele", "startFrame": 389, "endFrame": 395}, {"text": "nem", "startFrame": 395, "endFrame": 400}, {"text": "tem.", "startFrame": 400, "endFrame": 404}]}]}, {"id": "tentativa2", "capitulo": "TENTATIVA 2", "startFrame": 426, "endFrame": 670, "lines": [{"text": "A capivara sentou em cima pra esquentar… bem devagarinho.", "startFrame": 449, "endFrame": 555, "words": [{"text": "A", "startFrame": 449, "endFrame": 452}, {"text": "capivara", "startFrame": 452, "endFrame": 470}, {"text": "sentou", "startFrame": 470, "endFrame": 485}, {"text": "em", "startFrame": 485, "endFrame": 490}, {"text": "cima", "startFrame": 490, "endFrame": 498}, {"text": "pra", "startFrame": 498, "endFrame": 505}, {"text": "esquentar…", "startFrame": 505, "endFrame": 524}, {"text": "bem", "startFrame": 524, "endFrame": 532}, {"text": "devagarinho.", "startFrame": 532, "endFrame": 555}]}, {"text": "Em três horas, derreteu um centímetro.", "startFrame": 566, "endFrame": 647, "words": [{"text": "Em", "startFrame": 566, "endFrame": 573}, {"text": "três", "startFrame": 573, "endFrame": 582}, {"text": "horas,", "startFrame": 582, "endFrame": 595}, {"text": "derreteu", "startFrame": 597, "endFrame": 616}, {"text": "um", "startFrame": 616, "endFrame": 619}, {"text": "centímetro.", "startFrame": 619, "endFrame": 647}]}]}, {"id": "praia", "capitulo": "PLANO DA GELADEIRA", "startFrame": 670, "endFrame": 934, "lines": [{"text": "Aí a geladeira teve uma ideia: praia! Ela entende de bronzeado.", "startFrame": 692, "endFrame": 816, "words": [{"text": "Aí", "startFrame": 692, "endFrame": 697}, {"text": "a", "startFrame": 697, "endFrame": 700}, {"text": "geladeira", "startFrame": 700, "endFrame": 719}, {"text": "teve", "startFrame": 719, "endFrame": 723}, {"text": "uma", "startFrame": 723, "endFrame": 731}, {"text": "ideia:", "startFrame": 731, "endFrame": 742}, {"text": "praia!", "startFrame": 748, "endFrame": 759}, {"text": "Ela", "startFrame": 764, "endFrame": 770}, {"text": "entende", "startFrame": 770, "endFrame": 792}, {"text": "de", "startFrame": 792, "endFrame": 797}, {"text": "bronzeado.", "startFrame": 797, "endFrame": 816}]}, {"text": "E empurraram o bloco de gelo até a areia.", "startFrame": 828, "endFrame": 911, "words": [{"text": "E", "startFrame": 828, "endFrame": 831}, {"text": "empurraram", "startFrame": 831, "endFrame": 858}, {"text": "o", "startFrame": 858, "endFrame": 862}, {"text": "bloco", "startFrame": 862, "endFrame": 871}, {"text": "de", "startFrame": 871, "endFrame": 880}, {"text": "gelo", "startFrame": 880, "endFrame": 886}, {"text": "até", "startFrame": 886, "endFrame": 893}, {"text": "a", "startFrame": 893, "endFrame": 897}, {"text": "areia.", "startFrame": 897, "endFrame": 911}]}]}, {"id": "derrete", "capitulo": "DESCONGELOU!", "startFrame": 934, "endFrame": 1244, "lines": [{"text": "Em dois minutos de sol, o Tito derreteu…", "startFrame": 956, "endFrame": 1041, "words": [{"text": "Em", "startFrame": 956, "endFrame": 970}, {"text": "dois", "startFrame": 970, "endFrame": 986}, {"text": "minutos", "startFrame": 986, "endFrame": 1008}, {"text": "de", "startFrame": 1008, "endFrame": 1016}, {"text": "sol,", "startFrame": 1016, "endFrame": 1027}, {"text": "o", "startFrame": 1031, "endFrame": 1032}, {"text": "Tito", "startFrame": 1032, "endFrame": 1037}, {"text": "derreteu…", "startFrame": 1037, "endFrame": 1041}]}, {"text": "e saiu espirrando: atchim!", "startFrame": 1052, "endFrame": 1105, "words": [{"text": "e", "startFrame": 1052, "endFrame": 1054}, {"text": "saiu", "startFrame": 1054, "endFrame": 1070}, {"text": "espirrando:", "startFrame": 1070, "endFrame": 1090}, {"text": "atchim!", "startFrame": 1090, "endFrame": 1104}]}, {"text": "O leite trouxe uma toalha. O sorvete… derreteu junto.", "startFrame": 1116, "endFrame": 1222, "words": [{"text": "O", "startFrame": 1116, "endFrame": 1119}, {"text": "leite", "startFrame": 1119, "endFrame": 1132}, {"text": "trouxe", "startFrame": 1132, "endFrame": 1142}, {"text": "uma", "startFrame": 1142, "endFrame": 1148}, {"text": "toalha.", "startFrame": 1148, "endFrame": 1164}, {"text": "O", "startFrame": 1171, "endFrame": 1178}, {"text": "sorvete…", "startFrame": 1178, "endFrame": 1213}, {"text": "derreteu", "startFrame": 1215, "endFrame": 1221}, {"text": "junto.", "startFrame": 1221, "endFrame": 1222}]}]}, {"id": "abraco", "capitulo": "PEDIDO DE DESCULPAS", "startFrame": 1244, "endFrame": 1444, "lines": [{"text": "A Gelinha pediu desculpa e deu um abraço quentinho.", "startFrame": 1267, "endFrame": 1365, "words": [{"text": "A", "startFrame": 1267, "endFrame": 1270}, {"text": "Gelinha", "startFrame": 1270, "endFrame": 1283}, {"text": "pediu", "startFrame": 1283, "endFrame": 1296}, {"text": "desculpa", "startFrame": 1296, "endFrame": 1315}, {"text": "e", "startFrame": 1315, "endFrame": 1318}, {"text": "deu", "startFrame": 1318, "endFrame": 1327}, {"text": "um", "startFrame": 1327, "endFrame": 1332}, {"text": "abraço", "startFrame": 1332, "endFrame": 1343}, {"text": "quentinho.", "startFrame": 1343, "endFrame": 1365}]}, {"text": "Morno, na verdade.", "startFrame": 1376, "endFrame": 1421, "words": [{"text": "Morno,", "startFrame": 1376, "endFrame": 1393}, {"text": "na", "startFrame": 1393, "endFrame": 1397}, {"text": "verdade.", "startFrame": 1397, "endFrame": 1421}]}]}, {"id": "final", "capitulo": "CONTINUA…", "startFrame": 1444, "endFrame": 1800, "lines": [{"text": "Mas na água do gelo derretido boiava um bilhete…", "startFrame": 1466, "endFrame": 1563, "words": [{"text": "Mas", "startFrame": 1466, "endFrame": 1474}, {"text": "na", "startFrame": 1474, "endFrame": 1477}, {"text": "água", "startFrame": 1477, "endFrame": 1487}, {"text": "do", "startFrame": 1487, "endFrame": 1490}, {"text": "gelo", "startFrame": 1490, "endFrame": 1503}, {"text": "derretido", "startFrame": 1503, "endFrame": 1523}, {"text": "boiava", "startFrame": 1523, 