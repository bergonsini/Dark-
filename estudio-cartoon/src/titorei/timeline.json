ara:", "startFrame": 644, "endFrame": 663}, {"text": "chegar", "startFrame": 663, "endFrame": 677}, {"text": "no", "startFrame": 677, "endFrame": 683}, {"text": "horário.", "startFrame": 683, "endFrame": 698}]}, {"text": "Isso nunca vai acontecer.", "startFrame": 709, "endFrame": 768, "words": [{"text": "Isso", "startFrame": 709, "endFrame": 718}, {"text": "nunca", "startFrame": 718, "endFrame": 732}, {"text": "vai", "startFrame": 732, "endFrame": 741}, {"text": "acontecer.", "startFrame": 741, "endFrame": 768}]}]}, {"id": "turbo", "capitulo": "MODO TURBO", "startFrame": 787, "endFrame": 1160, "lines": [{"text": "Pra ninguém se atrasar, ele acelerou o tempo.", "startFrame": 806, "endFrame": 891, "words": [{"text": "Pra", "startFrame": 806, "endFrame": 811}, {"text": "ninguém", "startFrame": 811, "endFrame": 830}, {"text": "se", "startFrame": 830, "endFrame": 831}, {"text": "atrasar,", "startFrame": 831, "endFrame": 847}, {"text": "ele", "startFrame": 851, "endFrame": 857}, {"text": "acelerou", "startFrame": 857, "endFrame": 881}, {"text": "o", "startFrame": 881, "endFrame": 883}, {"text": "tempo.", "startFrame": 887, "endFrame": 891}]}, {"text": "A nuvem choveu em câmera rápida,", "startFrame": 903, "endFrame": 971, "words": [{"text": "A", "startFrame": 903, "endFrame": 906}, {"text": "nuvem", "startFrame": 906, "endFrame": 921}, {"text": "choveu", "startFrame": 921, "endFrame": 933}, {"text": "em", "startFrame": 933, "endFrame": 939}, {"text": "câmera", "startFrame": 939, "endFrame": 958}, {"text": "rápida,", "startFrame": 958, "endFrame": 971}]}, {"text": "o leite envelheceu e virou queijo,", "startFrame": 975, "endFrame": 1045, "words": [{"text": "o", "startFrame": 975, "endFrame": 978}, {"text": "leite", "startFrame": 978, "endFrame": 989}, {"text": "envelheceu", "startFrame": 989, "endFrame": 1017}, {"text": "e", "startFrame": 1017, "endFrame": 1020}, {"text": "virou", "startFrame": 1020, "endFrame": 1033}, {"text": "queijo,", "startFrame": 1033, "endFrame": 10