{"video": "geladeirinha", "titulo": "Nasceu a geladeirinha", "fps": 30, "durationInFrames": 1800, "durationSeconds": 60.0, "engine": "elevenlabs", "voz": {"estilo": "documentario", "ritmo": 1.0}, "scenes": [{"id": "gancho", "capitulo": "O OVO RACHOU", "startFrame": 0, "endFrame": 101, "lines": [{"text": "O ovo rachou… e nasceu uma geladeirinha!", "startFrame": 3, "endFrame": 93, "words": [{"text": "O", "startFrame": 3, "endFrame": 5}, {"text": "ovo", "startFrame": 7, "endFrame": 12}, {"text": "rachou…", "startFrame": 13, "endFrame": 34}, {"text": "e", "startFrame": 34, "endFrame": 35}, {"text": "nasceu", "startFrame": 37, "endFrame": 48}, {"text": "uma", "startFrame": 50, "endFrame": 59}, {"text": "geladeirinha!", "startFrame": 68, "endFrame": 93}]}]}, {"id": "mamae", "capitulo": "MAMÃE?", "startFrame": 101, "endFrame": 312, "lines": [{"text": "Ela olhou pra geladeira e disse: mamãe!", "startFrame": 109, "endFrame": 198, "words": [{"text": "Ela", "startFrame": 109, "endFrame": 114}, {"text": "olhou", "startFrame": 116, "endFrame": 123}, {"text": "pra", "startFrame": 126, "endFrame": 128}, {"text": "geladeira", "startFrame": 131, "endFrame": 145}, {"text": "e", "startFrame": 146, "endFrame": 147}, {"text": "disse:", "startFrame": 150, "endFrame": 171}, {"text": "mamãe!", "startFrame": 173, "endFrame": 198}]}, {"text": "A geladeira chorou… cubos de gelo.", "startFrame": 210, "endFrame": 304, "words": [{"text": "A", "startFrame": 210, "endFrame": 212}, {"text": "geladeira", "startFrame": 214, "endFrame": 231}, {"text": "chorou…", "startFrame": 234, "endFrame": 265}, {"text": "cubos", "startFrame": 267, "endFrame": 279}, {"text": "de", "startFrame": 282, "endFrame": 284}, {"text": "gelo.", "startFrame": 286, "endFrame": 304}]}]}, {"id": "fome", "capitulo": "BEBÊ COM FOME", "startFrame": 312, "endFrame": 580, "lines": [{"text": "Só que bebê geladeira come gelo. Muito gelo.", "startFrame": 320, "endFrame": 438, "words": [{"text": "Só", "startFrame": 320, "endFrame": 325}, {"text": "que", "startFrame": 328, "endFrame": 332}, {"text": "bebê", "startFrame": 337, "endFrame": 344}, {"text": "geladeira", "startFrame": 347, "endFrame": 361}, {"text": "come", "startFrame": 364, "endFrame": 371}, {"text": "gelo.", "startFrame": 373, "endFrame": 397}, {"text": "Muito", "startFrame": 400, "endFrame": 414}, {"text": "gelo.", "startFrame": 416, "endFrame": 438}]}, {"text": "E congelou a cozinha inteira.", "startFrame": 449, "endFrame": 511, "words": [{"text": "E", "startFrame": 449, "endFrame": 451}, {"text": "congelou", "startFrame": 454, "endFrame": 468}, {"text": "a", "startFrame": 469, "endFrame": 471}, {"text": "cozinha", "startFrame": 473, "endFrame": 483}, {"text": "inteira.", "startFrame": 485, "endFrame": 511}]}, {"text": "O leite virou picolé.", "startFrame": 523, "endFrame": 572, "words": [{"text": "O", "startFrame": 523, "endFrame": 525}, {"text": "leite", "startFrame": 527, "endFrame": 537}, {"text": "virou", "startFrame": 539, "endFrame": 546}, {"text": "picolé.", "startFrame": 549, "endFrame": 572}]}]}, {"id": "microondas", "capitulo": "MINISTRO AO RESGATE", "startFrame": 580, "endFrame": 896, "lines": [{"text": "O ministro da pipoca tentou esquentar tudo…", "startFrame": 588, "endFrame": 683, "words": [{"text": "O", "startFrame": 588, "endFrame": 591}, {"text": "ministro", "startFrame": 594, "endFrame": 605}, {"text": "da", "startFrame": 607, "endFrame": 610}, {"text": "pipoca", "startFrame": 615, "endFrame": 627}, {"text": "tentou", "startFrame": 629, "endFrame": 637}, {"text": "esquentar", "startFrame": 639, "endFrame": 658}, {"text": "tudo…", "startFrame": 660, "endFrame": 683}]}, {"text": "e estourou pipoca de novo.", "startFrame": 694, "endFrame": 781, "words": [{"text": "e", "startFrame": 715, "endFrame": 716}, {"text": "estourou", "startFrame": 718, "endFrame": 733}, {"text": "pipoca", "startFrame": 738, "endFrame": 750}, {"text": "de", "startFrame": 752, "endFrame": 754}, {"text": "novo.", "startFrame": 757, "endFrame": 781}]}, {"text": "A geladeirinha bateu palma e pediu bis!", "startFrame": 793, "endFrame": 888, "words": [{"text": "A", "startFrame": 793, "endFrame": 794}, {"text": "geladeirinha", "startFrame": 797, "endFrame": 816}, {"text": "bateu", "startFrame": 820, "endFrame": 828}, {"text": "palma", "startFrame": 832, "endFrame": 838}, {"text": "e", "startFrame": 839, "endFrame": 840}, {"text": "pediu", "startFrame": 842, "endFrame": 862}, {"text": "bis!", "startFrame": 864, "endFrame": 888}]}]}, {"id": "batismo", "capitulo": "BATISMO REAL", "startFrame": 896, "endFrame": 1181, "lines": [{"text": "A rainha capivara escolheu o nome dela… bem devagarinho.", "startFrame": 904, "endFrame": 1038, "words": [{"text": "A", "startFrame": 904, "endFrame": 906}, {"text": "rainha", "startFrame": 910, "endFrame": 916}, {"text": "capivara", "startFrame": 918, "endFrame": 935}, {"text": "escolheu", "startFrame": 937, "endFrame": 948}, {"text": "o", "startFrame": 949, "endFrame": 950}, {"text": "nome", "startFrame": 954, "endFrame": 959}, {"text": "dela…", "startFrame": 961, "endFrame": 985}, {"text": "bem", "startFrame": 988, "endFrame": 997}, {"text": "devagarinho.", "startFrame": 1001, "endFrame": 1038}]}, {"text": "Demorou três dias. O nome é Gelinha.", "startFrame": 1050, "endFrame": 1173, "words": [{"text": "Demorou", "startFrame": 1050, "endFrame": 1069}, {"text": "três", "startFrame": 1071, "endFrame": 1081}, {"text": "dias.", "startFrame": 1083, "endFrame": 1111}, {"text": "O", "startFrame": 1112, "endFrame": 1113}, {"text": "nome", "startFrame": 1114, "endFrame": 1124}, {"text": "é", "startFrame": 1131, "endFrame": 1148}, {"text": "Gelinha.", "startFrame": 1150, "endFrame": 1173}]}]}, {"id": "baba", "capitulo": "VAGA DE BABÁ", "startFrame": 1181, "endFrame": 1527, "lines": [{"text": "E o Tito? Ganhou mais um cargo: babá.", "startFrame": 1189, "endFrame": 1291, "words": [{"text": "E", "startFrame": 1189, "endFrame": 1191}, {"text": "o", "startFrame": 1193, "endFrame": 1196}, {"text"