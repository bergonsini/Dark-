{"video": "planta-rainha", "titulo": "A planta rainha", "fps": 30, "durationInFrames": 1800, "durationSeconds": 60.0, "engine": "kokoro", "voz": {"estilo": "documentario", "ritmo": 1.0}, "scenes": [{"id": "gancho", "capitulo": "QUEM LEVOU A COROA?", "startFrame": 0, "endFrame": 93, "lines": [{"text": "A coroa sumiu… e o Tito virou detetive!", "startFrame": 3, "endFrame": 81, "words": [{"text": "A", "startFrame": 3, "endFrame": 7}, {"text": "coroa", "startFrame": 7, "endFrame": 21}, {"text": "sumiu…", "startFrame": 21, "endFrame": 32}, {"text": "e", "startFrame": 32, "endFrame": 37}, {"text": "o", "startFrame": 37, "endFrame": 39}, {"text": "Tito", "startFrame": 39, "endFrame": 49}, {"text": "virou", "startFrame": 49, "endFrame": 61}, {"text": "detetive!", "startFrame": 61, "endFrame": 81}]}]}, {"id": "suspeitos", "capitulo": "OS SUSPEITOS", "startFrame": 93, "endFrame": 441, "lines": [{"text": "Suspeita número um: a geladeira.", "startFrame": 105, "endFrame": 172, "words": [{"text": "Suspeita", "startFrame": 105, "endFrame": 122}, {"text": "número", "startFrame": 122, "endFrame": 137}, {"text": "um:", "startFrame": 137, "endFrame": 144}, {"text": "a", "startFrame": 144, "endFrame": 150}, {"text": "geladeira.", "startFrame": 150, "endFrame": 172}]}, {"text": "Ela jurou que estava gelando.", "startFrame": 183, "endFrame": 243, "words": [{"text": "Ela", "startFrame": 183, "endFrame": 190}, {"text": "jurou", "startFrame": 190, "endFrame": 205}, {"text": "que", "startFrame": 205, "endFrame": 209}, {"text": "estava", "startFrame": 209, "endFrame": 223}, {"text": "gelando.", "startFrame": 223, "endFrame": 243}]}, {"text": "A nuvem tinha álibi: estava chovendo no banheiro.", "startFrame": 254, "endFrame": 352, "words": [{"text": "A", "startFrame": 254, "endFrame": 257}, {"text": "nuvem", "startFrame": 257, "endFrame": 271}, {"text": "tinha", "startFrame": 271, "endFrame": 280}, {"text": "álibi:", "startFrame": 280, "endFrame": 295}, {"text": "estava", "startFrame": 301, "endFrame": 314}, {"text": "chovendo", "startFrame": 314, "endFrame": 332}, {"text": "no", "startFrame": 332, "endFrame": 337}, {"text": "banheiro.", "startFrame": 337, "endFrame": 352}]}, {"text": "E o relógio? Dormindo. Roncando.", "startFrame": 364, "endFrame": 429, "words": [{"text": "E", "startFrame": 364, "endFrame": 367}, {"text": "o", "startFrame": 367, "endFrame": 371}, {"text": "relógio?", "startFrame": 371, "endFrame": 389}, {"text": "Dormindo.", "startFrame": 389, "endFrame": 409}, {"text": "Roncando.", "startFrame": 409, "endFrame": 429}]}]}, {"id": "capivara", "capitulo": "DETETIVE CAPIVARA", "startFrame": 441, "endFrame": 692, "lines": [{"text": "A capivara ajudou na investigação…", "startFrame": 453, "endFrame": 526, "words": [{"text": "A", "startFrame": 453, "endFrame": 457}, {"text": "capivara", "startFrame": 457, "endFrame": 475}, {"text": "ajudou", "startFrame": 475, "endFrame": 491}, {"text": "na", "startFrame": 491, "endFrame": 493}, {"text": "investigação…", "startFrame": 493, "endFrame": 526}]}, {"text": "a um centímetro por hora.", "startFrame": 538, "endFrame": 594, "words": [{"text": "a", "startFrame": 538, "endFrame": 543}, {"text": "um", "startFrame": 543, "endFrame": 549}, {"text": "centímetro", "startFrame": 549, "endFrame": 576}, {"text": "por", "startFrame": 576, "endFrame": 586}, {"text": "hora.", "startFrame": 586, "endFrame": 594}]}, {"text": "Achou a primeira pista… semana que vem.", "startFrame": 606, "endFrame": 680, "words": [{"text": "Achou", "startFrame": 606, "endFrame": 612}, {"text": "a", "startFrame": 612, "endFrame": 614}, {"text": "primeira", "startFrame": 614, "endFrame": 624}, {"text": "pista…", "startFrame": 624, "endFrame": 633}, {"text": "semana", "startFrame": 636, "endFrame": 660}, {"text": "que", "startFrame": 660, "endFrame": 664}, {"text": "vem.", "startFrame": 664, "endFrame": 680}]}]}, {"id": "pegadas", "capitulo": "AS PEGADINHAS", "startFrame": 692, "endFrame": 859, "lines": [{"text": "Aí o Tito olhou as pegadinhas de perto…", "startFrame": 704, "endFrame": 783, "words": [{"text": "Aí", "startFrame": 704, "endFrame": 712}, {"text": "o", "startFrame": 712, "endFrame": 715}, {"text": "Tito", "startFrame": 715, "endFrame": 722}, {"text": "olhou", "startFrame": 722, "endFrame": 733}, {"text": "as", "startFrame": 733, "endFrame": 740}, {"text": "pegadinhas", "startFrame": 740, "endFrame": 763}, {"text": "de", "startFrame": 763, "endFrame": 769}, {"text": "perto…", "startFrame": 769, "endFrame": 783}]}, {"text": "e elas eram de raiz!", "startFrame": 795, "endFrame": 847, "words": [{"text": "e", "startFrame": 795, "endFrame": 799}, {"text": "elas", "startFrame": 799, "endFrame": 812}, {"text": "eram", "startFrame": 812, "endFrame": 829}, {"text": "de", "startFrame": 829, "endFrame": 837}, {"text": "raiz!", "startFrame": 837, "endFrame": 847}]}]}, {"id": "culpada", "capitulo": "A RAINHA PLANTA", "startFrame": 859, "endFrame": 1107, "lines": [{"text": "Era a planta!", "startFrame": 870, "endFrame": 905, "words": [{"text": "Era", "startFrame": 870, "endFrame": 883}, {"text": "a", "startFrame": 883, "endFrame": 886}, {"text": "planta!", "startFrame": 886, "endFrame": 905}]}, {"text": "Ela tinha pedido aumento e ninguém deu.", "startFrame": 916, "endFrame": 995, "words": [{"text": "Ela", "startFrame": 916, "endFrame": 923}, {"text": "tinha", "startFrame": 923, "endFrame": 933}, {"text": "pedido", "startFrame": 933, "endFrame": 950}, {"text": "aumento", "startFrame": 950, "endFrame": 966}, {"text": "e", "startFrame": 966, "endFrame": 972}, {"text": "ninguém", "startFrame": 972, "endFrame": 989}, {"text": "deu.", "startFrame": 989, "endFrame": 995}]}, {"text": "Então se promoveu sozinha: rainha da cozinha!", "startFrame": 1007, "endFrame": 1096, "words": [{"text": "Então", "startFrame": 1007, "endFrame": 1025}, {"text": "se", "startFrame": 1025, "endFrame": 1028}, {"text": "promoveu", "startFrame": 1028, "endFrame": 1045}, {"text": "sozinha:", "startFrame": 1045, "endFrame": 1058}, {"text": "rainha", "startFrame": 1060, "endFrame": 1075}, {"text": "da", "startFrame": 1075, "endFrame": 1080}, {"text": "cozinha!", "startFrame": 1080, "endFrame": 1096}]}]}, {"id": "negociacao", "capitulo": "NEGOCIAÇÃO", "startFrame": 1107, "endFrame": 1403, "lines": [{"text": "O Tito ofereceu adubo, água e férias.", "startFrame": 1119, "endFrame": 1196, "words": [{"text": "O", "startFrame": 1119, "endFrame": 1122}, {"text": "Tito", "startFrame": 1122, "endFrame": 1130}, {"text": "ofereceu", "startFrame": 1130, "endFrame": 1153}, {"text": "adubo,", "startFrame": 1153, "endFrame": 1165}, {"text": "água", "startFrame": 1167, "endFrame": 1179}, {"text": "e", "startFrame": 1179, "endFrame": 1184}, {"text": "férias.", "startFrame": 1184, "endFrame": 1196}]}, {"text": "Ela exigiu vaso maior, sol de praia e crachá.", "startFrame": 1208, "endFrame": 1300, "words": [{"text": "Ela", "startFrame": 1208, "endFrame": 1218}, {"text": "exigiu", "startFrame": 1218, "endFrame": 1237}, {"text": "vaso", "startFrame": 1237, "endFrame": 1252}, {"text": "maior,", "startFrame": 1252, "endFrame": 1266}, {"text": "sol", "startFrame": 1269, "endFrame": 1275}, {"text": "de", "startFrame": 1275, "endFrame": 1280}, {"text": "praia", "startFrame": 1280, "endFrame": 1287}, {"text": "e", "startFrame": 1287, "endFrame": 1292}, {"text": "crachá.", "startFrame": 1292, "endFrame": 1300}]}, {"text": "Ela aceitou o adubo… e ficou com a coroa.", "startFrame": 1311, "endFrame": 1391, "words": [{"text": "Ela", "startFrame": 1311, "endFrame": 1319}, {"text": "aceitou", "startFrame": 1319, "endFrame": 1337}, {"text": "o", "startFrame": 1337, "endFrame": 1339}, {"text": "adubo…", "startFrame": 1339, "endFrame": 1349}, {"text": "e", "startFrame": 1351, "endFrame": 1354}, {"text": "ficou", "startFrame": 1354, "endFrame": 1366}, {"text": "com", "startFrame": 1366, "endFrame": 1373}, {"text": "a", "startFrame": 1373, "endFrame": 1378}, {"text": "coroa.", "startFrame": 1378, "endFrame": 1391}]}]}, {"id": "final",