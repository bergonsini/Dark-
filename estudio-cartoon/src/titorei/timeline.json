{"video": "grande-eleicao", "titulo": "A grande eleição", "fps": 30, "durationInFrames": 1800, "durationSeconds": 60.0, "engine": "kokoro", "voz": {"estilo": "documentario", "ritmo": 1.0}, "scenes": [{"id": "gancho", "capitulo": "O CANDIDATO MISTERIOSO", "startFrame": 0, "endFrame": 113, "lines": [{"text": "O candidato misterioso era… um micro-ondas!", "startFrame": 3, "endFrame": 93, "words": [{"text": "O", "startFrame": 3, "endFrame": 6}, {"text": "candidato", "startFrame": 6, "endFrame": 27}, {"text": "misterioso", "startFrame": 27, "endFrame": 50}, {"text": "era…", "startFrame": 50, "endFrame": 58}, {"text": "um", "startFrame": 61, "endFrame": 69}, {"text": "micro-ondas!", "startFrame": 69, "endFrame": 93}]}]}, {"id": "promessas", "capitulo": "AS PROMESSAS", "startFrame": 113, "endFrame": 456, "lines": [{"text": "Ele prometeu tudo pronto em trinta segundos. Até as férias.", "startFrame": 133, "endFrame": 246, "words": [{"text": "Ele", "startFrame": 133, "endFrame": 139}, {"text": "prometeu", "startFrame": 139, "endFrame": 156}, {"text": "tudo", "startFrame": 156, "endFrame": 166}, {"text": "pronto", "startFrame": 166, "endFrame": 173}, {"text": "em", "startFrame": 173, "endFrame": 180}, {"text": "trinta", "startFrame": 180, "endFrame": 194}, {"text": "segundos.", "startFrame": 194, "endFrame": 209}, {"text": "Até", "startFrame": 212, "endFrame": 222}, {"text": "as", "startFrame": 222, "endFrame": 228}, {"text": "férias.", "startFrame": 228, "endFrame": 246}]}, {"text": "A planta prometeu sombra e água fresca.", "startFrame": 258, "endFrame": 336, "words": [{"text": "A", "startFrame": 258, "endFrame": 262}, {"text": "planta", "startFrame": 262, "endFrame": 274}, {"text": "prometeu", "startFrame": 274, "endFrame": 298}, {"text": "sombra", "startFrame": 298, "endFrame": 311}, {"text": "e", "startFrame": 311, "endFrame": 313}, {"text": "água", "startFrame": 313, "endFrame": 324}, {"text": "fresca.", "startFrame": 324, "endFrame": 336}]}, {"text": "E o Tito prometeu… pegar a coroa de volta.", "startFrame": 348, "endFrame": 436, "words": [{"text": "E", "startFrame": 348, "endFrame": 351}, {"text": "o", "startFrame": 351, "endFrame": 354}, {"text": "Tito", "startFrame": 354, "endFrame": 367}, {"text": "prometeu…", "startFrame": 367, "endFrame": 386}, {"text": "pegar", "startFrame": 389, "endFrame": 401}, {"text": "a", "startFrame": 401, "endFrame": 404}, {"text": "coroa", "startFrame": 404, "endFrame": 419}, {"text": "de", "startFrame": 419, "endFrame": 426}, {"text": "volta.", "startFrame": 426, "endFrame": 436}]}]}, {"id": "debate", "capitulo": "O DEBATE", "startFrame": 456, "endFrame": 681, "lines": [{"text": "No debate, o micro-ondas ficou nervoso e começou a girar.", "startFrame": 476, "endFrame": 586, "words": [{"text": "No", "startFrame": 476, "endFrame": 480}, {"text": "debate,", "startFrame": 480, "endFrame": 496}, {"text": "o", "startFrame": 496, "endFrame": 499}, {"text": "micro-ondas", "startFrame": 499, "endFrame": 523}, {"text": "ficou", "startFrame": 523, "endFrame": 534}, {"text": "nervoso", "startFrame": 534, "endFrame": 549}, {"text": "e", "startFrame": 549, "endFrame": 553}, {"text": "começou", "startFrame": 553, "endFrame": 569}, {"text": "a", "startFrame": 569, "endFrame": 574}, {"text": "girar.", "startFrame": 574, "endFrame": 586}]}, {"text": "E apitou no meio da resposta!", "startFrame": 598, "endFrame": 661, "words": [{"text": "E", "startFrame": 598, "endFrame": 603}, {"text": "apitou", "startFrame": 603, "endFrame": 617}, {"text": "no", "startFrame": 617, "endFrame": 622}, {"text": "meio", "startFrame": 622, "endFrame": 634}, {"text": "da", "startFrame": 634, "endFrame": 642}, {"text": "resposta!", "startFrame": 642, "endFrame": 661}]}]}, {"id": "votacao", "capitulo": "VOTAÇÃO", "startFrame": 681, "endFrame": 908, "lines": [{"text": "A geladeira votou. A nuvem votou… e choveu na urna.", "startFrame": 701, "endFrame": 798, "words": [{"text": "A", "startFrame": 701, "endFrame": 703}, {"text": "geladeira", "startFrame": 703, "endFrame": 725}, {"text": "votou.", "startFrame": 725, "endFrame": 733}, {"text": "A", "startFrame": 739, "endFrame": 741}, {"text": "nuvem", "startFrame": 741, "endFrame": 751}, {"text": "votou…", "startFrame": 751, "endFrame": 757}, {"text": "e", "startFrame": 759, "endFrame": 765}, {"text": "choveu", "startFrame": 765, "endFrame": 779}, {"text": "na", "startFrame": 779, "endFrame": 785}, {"text": "urna.", "startFrame": 785, "endFrame": 798}]}, {"text": "E a capivara? Nem votou. Ficou meditando.", "startFrame": 810, "endFrame": 889, "words": [{"text": "E", "startFrame": 810, "endFrame": 815}, {"text": "a", "startFrame": 815, "endFrame": 817}, {"text": "capivara?", "startFrame": 817, "endFrame": 835}, {"text": "Nem", "startFrame": 835, "endFrame": 844}, {"text": "votou.", "startFrame": 844, "endFrame": 855}, {"text": "Ficou", "startFrame": 855, "endFrame": 867}, {"text": "meditando.", "startFrame": 867, "endFrame": 889}]}]}, {"id": "apuracao", "capitulo": "APURAÇÃO", "startFrame": 908, "endFrame": 1235, "lines": [{"text": "Micro-ondas, dois votos. Planta, dois votos.", "startFrame": 928, "endFrame": 1016, "words": [{"text": "Micro-ondas,", "startFrame": 928, "endFrame": 953}, {"text": "dois", "startFrame": 953, "endFrame": 962}, {"text": "votos.", "startFrame": 962, "endFrame": 975}, {"text": "Planta,", "startFrame": 978, "endFrame": 1002}, {"text": "dois", "startFrame": 1005, "endFrame": 1008}, {"text": "votos.", "startFrame": 1008, "endFrame": 1016}]}, {"text": "Tito, um voto… o dele mesmo.", "startFrame": 1027, "endFrame": 1091, "words": [{"text": "Tito,", "startFrame": 1027, "endFrame": 1040}, {"text": "um", "startFrame": 1042, "endFrame": 1051}, {"text": "voto…", "startFrame": 1051, "endFrame": 1061}, {"text": "o", "startFrame": 1061, "endFrame": 1064}, {"text": "dele", "startFrame": 1064, "endFrame": 1075}, {"text": "mesmo.", "startFrame": 1075, "endFrame": 1091}]}, {"text": "Empate! E a regra de desempate era: vence o mais calmo.", "startFrame": 1103, "endFrame": 1216, "words": [{"text": "Empate!", "startFrame": 1103, "endFrame": 1108}, {"text": "E", "startFrame": 1110, "endFrame": 1115}, {"text": "a", "startFrame": 1115, "endFrame": 1118}, {"text": "regra", "startFrame": 1118, "endFrame": 1131}, {"text": "de", "startFrame": 1131, "endFrame": 1135}, {"text": "desempate", "startFrame": 1135, "endFrame": 1161}, {"text": "era:", "startFrame": 1161, "endFrame": 1171}, {"text": "vence", "startFrame": 1177, "endFrame": 1189}, {"text": "o", "startFrame": 1189, "endFrame": 1194}, {"text": "mais", "startFrame": 1194, "endFrame": 1200}, {"text": "calmo.", "startFrame": 1200, "endFrame": 1216}]}]}, {"id": "resultado", "capitulo": "RAINHA CAPIVARA", "startFrame": 1235, "endFrame": 1458, "lines": [{"text": "E quem é o ser mais calmo da cozinha?", "startFrame": 1255, "endFrame": 1331, "words": [{"text": "E", "startFrame": 1255, "endFrame": 1260}, {"text": "quem", "startFrame": 1260, "endFrame": 1271}, {"text": "é", "startFrame": 1271, "endFrame": 1274}, {"text": "o", "startFrame": 1274, "endFrame": 1278}, {"text": "ser", "startFrame": 1278, "endFrame": 1285}, {"text": "mais", "startFrame": 1285, "endFrame": 1296}, {"text": "calmo", "startFrame": 1296, "endFrame": 1309}, {"text": "da", "startFrame": 1309, "endFrame": 1314}, {"text": "cozinha?", "startFrame": 1314, "endFrame": 1331}]}, {"text": "A capivara! Nem era candidata… e virou rainha!", "startFrame": 1346, "endFrame": 1438, "words": [{"text": "A", "startFrame": 1346, "endFrame": 1349}, {"text": "capivara!", "startFrame": 1349, "endFrame": 1368}, {"text": "Nem", "startFrame": 1370, "endFrame": 1380}, {"text": "era", "startFrame": 1380, "endFrame": 1386}, {"text": "candidata…", "startFrame": 1386, "endFrame": 1409}, {"text": "e", "startFrame": 1409, "endFrame": 1414}, {"text": "virou", "startFrame": 1414, "endFrame": 1426}, {"text": "rainha!", "startFrame": 1426, "endFrame": 1438}]}]}, {"id": "final", "capitulo": "CONTINUA…", "startFrame": 1458, "endFrame": 1800, "lines": [{"text": "Mas o micro-ondas não aceitou a derrota…", "startFrame": 1477, "endFrame": 1559, "words": [{"text": "Mas", "startFrame": 1477, "endFrame": 1482}, {"text": "o", "startFrame": 1482, "endFrame": 1487}, {"text": "micro-ondas", "startFrame": 1487, "endFrame": 1508}, {"text": "não", "startFrame": 1508, "endFrame": 1522}, {"text": "aceitou", "startFrame": 1522, "endFrame": 1539}, {"text": "a", "startFrame": 1539, "endFrame": 1544}, {"text": "derrota…", "startFrame": 1544, "endFrame": 1559}]}, {"text": "e começou uma contagem regressiva.", "startFrame": 1570, "endFrame": 1642, "words": [{"text": "e", "startFrame": 1570, "endFrame": 1573}, {"text": "começou", "startFrame": 1573, "endFrame": 1590}, {"text": "uma", "startFrame": 1590, "endFrame": 1601}, {"text": "contagem", "startFrame": 1601, "endFrame": 1620}, {"text": "regressiva.", "startFrame": 1620, "endFrame": 1642}]}, {"text": "O que acontece no zero? Descobre no próximo episódio!", "startFrame": 1654, "endFrame": 1758, "words": [{"text": "O", "startFrame": 1654, "endFrame": 1657}, {"text": "que", "startFrame": 1657, "endFrame": 1663}, {"text": "acontece", "startFrame": 1663, "endFrame": 1679}, {"text": "no", "startFrame": 1679, "endFrame": 1685}, {"text": "zero?", "startFrame": 1685, "endFrame": 1695}, {"text": "Descobre", "startFrame": 1702, "endFrame": 1720}, {"text": "no", "startFrame": 1720, "endFrame": 1724}, {"text": "próximo", "startFrame": 1724, "endFrame": 1737}, {"text": "episódio!", "startFrame": 1737, "endFrame": 1758}]}]}], "mouth": [0.0, 0.0, 0.0, 0.224, 0.952, 0.265, 0.0, 0.762, 1.0, 0.845, 0.659, 0.44, 0.951, 0.877, 0.631, 0.238, 0.221, 1.0, 0.747, 0.743, 0.573, 0.137, 0.0, 0.192, 0.408, 0.368, 0.542, 0.736, 0.894, 0.908, 1.0, 0.751, 0.051, 0.314, 1.0, 0.749, 0.296, 0.887, 0.868, 0.899, 1.0, 1.0, 1.0, 1.0, 0.863, 1.0, 0.925, 0.585, 0.701, 0.381, 0.469, 0.858, 0.911, 0.857, 0.343, 0.825, 0.632, 0.316, 0.053, 0.0, 0.0, 0.368, 0.674, 0.68, 0.708, 0.677, 0.933, 0.983, 0.24, 0.0, 0.2