eu", "startFrame": 1327, "endFrame": 1334}, {"text": "o", "startFrame": 1334, "endFrame": 1335}, {"text": "arco-íris", "startFrame": 1336, "endFrame": 1352}, {"text": "gritando", "startFrame": 1354, "endFrame": 1370}, {"text": "de", "startFrame": 1372, "endFrame": 1374}, {"text": "alegria.", "startFrame": 1376, "endFrame": 1399}]}, {"text": "A capivara foi atrás… bem devagarinho.", "startFrame": 1411, "endFrame": 1520, "words": [{"text": "A", "startFrame": 1420, "endFrame": 1431}, {"text": "capivara", "startFrame": 1435, "endFrame": 1449}, {"text": "foi", "startFrame": 1451, "endFrame": 1456}, {"text": "atrás…", "startFrame": 1459, "endFrame": 1482}, {"text": "bem", "startFrame": 1483, "endFrame": 1491}, {"text": "devagarinho.", "startFrame": 1495, "endFrame": 1520}]}]}, {"id": "final", "capitulo": "", "startFrame": 1524, "endFrame": 1800, "lines": [{"text": "Mas aí alguém bateu na porta…", "startFrame": 1528, "endFrame": 1579, "words": [{"text": "Mas", "startFrame": 1528, "endFrame": 1532}, {"text": "aí", "startFrame": 1534, "endFrame": 1541}, {"text": "alguém", "startFrame": 1543, "endFrame": 1550}, {"text": "bateu", "startFrame": 1554, "endFrame": 1559}, {"text": "na", "startFrame": 1561, "endFrame": 1564}, {"text": "porta…", "startFrame": 1566, "endFrame": 1579}]}, {"text": "e deixou uma caixa que fazia tic-tac.", "startFrame": 1591, "endFrame": 1666, "words": [{"text": "e", "startFrame": 1591, "endFrame": 1593}, {"text": "deixou", "startFrame": 1595, "endFrame": 1602}, {"text": "uma", "startFrame": 1604, "endFrame": 1611}, {"text": "caixa", "startFrame": 1613, "endFrame": 1622}, {"text": "que", "startFrame": 1623, "endFrame": 1624}, {"text": "fazia", "startFrame": 1627, "endFrame": 1638}, {"text": "tic-tac.", "startFrame": 1640, "endFrame": 1666}]}, {"text": "O que tem dentro? Descobre no próximo episódio!", "startFrame": 1678, "endFrame": 1762, "words": [{"text": "O", "startFrame": 1680, "endFrame": 1681}, {"text": "que", "startFrame": 1683, "endFrame": 1684},