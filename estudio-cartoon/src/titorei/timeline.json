{"video": "planta-rainha", "titulo": "A planta rainha", "fps": 30, "durationInFrames": 1800, "durationSeconds": 60.0, "engine": "elevenlabs", "voz": {"estilo": "documentario", "ritmo": 1.052}, "scenes": [{"id": "gancho", "capitulo": "QUEM LEVOU A COROA?", "startFrame": 0, "endFrame": 97, "lines": [{"text": "A coroa sumiu… e o Tito virou detetive!", "startFrame": 3, "endFrame": 94, "words": [{"text": "A", "startFrame": 3, "endFrame": 5}, {"text": "coroa", "startFrame": 7, "endFrame": 15}, {"text": "sumiu…", "startFrame": 17, "endFrame": 46}, {"text": "e", "startFrame": 47, "endFrame": 48}, {"text": "o", "startFrame": 49, "endFrame": 50}, {"text": "Tito", "startFrame": 54, "endFrame": 62}, {"text": "virou", "startFrame": 64, "endFrame": 68}, {"text": "detetive!", "startFrame": 71, "endFrame": 93}]}]}, {"id": "suspeitos", "capitulo": "OS SUSPEITOS", "startFrame": 97, "endFrame": 453, "lines": [{"text": "Suspeita número um: a geladeira.", "startFrame": 101, "endFrame": 174, "words": [{"text": "Suspeita", "startFrame": 101, "endFrame": 117}, {"text": "número", "startFrame": 119, "endFrame": 126}, {"text": "um:", "startFrame": 129, "endFrame": 144}, {"text": "a", "startFrame": 146, "endFrame": 147}, {"text": "geladeira.", "startFrame": 149, "endFrame": 174}]}, {"text": "Ela jurou que estava gelando.", "startFrame": 185, "endFrame": 241, "words": [{"text": "Ela", "startFrame": 185, "endFrame": 192}, {"text": "jurou", "startFrame": 195, "endFrame": 206}, {"text": "que", "startFrame": 207, "endFrame": 208}, {"text": "estava", "startFrame": 211, "endFrame": 217}, {"text": "gelando.", "startFrame": 221, "endFrame": 240}]}, {"text": "A nuvem tinha álibi: estava chovendo no banheiro.", "startFrame": 252, "endFrame": 342, "words": [{"text": "A", "startFrame": 252, "endFrame": 254}, {"text": "nuvem", "startFrame": 257, "endFrame": 266}, {"text": "tinha", "startFrame": 268, "endFrame": 275}, {"text": "álibi:", "startFrame": 277, "endFrame": 298}, {"text": "estava", "startFrame": 30