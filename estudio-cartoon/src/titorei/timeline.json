{"video": "geladeirinha", "titulo": "Nasceu a geladeirinha", "fps": 30, "durationInFrames": 1800, "durationSeconds": 60.0, "engine": "kokoro", "voz": {"estilo": "documentario", "ritmo": 0.9}, "scenes": [{"id": "gancho", "capitulo": "O OVO RACHOU", "startFrame": 0, "endFrame": 104, "lines": [{"text": "O ovo rachou… e nasceu uma geladeirinha!", "startFrame": 3, "endFrame": 87, "words": [{"text": "O", "startFrame": 3, "endFrame": 6}, {"text": "ovo", "startFrame": 6, "endFrame": 17}, {"text": "rachou…", "startFrame": 17, "endFrame": 35}, {"text": "e", "startFrame": 38, "endFrame": 40}, {"text": "nasceu", "startFrame": 40, "endFrame": 55}, {"text": "uma", "startFrame": 55, "endFrame": 61}, {"text": "geladeirinha!", "startFrame": 61, "endFrame": 87}]}]}, {"id": "mamae", "capitulo": "MAMÃE?", "startFrame": 104, "endFrame": 317, "lines": [{"text": "Ela olhou pra geladeira e disse: mamãe!", "startFrame": 122, "endFrame": 210, "words": [{"text": "Ela", "startFrame": 122, "endFrame": 131}, {"text": "olhou", "startFrame": 131, "endFrame": 143}, {"text": "pra", "startFrame": 143, "endFrame": 148}, {"text": "geladeira", "startFrame": 148, "endFrame": 170}, {"text": "e", "startFrame": 170, "endFrame": 174}, {"text": "disse:", "startFrame": 174, "endFrame": 184}, {"text": "mamãe!", "startFrame": 187, "endFrame": 210}]}, {"text": "A geladeira chorou… cubos de gelo.", "startFrame": 221, "endFrame": 299, "words": [{"text": "A", "startFrame": 221, "endFrame": 225}, {"text": "geladeira", "startFrame": 225, "endFrame": 251}, {"text": "chorou…", "startFrame": 251, "endFrame": 263}, {"text": "cubos", "startFrame": 268, "endFrame": 279}, {"text": "de", "startFrame": 279, "endFrame": 287}, {"text": "gelo.", "startFrame": 287, "endFrame": 299}]}]}, {"id": "fome", "capitulo": "BEBÊ COM FOME", "startFrame": 317, "endFrame": 595, "lines": [{"text": "Só que bebê geladeira come gelo. Muito gelo.", "startFrame": 334, "endFrame": 426, "words": [{"text": "Só", "startFrame": 334, "endFrame": 341}, {"text": "que", "startFrame": 341, "endFrame": 344}, {"text": "bebê", "startFrame": 344, "endFrame": 355}, {"text": "geladeira", "startFrame": 355, "endFrame": 376}, {"text": "come", "startFrame": 376, "endFrame": 387}, {"text": "gelo.", "startFrame": 387, "endFrame": 397}, {"text": "Muito", "startFrame": 400, "endFrame": 416}, {"text": "gelo.", "startFrame": 416, "endFrame": 426}]}, {"text": "E congelou a cozinha inteira.", "startFrame": 438, "endFrame": 506, "words": [{"text": "E", "startFrame": 438, "endFrame": 442}, {"text": "congelou", "startFrame": 442, "endFrame": 464}, {"text": "a", "startFrame": 464, "endFrame": 468}, {"text": "cozinha", "startFrame": 468, "endFrame": 486}, {"text": "inteira.", "startFrame": 486, "endFrame": 506}]}, {"text": "O leite virou picolé.", "startFrame": 518, "endFrame": 578, "words": [{"text": "O", "startFrame": 518, "endFrame": 521}, {"text": "leite", "startFrame": 521, "endFrame": 541}, {"text": "virou", "startFrame": 541, "endFrame": 559}, {"text": "picolé.", "startFrame": 559, "endFrame": 578}]}]}, {"id": "microondas", "capitulo": "MINISTRO AO RESGATE", "startFrame": 595, "endFrame": 920, "lines": [{"text": "O ministro da pipoca tentou esquentar tudo…", "startFrame": 613, "endFrame": 710, "words": [{"text": "O", "startFrame": 613, "endFrame": 616}, {"text": "ministro", "startFrame": 616, "endFrame": 635}, {"text": "da", "startFrame": 635, "endFrame": 640}, {"text": "pipoca", "startFrame": 640, "endFrame": 657}, {"text": "tentou", "startFrame": 657, "endFrame": 677}, {"text": "esquentar", "startFrame": 677, "endFrame": 701}, {"text": "tudo…", "startFrame": 701, "endFrame": 710}]}, {"text": "e estourou pipoca de novo.", "startFrame": 722, "endFrame": 791, "words": [{"text": "e", "startFrame": 722, "endFrame": 724}, {"text": "estourou", "startFrame": 724, "endFrame": 748}, {"text": "pipoca", "startFrame": 748, "endFrame": 768}, {"text": "de", "startFrame": 768, "endFrame": 779}, {"text": "novo.", "startFrame": 779, "endFrame": 791}]}, {"text": "A geladeirinha bateu palma e pediu bis!", "startFrame": 802, "endFrame": 902, "words": [{"text": "A", "startFrame": 802, "endFrame": 806}, {"text": "geladeirinha", "startFrame": 806, "endFrame": 841}, {"text": "bateu", "startFrame": 841, "endFrame": 858}, {"text": "palma", "startFrame": 858, "endFrame": 873}, {"text": "e", "startFrame": 873, "endFrame": 878}, {"text": "pediu", "startFrame": 878, "endFrame": 896}, {"text": "bis!", "startFrame": 896, "endFrame": 902}]}]}, {"id": "batismo", "capitulo": "BATISMO REAL", "startFrame": 920, "endFrame": 1163, "lines": [{"text": "A rainha capivara escolheu o nome dela… bem devagarinho.", "startFrame": 937, "endFrame": 1047, "words": [{"text": "A", "startFrame": 937, "endFrame": 941}, {"text": "rainha", "startFrame": 941, "endFrame": 953}, {"text": "capivara", "startFrame": 953, "endFrame": 972}, {"text": "escolheu", "startFrame": 972, "endFrame": 986}, {"text": "o", "startFrame": 986, "endFrame": 992}, {"text": "nome", "startFrame": 992, "endFrame": 998}, {"text": "dela…", "startFrame": 998, "endFrame": 1008}, {"text": "bem", "startFrame": 1013, "endFrame": 1024}, {"text": "devagarinho.", "startFrame": 1024, "endFrame": 1047}]}, {"text": "Demorou três dias. O nome é Gelinha.", "startFrame": 1059, "endFrame": 1145, "words": [{"text": "Demorou", "startFrame": 1059, "endFrame": 1077}, {"text": "três", "startFrame": 1077, "endFrame": 1089}, {"text": "dias.", "startFrame": 1089, "endFrame": 1102}, {"text": "O", "startFrame": 1105, "endFrame": 1108}, {"text": "nome", "startFrame": 1108, "endFrame": 1122}, {"text": "é", "startFrame": 1122, "endFrame": 1124}, {"text": "Gelinha.", "startFrame": 1124, "endFrame": 1145}]}]}, {"id": "baba", "capitulo": "VAGA DE BABÁ", "startFrame": 1163, "endFrame": 1484, "lines": [{"text": "E o Tito? Ganhou mais um cargo: babá.", "startFrame": 1181, "endFrame": 1262, "words": [{"text": "E", "startFrame": 1181, "endFrame": 1184}, {"text": "o", "startFrame": 1184, "endFrame": 1188}, {"text":