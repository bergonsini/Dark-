{"video": "golpe-pipoca", "titulo": "O golpe da pipoca", "fps": 30, "durationInFrames": 1800, "durationSeconds": 60.0, "engine": "kokoro", "voz": {"estilo": "documentario", "ritmo": 0.9}, "scenes": [{"id": "gancho", "capitulo": "O ZERO", "startFrame": 0, "endFrame": 105, "lines": [{"text": "Chegou no zero e… PIM! Era só pipoca.", "startFrame": 3, "endFrame": 82, "words": [{"text": "Chegou", "startFrame": 3, "endFrame": 16}, {"text": "no", "startFrame": 16, "endFrame": 20}, {"text": "zero", "startFrame": 20, "endFrame": 27}, {"text": "e…", "startFrame": 27, "endFrame": 33}, {"text": "PIM!", "startFrame": 36, "endFrame": 62}, {"text": "Era", "startFrame": 65, "endFrame": 71}, {"text": "só", "startFrame": 71, "endFrame": 73}, {"text": "pipoca.", "startFrame": 73, "endFrame": 82}]}]}, {"id": "enchente", "capitulo": "ENCHENTE DE PIPOCA", "startFrame": 105, "endFrame": 392, "lines": [{"text": "Só que era pipoca DEMAIS.", "startFrame": 127, "endFrame": 188, "words": [{"text": "Só", "startFrame": 127, "endFrame": 135}, {"text": "que", "startFrame": 135, "endFrame": 138}, {"text": "era", "startFrame": 138, "endFrame": 152}, {"text": "pipoca", "startFrame": 152, "endFrame": 168}, {"text": "DEMAIS.", "startFrame": 168, "endFrame": 188}]}, {"text": "Encheu a cozinha até o teto.", "startFrame": 200, "endFrame": 268, "words": [{"text": "Encheu", "startFrame": 200, "endFrame": 219}, {"text": "a", "startFrame": 219, "endFrame": 224}, {"text": "cozinha", "startFrame": 224, "endFrame": 243}, {"text": "até", "startFrame": 243, "endFrame": 252}, {"text": "o", "startFrame": 252, "endFrame": 258}, {"text": "teto.", "startFrame": 258, "endFrame": 268}]}, {"text": "O leite saiu boiando, gritando de medo.", "startFrame": 279, "endFrame": 369, "words": [{"text": "O", "startFrame": 279, "endFrame": 281}, {"text": "leite", "startFrame": 281, "endFrame": 299}, {"text": "saiu", "startFrame": 299, "endFrame": 311}, {"text": "boiando,", "startFrame": 311, "endFrame": 335}, {"text": "gritando", "startFrame": 338, "endFrame": 353}, {"text": "de", "startFrame": 353, "endFrame": 361}, {"text": "medo.", "startFrame": 361, "endFrame": 369}]}]}, {"id": "golpe", "capitulo": "O GOLPE", "startFrame": 392, "endFrame": 634, "lines": [{"text": "Aí o micro-ondas gritou: quem tem a pipoca, manda!", "startFrame": 414, "endFrame": 518, "words": [{"text": "Aí", "startFrame": 414, "endFrame": 420}, {"text": "o", "startFrame": 420, "endFrame": 427}, {"text": "micro-ondas", "startFrame": 427, "endFrame": 450}, {"text": "gritou:", "startFrame": 450, "endFrame": 463}, {"text": "quem", "startFrame": 466, "endFrame": 473}, {"text": "tem", "startFrame": 473, "endFrame": 475}, {"text": "a", "startFrame": 475, "endFrame": 480}, {"text": "pipoca,", "startFrame": 480, "endFrame": 487}, {"text": "manda!", "startFrame": 490, "endFrame": 518}]}, {"text": "E a cozinha inteira foi pro lado dele.", "startFrame": 530, "endFrame": 612, "words": [{"text": "E", "startFrame": 530, "endFrame": 532}, {"text": "a", "startFrame": 532, "endFrame": 537}, {"text": "cozinha", "startFrame": 537, "endFrame": 555}, {"text": "inteira", "startFrame": 555, "endFrame": 572}, {"text": "foi", "startFrame": 572, "endFrame": 583}, {"text": "pro", "startFrame": 583, "endFrame": 591}, {"text": "lado", "startFrame": 591, "endFrame": 602}, {"text": "dele.", "startFrame": 602, "endFrame": 612}]}]}, {"id": "decreto", "capitulo": "DECRETO REAL", "startFrame": 634, "endFrame": 938, "lines": [{"text": "A rainha capivara nem se mexeu. Comeu uma pipoca… bem devagarinho.", "startFrame": 657, "endFrame": 798, "words": [{"text": "A", "startFrame": 657, "endFrame": 661}, {"text": "rainha", "startFrame": 661, "endFrame": 673}, {"text": "capivara", "startFrame": 673, "endFrame": 690}, {"text": "nem", "startFrame": 690, "endFrame": 702}, {"text": "se", "startFrame": 702, "endFrame": 706}, {"text": "mexeu.", "startFrame": 706, "endFrame": 719}, {"text": "Comeu", "startFrame": 729, "endFrame": 733}, {"text": "uma", "startFrame": 733, "endFrame": 739}, {"text": "pipoca…", "startFrame": 739, "endFrame": 747}, {"text": "bem", "startFrame": 750, "endFrame": 764}, {"text": "devagarinho.", "startFrame": 764, "endFrame": 798}]}, {"text": "E decretou: micro-ondas agora é ministro da pipoca!", "startFrame": 810, "endFrame": 916, "words": [{"text": "E", "startFrame": 810, "endFrame": 815}, {"text": "decretou:", "startFrame": 815, "endFrame": 835}, {"text": "micro-ondas", "startFrame": 838, "endFrame": 862}, {"text": "agora", "startFrame": 862, "endFrame": 875}, {"text": "é", "startFrame": 875, "endFrame": 878}, {"text": "ministro", "startFrame": 878, "endFrame": 897}, {"text": "da", "startFrame": 897, "endFrame": 901}, {"text": "pipoca!", "startFrame": 901, "endFrame": 916}]}]}, {"id": "tito", "capitulo": "E O TITO?", "startFrame": 938, "endFrame": 1137, "lines": [{"text": "O Tito pediu um cargo também.", "startFrame": 961, "endFrame": 1037, "words": [{"text": "O", "startFrame": 961, "endFrame": 966}, {"text": "Tito", "startFrame": 966, "endFrame": 978}, {"text": "pediu", "startFrame": 978, "endFrame": 994}, {"text": "um", "startFrame": 994, "endFrame": 1002}, {"text": "cargo", "startFrame": 1002, "endFrame": 1017}, {"text": "também.", "startFrame": 1017, "endFrame": 1037}]}, {"text": "Virou ministro do piruá.", "startFrame": 1049, "endFrame": 1114, "words": [{"text": "Virou", "startFrame": 1049, "endFrame": 1063}, {"text": "ministro", "startFrame": 1063, "endFrame": 1090}, {"text": "do", "startFrame": 1090, "endFrame": 1094}, {"text": "piruá.", "startFrame": 1094, "endFrame": 1114}]}]}, {"id": "relogio", "capitulo": "HORA DA FAXINA", "startFrame": 1137, "endFrame": 1407, "lines": [{"text": "O barulho acordou o relógio gerente.", "startFrame": 1159, "endFrame": 1244, "words": [{"text": "O", "startFrame": 1159, "endFrame": 1164}, {"text": "barulho", "startFrame": 1164, "endFrame": 1176}, {"text": "acordou", "startFrame": 1176, "endFrame": 1199}, {"text": "o", "startFrame": 1199, "endFrame": 1203}, {"text": "relógio", "startFrame": 1203, "endFrame": 1219}, {"text": "gerente.", "startFrame": 1219, "endFrame": 1244}]}, {"text": "Ele apitou: hora da faxina! E todo mundo fingiu que dormia.", "startFrame": 1255, "endFrame": 1384, "words": [{"text": "Ele", "startFrame": 1255, "endFrame": 1260}, {"text": "apitou:", "startFrame": 1260, "endFrame": 1269}, {"text": "hora", "startFrame": 1271, "endFrame": 1284}, {"text": "da", "startFrame": 1284, "endFrame": 1290}, {"text": "faxina!", "startFrame": 1290, "endFrame": 1311}, {"text": "E", "startFrame": 1319, "endFrame": 1324}, {"text": "todo", "startFrame": 1324, "endFrame": 1332}, {"text": "mundo", "startFrame": 1332, "endFrame": 1346}, {"text": "fingiu", "startFrame": 1346, "endFrame": 1359}, {"text": "que", "startFrame": 1359, "endFrame": 1364}, {"text": "dormia.", "startFrame": 1364, "endFrame": 1384}]}]}, {"id": "final", "capitulo": "CONTINUA…", "startFrame": 1407, "endFrame": 1800, "lines": [{"text": "Mas no fundo da pipoca tinha um ovo gigante…", "startFrame": 1429, "endFrame": 1532, "words": [{"text": "Mas", "startFrame": 1429, "endFrame": 1436}, {"text": "no", "startFrame": 1436, "endFrame": 1443}, {"text": "fundo", "startFrame": 1443, "endFrame": 1458}, {"text": "da", "startFrame": 1458, "endFrame": 1464}, {"text": "pipoca", "startFrame": 1464, "endFrame": 1480}, {"text": "tinha", "startFrame": 1480, "endFrame": 1492}, {"text": "um", "startFrame": 1492, "endFrame": 1500}, {"text": "ovo", "startFrame": 1500, "endFrame": 1511}, {"text": "gigante…", "startFrame": 1511, "endFrame": 1532}]}, {"text": "e ele começou a rachar.", "startFrame": 1543, "endFrame": 1603, "words": [{"text": "e", "startFrame": 1543, "endFrame": 1546}, {"text": "ele", "startFrame": 1546, "endFrame": 1561}, {"text": "começou", "startFrame": 1561, "endFrame": 1582}, {"text": "a", "startFrame": 1582, "endFrame": 1588}, {"text": "rachar.", "startFrame": 1588, "endFrame": 1603}]}, {"text": "O que vai nascer? Descobre no próximo episódio!", "startFrame": 1615,