ental ao Molho de Gelatina!", "quem": "zica", "startFrame": 1038, "endFrame": 1123, "words": [{"text": "Miojo", "startFrame": 1038, "endFrame": 1051}, {"text": "Sentimental", "startFrame": 1051, "endFrame": 1083}, {"text": "ao", "startFrame": 1083, "endFrame": 1087}, {"text": "Molho", "startFrame": 1087, "endFrame": 1097}, {"text": "de", "startFrame": 1097, "endFrame": 1103}, {"text": "Gelatina!", "startFrame": 1103, "endFrame": 1124}]}]}, {"id": "degustacao", "capitulo": "DEGUSTAÇÃO", "startFrame": 1146, "endFrame": 1459, "lines": [{"text": "Jurados… podem provar.", "quem": "apresentador", "startFrame": 1168, "endFrame": 1214, "words": [{"text": "Jurados…", "startFrame": 1168, "endFrame": 1185}, {"text": "podem", "startFrame": 1187, "endFrame": 1202}, {"text": "provar.", "startFrame": 1202, "endFrame": 1214}]}, {"text": "Isto é um crime contra a culinária!", "quem": "francois", "startFrame": 1225, "endFrame": 1299, "words": [{"text": "Isto", "startFrame": 1225, "endFrame": 1234}, {"text": "é", "startFrame": 1234, "endFrame": 1238}, {"text": "um", "startFrame": 1238, "endFrame": 1244}, {"text": "crime", "startFrame": 1244, "endFrame": 1259}, {"text": "contra", "startFrame": 1259, "endFrame": 1273}, {"text": "a", "startFrame": 1273, "endFrame": 1275}, {"text": "culinária!", "startFrame": 1275, "endFrame": 1299}]}, {"text": "Ai, que delícia, meu filho!", "quem": "vo", "startFrame": 1311, "endFrame": 1359, "words": [{"text": "Ai,", "startFrame": 1311, "endFrame": 1319}, {"text": "que", "startFrame": 1319, "endFrame": 1321}, {"text": "delícia,", "startFrame": 1321, "endFrame": 1337}, {"text": "meu", "startFrame": 1337, "endFrame": 1346}, {"text": "filho!", "startFrame": 1346, "endFrame": 1359}]}, {"text": "E o jurado misterioso… desmaiou!", "quem": "apresentador", "startFrame": 1370, "endFrame": 1436, "words": [{"text": "E", "startFrame": 1370, "endFrame": 1373}, {"text": "o", "startFrame": 1373, "endFrame": 1377}, {"text": "jurado", "startFrame": 1377, "endFrame": 1387