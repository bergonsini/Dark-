01, "endFrame": 531, "lines": [{"text": "Hoje: Juninho, que já perdeu catorze vezes… e Dona Zica, que nunca cozinhou na vida!", "quem": "apresentador", "startFrame": 324, "endFrame": 460, "words": [{"text": "Hoje:", "startFrame": 324, "endFrame": 332}, {"text": "Juninho,", "startFrame": 332, "endFrame": 346}, {"text": "que", "startFrame": 348, "endFrame": 350}, {"text": "já", "startFrame": 350, "endFrame": 357}, {"text": "perdeu", "startFrame": 357, "endFrame": 370}, {"text": "catorze", "startFrame": 370, "endFrame": 389}, {"text": "vezes…", "startFrame": 389, "endFrame": 396}, {"text": "e", "startFrame": 396, "endFrame": 400}, {"text": "Dona", "startFrame": 400, "endFrame": 409}, {"text": "Zica,", "startFrame": 409, "endFrame": 415}, {"text": "que", "startFrame": 418, "endFrame": 420}, {"text": "nunca", "startFrame": 420, "endFrame": 431}, {"text": "cozinhou", "startFrame": 431, "endFrame": 448}, {"text": "na", "startFrame": 448, "endFrame": 453}, {"text": "vida!", "startFrame": 453, "endFrame": 460}]}, {"text": "Dessa vez eu ganho!", "quem": "juninho", "startFrame": 472, "endFrame": 509, "words": [{"text": "Dessa", "startFrame": 472, "endFrame": 483}, {"text": "vez", "startFrame": 483, "endFrame": 488}, {"text": "eu", "startFrame": 488, "endFrame": 495}, {"text": "ganho!", "startFrame": 495, "endFrame": 509}]}]}, {"id": "caixa", "capitulo": "CAIXA MISTERIOSA", "startFrame": 531, "endFrame": 767, "lines": [{"text": "Na caixa misteriosa: miojo, chiclete, sardinha e gelatina de uva!", "quem": "apresentador", "startFrame": 554, "endFrame": 678, "words": [{"text": "Na", "startFrame": 554, "endFrame": 558}, {"text": "caixa", "startFrame": 558, "endFrame": 568}, {"text": "misteriosa:", "startFrame": 568, "endFrame": 592}, {"text": "miojo,", "startFrame": 595, "endFrame": 608}, {"text": "chiclete,", "startFrame": 608, "endFrame": 623}, {"text": "sardinha", "startFrame": 623, "endFrame": 643}, {"text": "e", "startFrame": 643, "endFrame": 646}, {"text": "gelatina", "startFr