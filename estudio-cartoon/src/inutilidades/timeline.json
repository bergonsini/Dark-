{"video": "despertador-soco", "titulo": "Despertador com Soco", "fps": 30, "durationInFrames": 1260, "durationSeconds": 42.0, "engine": "elevenlabs", "voz": {"estilo": "documentario", "ritmo": 1.0}, "scenes": [{"id": "problema", "capitulo": "", "startFrame": 0, "endFrame": 222, "lines": [{"text": "Cansado de apertar a soneca quinze vezes?", "quem": "doutor", "startFrame": 3, "endFrame": 91, "words": [{"text": "Cansado", "startFrame": 3, "endFrame": 22}, {"text": "de", "startFrame": 23, "endFrame": 24}, {"text": "apertar", "startFrame": 27, "endFrame": 36}, {"text": "a", "startFrame": 38, "endFrame": 39}, {"text": "soneca", "startFrame": 42, "endFrame": 56}, {"text": "quinze", "startFrame": 59, "endFrame": 68}, {"text": "vezes?", "startFrame": 70, "endFrame": 91}]}, {"text": "O despertador grita… e você nem se mexe!", "quem": "doutor", "startFrame": 106, "endFrame": 207, "words": [{"text": "O", "startFrame": 106, "endFrame": 108}, {"text": "despertador", "startFrame": 112, "endFrame": 130}, {"text": "grita…", "startFrame": 132, "endFrame": 150}, {"text": "e", "startFrame": 151, "endFrame": 154}, {"text": "você", "startFrame": 155, "endFrame": 168}, {"text": "nem", "startFrame": 171, "endFrame": 175}, {"text": "se", "startFrame": 178, "endFrame": 183}, {"text": "mexe!", "startFrame": 185, "endFrame": 207}]}]}, {"id": "produto", "capitulo": "", "startFrame": 222, "endFrame": 406, "lines": [{"text": "Seus problemas ACABARAM!", "quem": "doutor", "startFrame": 238, "endFrame": 297, "words": [{"text": "Seus", "startFrame": 242, "endFrame": 249}, {"text": "problemas", "startFrame": 253, "endFrame": 268}, {"text": "ACABARAM!", "startFrame": 271, "endFrame": 297}]}, {"text": "Apresento o Despertador com Soco!", "quem": "doutor", "startFrame": 308, "endFrame": 390, "words": [{"text": "Apresento", "startFrame": 308, "endFrame": 329}, {"text": "o", "startFrame": 331, "endFrame": 332}, {"text": "Despertador", "startFrame": 336, "endFrame": 359}, {"text": "com", "startFrame": 361, "endFrame": 366}, {"text": "Soco!", "startFrame": 368, "endFrame": 390}]}]}, {"id": "demonstracao", "capitulo": "", "startFrame": 406, "endFrame": 679, "lines": [{"text": "Tocou? Acordou!", "quem": "doutor", "startFrame": 421, "endFrame": 472, "words": [{"text": "Tocou?", "startFrame": 421, "endFrame": 443}, {"text": "Acordou!", "startFrame": 445, "endFrame": 472}]}, {"text": "Acordei… no quintal do vizinho!", "quem": "kuka", "startFrame": 505, "endFrame": 576, "words": [{"text": "Acordei…", "startFrame": 509, "endFrame": 531}, {"text": "no", "startFrame": 536, "endFrame": 538}, {"text": "quintal", "startFrame": 539, "endFrame": 550}, {"text": "do", "startFrame": 551, "endFrame": 553}, {"text": "vizinho!", "startFrame": 555, "endFrame": 576}]}, {"text": "E no modo soneca: soco DUPLO!", "quem": "doutor", "startFrame": 588, "endFrame": 663, "words": [{"text": "E", "startFrame": 590, "endFrame": 591}, {"text": "no", "startFrame": 592, "endFrame": 595}, {"text": "modo", "startFrame": 597, "endFrame": 604}, {"text": "soneca:", "startFrame": 607, "endFrame": 628}, {"text": "soco", "startFrame": 631, "endFrame": 640}, {"text": "DUPLO!", "startFrame": 645, "endFrame": 663}]}]}, {"id": "oferta", "capitulo": "", "startFrame": 679, "endFrame": 1066, "lines": [{"text": "De 999 por apenas 34,90!", "quem": "doutor", "startFrame": 695, "endFrame": 818, "words": [{"text": "De", "startFrame": 695, "endFrame": 714}, {"text": "999", "startFrame": 714, "endFrame": 726}, {"text": "por", "startFrame": 726, "endFrame": 747}, {"text": "apenas", "startFrame": 747, "endFrame": 800}, {"text": "34,90!", "startFrame": 800, "endFrame": 818}]}, {"text": "E ligando AGORA, ganhe um travesseiro de capacete!", "quem": "doutor", "startFrame": 830, "endFrame": 928, "words": [{"text": "E", "startFrame": 830, "endFrame": 832}, {"text": "ligando", "startFrame": 834, "endFrame": 846}, {"text": "AGORA,", "startFrame": 849, "endFrame": 863}, {"text": "ganhe", "startFrame": 866, "endFrame": 873}, {"text": "um", "startFrame": 874, "endFrame": 875}, {"text": "travesseiro", "startFrame": 878, "endFrame": 894}, {"text": "de", "startFrame": 897, "endFrame": 899}, {"text": "capacete!", "startFrame": 902, "endFrame": 928}]}, {"text": "Manda dois… um é pra segunda-feira!", "quem": "kuka", "startFrame": 939, "endFrame": 1011, "words": [{"text": "Manda", "startFrame": 942, "endFrame": 951}, {"text": "dois…", "startFrame": 955, "endFrame": 973}, {"text": "um", "startFrame": 974, "endFrame": 975}, {"text": "é", "startFrame": 978, "endFrame": 980}, {"text": "pra", "startFrame": 981, "endFrame": 983}, {"text": "segunda-feira!", "startFrame": 985, "endFrame": 1011}]}, {"text": "Ligue já!", "quem": "doutor", "startFrame": 1023, "endFrame": 1050, "words": [{"text": "Ligue", "startFrame": 1023, "endFrame": 1032}, {"text": "já!", "startFrame": 1035, "endFrame": 1050}]}]}, {"id": "letrinhas", "capitulo": "", "startFrame": 1066, "endFrame": 1260, "lines": [{"text": "Não tem botão de desligar. Nem de soneca. Dentes não inclusos.", "quem": "doutor", "startFrame": 1082, "endFrame": 1224, "words": [{"text": "Não", "startFrame": 1082, "endFrame": 1086}, {"text": "tem", "startFrame": 1091, "endFrame": 1096}, {"text": "botão", "startFrame": 1100, "endFrame": 1108}, {"text": "de", "startFrame": 1110, "endFrame": 1113}, {"text": "desligar.", "startFrame": 1115, "endFrame": 1139}, {"text": "Nem", "startFrame": 1142, "endFrame": 1146}, {"text": "de", "startFrame": 1149, "endFrame": 1151}, {"text": "soneca.", "startFrame": 1152, "endFrame": 1176}, {"text": "Dentes", "startFrame": 1178, "endFrame": 1192}, {"text": "não", "startFrame": 1194, "endFrame": 1199}, {"text": "inclusos.", "startFrame": 1202, "endFrame": 1224}]}]}], "mouth": [0.0, 0.0, 0.0, 0.0, 0.504, 0.666, 0.697, 0.673, 0.62, 0.759, 0.67, 0.664, 0.624, 0.631, 0.625, 0.854, 0.714, 0.617, 0.786, 0.211, 0.397, 0.703, 0.509, 0.527, 0.799, 0.766, 0.114, 0.0, 0.745, 0.769, 0.452, 0.412, 0.137, 0.422, 0.882, 0.7, 0.479, 0.701, 0.571, 0.734, 0.699, 