{"video": "controle-remoto", "titulo": "Controle Remoto Universal de Verdade", "fps": 30, "durationInFrames": 1320, "durationSeconds": 44.0, "engine": "kokoro", "voz": {"estilo": "documentario", "ritmo": 1.0}, "scenes": [{"id": "gancho", "capitulo": "", "startFrame": 0, "endFrame": 51, "lines": [{"text": "Pausei o rato.", "quem": "kuka", "startFrame": 3, "endFrame": 40, "words": [{"text": "Pausei", "startFrame": 3, "endFrame": 22}, {"text": "o", "startFrame": 22, "endFrame": 29}, {"text": "rato.", "startFrame": 29, "endFrame": 40}]}]}, {"id": "problema", "capitulo": "", "startFrame": 51, "endFrame": 265, "lines": [{"text": "Cansado de um controle remoto que só muda de canal?", "quem": "doutor", "startFrame": 62, "endFrame": 163, "words": [{"text": "Cansado", "startFrame": 62, "endFrame": 79}, {"text": "de", "startFrame": 79, "endFrame": 85}, {"text": "um", "startFrame": 85, "endFrame": 90}, {"text": "controle", "startFrame": 90, "endFrame": 109}, {"text": "remoto", "startFrame": 109, "endFrame": 122}, {"text": "que", "startFrame": 122, "endFrame": 127}, {"text": "só", "startFrame": 127, "endFrame": 131}, {"text": "muda", "startFrame": 131, "endFrame": 143}, {"text": "de", "startFrame": 143, "endFrame": 147}, {"text": "canal?", "startFrame": 147, "endFrame": 163}]}, {"text": "E se a sua vida tivesse um botão de PAUSE?", "quem": "doutor", "startFrame": 178, "endFrame": 254, "words": [{"text": "E", "startFrame": 178, "endFrame": 182}, {"text": "se", "startFrame": 182, "endFrame": 185}, {"text": "a", "startFrame": 185, "endFrame": 188}, {"text": "sua", "startFrame": 188, "endFrame": 193}, {"text": "vida", "startFrame": 193, "endFrame": 202}, {"text": "tivesse", "startFrame": 202, "endFrame": 216}, {"text": "um", "startFrame": 216, "endFrame": 223}, {"text": "botão", "startFrame": 223, "endFrame": 237}, {"text": "de", "startFrame": 237, "endFrame": 243}, {"text": "PAUSE?", "startFrame": 243, "endFrame": 254}]}]}, {"id": "produto", "capitulo": "", "startFrame": 265, "endF