{"video": "fone-antirruido", "titulo": "Fone Antirruído Extremo", "fps": 30, "durationInFrames": 1260, "durationSeconds": 42.0, "engine": "kokoro", "voz": {"estilo": "documentario", "ritmo": 1.0}, "scenes": [{"id": "problema", "capitulo": "", "startFrame": 0, "endFrame": 168, "lines": [{"text": "Cansado do vizinho furando a parede todo domingo?", "quem": "doutor", "startFrame": 3, "endFrame": 90, "words": [{"text": "Cansado", "startFrame": 3, "endFrame": 17}, {"text": "do", "startFrame": 17, "endFrame": 22}, {"text": "vizinho", "startFrame": 22, "endFrame": 35}, {"text": "furando", "startFrame": 35, "endFrame": 50}, {"text": "a", "startFrame": 50, "endFrame": 54}, {"text": "parede", "startFrame": 54, "endFrame": 68}, {"text": "todo", "startFrame": 68, "endFrame": 76}, {"text": "domingo?", "startFrame": 76, "endFrame": 90}]}, {"text": "Às sete da manhã!", "quem": "doutor", "startFrame": 105, "endFrame": 146, "words": [{"text": "Às", "startFrame": 105, "endFrame": 114}, {"text": "sete", "startFrame": 114, "endFrame": 124}, {"text": "da", "startFrame": 124, "endFrame": 131}, {"text": "manhã!", "startFrame": 131, "endFrame": 146}]}]}, {"id": "produto", "capitulo": "", "startFrame": 168, "endFrame": 344, "lines": [{"text": "Seus problemas ACABARAM!", "quem": "doutor", "startFrame": 191, "endFrame": 244, "words": [{"text": "Seus", "startFrame": 191, "endFrame": 199}, {"text": "problemas", "startFrame": 199, "endFrame": 221}, {"text": "ACABARAM!", "startFrame": 221, "endFrame": 244}]}, {"text": "Apresento o Fone Antirruído Extremo!", "quem": "doutor", "startFrame": 256, "endFrame": 322, "words": [{"text": "Apresento", "startFrame": 256, "endFrame": 277}, {"text": "o", "startFrame": 277, "endFrame": 279}, {"text": "Fone", "startFrame": 279, "endFrame": 284}, {"text": "Antirruído", "startFrame": 284, "endFrame": 307}, {"text": "Extremo!", "startFrame": 307, "endFrame": 322}]}]}, {"id": "demonstracao", "capitulo": "", "startFrame": 344, "endFrame": 657, "lines": [{"text": "Coloca e… silêncio total!", "quem": "doutor", "startFrame": 367, "endFrame": 423, "words": [{"text": "Coloca", "startFrame": 367, "endFrame": 382}, {"text": "e…", "startFrame": 382, "endFrame": 387}, {"text": "silêncio", "startFrame": 387, "endFrame": 410}, {"text": "total!", "startFrame": 410, "endFrame": 423}]}, {"text": "Kuka, a casa tá pegando fogo!", "quem": "cleide", "startFrame": 447, "endFrame": 507, "words": [{"text": "Kuka,", "startFrame": 447, "endFrame": 459}, {"text": "a", "startFrame": 459, "endFrame": 463}, {"text": "casa", "startFrame": 463, "endFrame": 474}, {"text": "tá", "startFrame": 474, "endFrame": 476}, {"text": "pegando", "startFrame": 476, "endFrame": 498}, {"text": "fogo!", "startFrame": 498, "endFrame": 507}]}, {"text": "Que paz! Não escuto nada!", "quem": "kuka", "startFrame": 519, "endFrame": 570, "words": [{"text": "Que", "startFrame": 519, "endFrame": 521}, {"text": "paz!", "startFrame": 521, "endFrame": 524}, {"text": "Não", "startFrame": 526, "endFrame": 541}, {"text": "escuto", "startFrame": 541, "endFrame": 558}, {"text": "nada!", "startFrame": 558, "endFrame": 570}]}, {"text": "Não ouve nem os bombeiros!", "quem": "doutor", "startFrame": 582, "endFrame": 635, "words": [{"text": "Não", "startFrame": 582, "endFrame": 592}, {"text": "ouve", "startFrame": 592, "endFrame": 603}, {"text": "nem", "startFrame": 603, "endFrame": 609}, {"text": "os", "startFrame": 609, "endFrame": 617}, {"text": "bombeiros!", "startFrame": 617, "endFrame": 635}]}]}, {"id": "oferta", "capitulo": "", "startFrame": 657, "endFrame": 1015, "lines": [{"text": "De 999 por apenas 39,90!", "quem": "doutor", "startFrame": 680, "endFrame": 798, "words": [{"text": "De", "startFrame": 680, "endFrame": 697}, {"text": "999", "startFrame": 697, "endFrame": 709}, {"text": "por", "startFrame": 709, "endFrame": 731}, {"text": "apenas", "startFrame": 731, "endFrame": 782}, {"text": "39,90!", "startFrame": 782, "endFrame": 798}]}, {"text": "E ligando AGORA, ganhe um extintor de b