{"video": "gps-pessimista", "titulo": "GPS Pessimista", "fps": 30, "durationInFrames": 1260, "durationSeconds": 42.0, "engine": "kokoro", "voz": {"estilo": "documentario", "ritmo": 1.0}, "scenes": [{"id": "problema", "capitulo": "", "startFrame": 0, "endFrame": 216, "lines": [{"text": "Cansado do GPS te mandando pro meio do mato?", "quem": "doutor", "startFrame": 3, "endFrame": 91, "words": [{"text": "Cansado", "startFrame": 3, "endFrame": 20}, {"text": "do", "startFrame": 20, "endFrame": 23}, {"text": "GPS", "startFrame": 23, "endFrame": 40}, {"text": "te", "startFrame": 40, "endFrame": 42}, {"text": "mandando", "startFrame": 42, "endFrame": 61}, {"text": "pro", "startFrame": 61, "endFrame": 66}, {"text": "meio", "startFrame": 66, "endFrame": 77}, {"text": "do", "startFrame": 77, "endFrame": 83}, {"text": "mato?", "startFrame": 83, "endFrame": 91}]}, {"text": "Recalculando… recalculando… e você no meio do rio!", "quem": "doutor", "startFrame": 106, "endFrame": 203, "words": [{"text": "Recalculando…", "startFrame": 106, "endFrame": 141}, {"text": "recalculando…", "startFrame": 143, "endFrame": 168}, {"text": "e", "startFrame": 168, "endFrame": 171}, {"text": "você", "startFrame": 171, "endFrame": 179}, {"text": "no", "startFrame": 179, "endFrame": 183}, {"text": "meio", "startFrame": 183, "endFrame": 193}, {"text": "do", "startFrame": 193, "endFrame": 197}, {"text": "rio!", "startFrame": 197, "endFrame": 203}]}]}, {"id": "produto", "capitulo": "", "startFrame": 216, "endFrame": 370, "lines": [{"text": "Seus problemas ACABARAM!", "quem": "doutor", "startFrame": 229, "endFrame": 283, "words": [{"text": "Seus", "startFrame": 229, "endFrame": 237}, {"text": "problemas", "startFrame": 237, "endFrame": 259}, {"text": "ACABARAM!", "startFrame": 259, "endFrame": 283}]}, {"text": "Apresento o GPS Pessimista!", "quem": "doutor", "startFrame": 294, "endFrame": 357, "words": [{"text": "Apresento", "startFrame": 294, "endFrame": 315}, {"text": "o", "startFrame": 315, "endFrame": 320}, {"text": "GPS", "startFrame": 320, "endFrame": 335}, {"text": "Pessimista!", "startFrame": 335, "endFrame": 357}]}]}, {"id": "demonstracao", "capitulo": "", "startFrame": 370, "endFrame": 734, "lines": [{"text": "Ele fala a verdade!", "quem": "doutor", "startFrame": 383, "endFrame": 425, "words": [{"text": "Ele", "startFrame": 383, "endFrame": 391}, {"text": "fala", "startFrame": 391, "endFrame": 401}, {"text": "a", "startFrame": 401, "endFrame": 406}, {"text": "verdade!", "startFrame": 406, "endFrame": 425}]}, {"text": "Vire à direita. Ou não. Você vai se atrasar de qualquer jeito.", "quem": "gps", "startFrame": 436, "endFrame": 563, "words": [{"text": "Vire", "startFrame": 436, "endFrame": 443}, {"text": "à", "startFrame": 443, "endFrame": 449}, {"text": "direita.", "startFrame": 449, "endFrame": 468}, {"text": "Ou", "startFrame": 471, "endFrame": 475}, {"text": "não.", "startFrame": 475, "endFrame": 487}, {"text": "Você", "startFrame": 497, "endFrame": 505}, {"text": "vai", "startFrame": 505, "endFrame": 514}, {"text": "se", "startFrame": 514, "endFrame": 516}, {"text": "atrasar", "startFrame": 516, "endFrame": 530}, {"text": "de", "startFrame": 530, "endFrame": 534}, {"text": "qualquer", "startFrame": 534, "endFrame": 553}, {"text": "jeito.", "startFrame": 553, "endFrame": 563}]}, {"text": "Então eu nem vou!", "quem": "kuka", "startFrame": 575, "endFrame": 620, "words": [{"text": "Então", "startFrame": 575, "endFrame": 597}, {"text": "eu", "startFrame": 597, "endFrame": 604}, {"text": "nem", "startFrame": 604, "endFrame": 615}, {"text": "vou!", "startFrame": 615, "endFrame": 620}]}, {"text": "Nunca mais se perdeu… porque nunca mais saiu de casa!", "quem": "doutor", "startFrame": 631, "endFrame": 721, "words": [{"text": "Nunca", "startFrame": 631, "endFrame": 639}, {"text": "mais", "startFrame": 639, "endFrame": 647}, {"text": "se", "startFrame": 647, "endFrame": 653}, {"text": "perdeu…", "startFrame": 653, "endFrame": 665}, {"text": "porque", "startFrame": 668, "endFrame": 680}, {"text": "nunca", "startFrame": 680, "endFrame": 691}, {"text": "mais", "startFrame": 691, "endFrame": 696}, {"text": "saiu", "startFrame": 696, "endFrame": 706}, {"text": "de", "startFrame": 706, "endFrame": 712}, {"text": "casa!", "startFrame": 712, "endFrame": 721}]}]}, {"id": "oferta", "capitulo": "", "startFrame": 734, "endFrame": 1082, "lines": [{"text": "De 999 por apenas 29,90!", "quem": "doutor", "startFrame": 747, "endFrame": 863, "words": [{"text": "De", "startFrame": 747, "endFrame": 764}, {"text": "999", "startFrame": 764, "endFrame": 774}, {"text": "por", "startFrame": 774, "endFrame": 797}, {"text": "apenas", "startFrame": 797, "endFrame": 848}, {"text": "29,90!", "startFrame": 848, "endFrame": 863}]}, {"text": "E ligando AGORA, ganhe um lencinho de brinde!", "quem": "doutor", "startFrame": 874, "endFrame": 952, "words": [{"text": "E", "startFrame": 874, "endFrame": 877}, {"text": "ligando", "startFrame": 877, "endFrame": 890}, {"text": "AGORA,", "startFrame": 890, "endFrame": 899}, {"text": "ganhe", "startFrame": 903, "endFrame": 909}, {"text": "um", "startFrame": 909, "endFrame": 918}, {"text": "lencinho", "startFrame": 918, "endFrame": 934}, {"text": "de", "startFrame": 934, "endFrame": 941}, {"text": "brinde!", "startFrame": 941, "endFrame": 952}]}, {"text": "Manda dois… mas acho que nem chega.", "quem": "kuka", "startFrame": 964, "endFrame": 1033, "words": [{"text": "Manda", "startFrame": 964, "endFrame": 979}, {"text": "dois…", "startFrame": 979, "endFrame": 987}, {"text": "mas", "startFrame": 987, "endFrame": 994}, {"text": "acho", "startFrame": 994, "endFrame": 1004}, {"text": "que", "startFrame": 1004, "endFrame": 1012}, {"text": "nem", "startFrame": 1012, "endFrame": 1020}, {"text": "chega.", "startFrame": 1020, "endFrame": 1033}]}, {"text": "Ligue já!", "quem": "doutor", "startFrame": 1044, "endFrame": 1069, "words": [{"text": "Ligue", "startFrame": 1044, "endFrame": 1062}, {"text": "já!", "startFrame": 1062, "endFr