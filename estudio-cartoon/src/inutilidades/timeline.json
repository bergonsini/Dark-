{"video": "guarda-chuva-peneira", "titulo": "Guarda-Chuva Peneira", "fps": 30, "durationInFrames": 1320, "durationSeconds": 44.0, "engine": "kokoro", "voz": {"estilo": "documentario", "ritmo": 1.0}, "scenes": [{"id": "gancho", "capitulo": "", "startFrame": 0, "endFrame": 80, "lines": [{"text": "Choveu dentro do guarda-chuva.", "quem": "kuka", "startFrame": 3, "endFrame": 65, "words": [{"text": "Choveu", "startFrame": 3, "endFrame": 18}, {"text": "dentro", "startFrame": 18, "endFrame": 33}, {"text": "do", "startFrame": 33, "endFrame": 37}, {"text": "guarda-chuva.", "startFrame": 37, "endFrame": 65}]}]}, {"id": "problema", "capitulo": "", "startFrame": 80, "endFrame": 277, "lines": [{"text": "Cansado de guarda-chuva que deixa a sua cabeça ABAFADA?", "quem": "doutor", "startFrame": 96, "endFrame": 197, "words": [{"text": "Cansado", "startFrame": 96, "endFrame": 112}, {"text": "de", "startFrame": 112, "endFrame": 116}, {"text": "guarda-chuva", "startFrame": 116, "endFrame": 142}, {"text": "que", "startFrame": 142, "endFrame": 145}, {"text": "deixa", "startFrame": 145, "endFrame": 157}, {"text": "a", "startFrame": 157, "endFrame": 160}, {"text": "sua", "startFrame": 160, "endFrame": 168}, {"text": "cabeça", "startFrame": 168, "endFrame": 182}, {"text": "ABAFADA?", "startFrame": 182, "endFrame": 197}]}, {"text": "Sem ventilação nenhuma?!", "quem": "doutor", "startFrame": 212, "endFrame": 261, "words": [{"text": "Sem", "startFrame": 212, "endFrame": 222}, {"text": "ventilação", "startFrame": 222, "endFrame": 247}, {"text": "nenhuma?!", "startFrame": 247, "endFrame": 261}]}]}, {"id": "produto", "capitulo": "", "startFrame": 277, "endFrame": 435, "lines": [{"text": "Seus problemas ACABARAM!", "quem": "doutor", "startFrame": 292, "endFrame": 346, "words": [{"text": "Seus", "startFrame": 292, "endFrame": 300}, {"text": "problemas", "startFrame": 300, "endFrame": 322}, {"text": "ACABARAM!", "startFrame": 322, "endFrame": 346}]}, {"text": "Apresento o Guarda-Chuva Peneira!", "quem": "doutor", "startFrame": 357, "endFrame": 419, "words": [{"text": "Apresento", "startFrame": 357, "endFrame": 378}, {"text": "o", "startFrame": 378, "endFrame": 380}, {"text": "Guarda-Chuva", "startFrame": 380, "endFrame": 401}, {"text": "Peneira!", "startFrame": 401, "endFrame": 419}]}]}, {"id": "demonstracao", "capitulo": "", "startFrame": 435, "endFrame": 615, "lines": [{"text": "São mil furinhos de ventilação!", "quem": "doutor", "startFrame": 450, "endFrame": 517, "words": [{"text": "São", "startFrame": 450, "endFrame": 458}, {"text": "mil", "startFrame": 458, "endFrame": 469}, {"text": "furinhos", "startFrame": 469, "endFrame": 482}, {"text": "de", "startFrame": 482, "endFrame": 487}, {"text": "ventilação!", "startFrame": 487, "endFrame": 517}]}, {"text": "Banho e passeio ao mesmo tempo!", "quem": "doutor", "startFrame": 547, "endFrame": 600, "words": [{"text": "Banho", "startFrame": 547, "endFrame": 555}, {"text": "e", "startFrame": 555, "endFrame": 559}, {"text": "passeio", "startFrame": 559, "endFrame": 569}, {"text": "ao", "startFrame": 569, "endFrame": 577}, {"text": "mesmo", "startFrame": 577, "endFrame": 585}, {"text": "tempo!", "startFrame": 585, "endFrame": 600}]}]}, {"id": "depoimento", "capitulo": "", "startFrame": 615, "endFrame": 853, "lines": [{"text": "Eu saí seco e cheguei lavado.", "quem": "kuka", "startFrame": 631, "endFrame": 694, "words": [{"text": "Eu", "startFrame": 631, "endFrame": 638}, {"text": "saí", "startFrame": 638, "endFrame": 650}, {"text": "seco", "startFrame": 650, "endFrame": 656}, {"text": "e", "startFrame": 656, "endFrame": 660}, {"text": "cheguei", "startFrame": 660, "endFrame": 675}, {"text": "lavado.", "startFrame": 675, "endFrame": 694}]}, {"text": "Meu cabelo virou uma esponja.", "quem": "kuka", "startFrame": 705, "endFrame": 762, "words": [{"text": "Meu", "startFrame": 705, "endFrame": 712}, {"text": "cabelo", "startFrame": 712, "endFrame": 728}, {"text": "virou", "startFrame": 728, "endFrame": 737}, {"text": "uma", "startFrame": 737, "endFrame": 745}, {"text": "esponja.", "startFrame": 745, "endFrame": 762}]}, {"text": "Nunca economizei tanto chuveiro!", "quem": "kuka", "startFrame": 773, "endFrame": 837, "words": [{"text": "Nunca", "startFrame": 773, "endFrame": 785}, {"text": "economizei", "startFrame": 785, "endFrame": 807}, {"text": "tanto", "startFrame": 807, "endFrame": 822}, {"text": "chuveiro!", "startFrame": 822, "endFrame": 837}]}]}, {"id": "oferta", "capitulo": "", "startFrame": 853, "endFrame": 1161, "lines": [{"text": "De 999 por apenas 19,90!", "quem": "doutor", "startFrame": 868, "endFrame": 980, "words": [{"text": "De", "startFrame": 868, "endFrame": 886}, {"text": "999", "startFrame": 886, "endFrame": 894}, {"text": "por", "startFrame": 894, "endFrame": 914}, {"text": "apenas", "startFrame": 914, "endFrame": 965}, {"text": "19,90!", "startFrame": 965, "endFrame": 980}]}, {"text": "E ligando AGORA, ganhe um balde de brinde!", "quem": "doutor", "startFrame": 991, "endFrame": 1068, "words": [{"text": "E", "startFrame": 991, "endFrame": 994}, {"text": "ligando", "startFrame": 994, "endFrame": 1007}, {"text": "AGORA,", "startFrame": 1007, "endFrame": 1017}, {"text": "ganhe", "startFrame": 1019, "endFrame": 1029}, {"text": "um", "startFrame": 1029, "endFrame": 1035}, {"text": "balde", "startFrame": 1035, "endFrame": 1049}, {"text": "de", "startFrame": 1049, "endFrame": 1056}, {"text": "brinde!", "startFrame": 1056, "endFrame": 1068}]}, {"text": "Manda dois!", "quem": "kuka", "startFrame": 1079, "endFrame": 1109, "words": [{"text": "Manda", "startFrame": 1079, "endFrame": 1097}, {"text": "dois!", "startFrame": 1097, "endFrame": 1109}]}, {"text": "Ligue já!", "quem": "doutor", "startFrame": 1121, "endFrame": 1145, "words": [{"text": "Ligue", "startFrame": 1121, "endFrame": 1139}, {"text": "já!", "startFrame": 1139, "endFrame": 1145}]}]}, {"id": "letrinhas", "capitulo": "", "startFrame": 1161, "endFrame": 1320, "lines": [{"text": "Não usar em dias de chuva. Nem de so