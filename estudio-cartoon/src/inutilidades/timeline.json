{"video": "tapete-turbo", "titulo": "Tapete Escorregador Turbo", "fps": 30, "durationInFrames": 1320, "durationSeconds": 44.0, "engine": "elevenlabs", "voz": {"estilo": "documentario", "ritmo": 1.0}, "scenes": [{"id": "gancho", "capitulo": "", "startFrame": 0, "endFrame": 102, "lines": [{"text": "Fui na cozinha… e atravessei três paredes.", "quem": "kuka", "startFrame": 3, "endFrame": 92, "words": [{"text": "Fui", "startFrame": 6, "endFrame": 8}, {"text": "na", "startFrame": 10, "endFrame": 13}, {"text": "cozinha…", "startFrame": 16, "endFrame": 39}, {"text": "e", "startFrame": 40, "endFrame": 42}, {"text": "atravessei", "startFrame": 43, "endFrame": 60}, {"text": "três", "startFrame": 62, "endFrame": 70}, {"text": "paredes.", "startFrame": 76, "endFrame": 92}]}]}, {"id": "problema", "capitulo": "", "startFrame": 102, "endFrame": 299, "lines": [{"text": "Cansado de levar CINCO segundos do quarto até a cozinha?", "quem": "doutor", "startFrame": 113, "endFrame": 220, "words": [{"text": "Cansado", "startFrame": 113, "endFrame": 129}, {"text": "de", "startFrame": 131, "endFrame": 133}, {"text": "levar", "startFrame": 134, "endFrame": 143}, {"text": "CINCO", "startFrame": 148, "endFrame": 155}, {"text": "segundos", "startFrame": 158, "endFrame": 172}, {"text": "do", "startFrame": 175, "endFrame": 177}, {"text": "quarto", "startFrame": 179, "endFrame": 189}, {"text": "até", "startFrame": 191, "endFrame": 196}, {"text": "a", "startFrame": 197, "endFrame": 198}, {"text": "cozinha?", "startFrame": 199, "endFrame": 220}]}, {"text": "Uma eternidade!", "quem": "doutor", "startFrame": 235, "endFrame": 289, "words": [{"text": "Uma", "startFrame": 235, "endFrame": 244}, {"text": "eternidade!", "startFrame": 249, "endFrame": 289}]}]}, {"id": "produto", "capitulo": "", "startFrame": 299, "endFrame": 473, "lines": [{"text": "Seus problemas ACABARAM!", "quem": "doutor", "startFrame": 309, "endFrame": 369, "words": [{"text": "Seus", "startFrame": 313, "endFrame": 320}, {"text": "problemas", "startFrame": 324, "endFrame": 339}, {"text": "ACABARAM!", "startFrame": 342, "endFrame": 369}]}, {"text": "Apresento o Tapete Escorregador Turbo!", "quem": "doutor", "startFrame": 380, "endFrame": 463, "words": [{"text": "Apresento", "startFrame": 380, "endFrame": 401}, {"text": "o", "startFrame": 403, "endFrame": 404}, {"text": "Tapete", "startFrame": 405, "endFrame": 419}, {"text": "Escorregador", "startFrame": 420, "endFrame": 440}, {"text": "Turbo!", "startFrame": 443, "endFrame": 463}]}]}, {"id": "demonstracao", "capitulo": "", "startFrame": 473, "endFrame": 645, "lines": [{"text": "É só pisar no tapete e…", "quem": "doutor", "startFrame": 483, "endFrame": 545, "words": [{"text": "É", "startFrame": 483, "endFrame": 486}, {"text": "só", "startFrame": 491, "endFrame": 495}, {"text": "pisar", "startFrame": 499, "endFrame": 505}, {"text": "no", "startFrame": 507, "endFrame": 510}, {"text": "tapete", "startFrame": 513, "endFrame": 527}, {"text": "e…", "startFrame": 531, "endFrame": 545}]}, {"text": "Cozinha em meio segundo!", "quem": "doutor", "startFrame": 581, "endFrame": 634, "words": [{"text": "Cozinha", "startFrame": 587, "endFrame": 595}, {"text": "em", "startFrame": 598, "endFrame": 602}, {"text": "meio", "startFrame": 605, "endFrame": 610}, {"text": "segundo!", "startFrame": 612, "endFrame": 634}]}]}, {"id": "depoimento", "capitulo": "", "startFrame": 645, "endFrame": 835, "lines": [{"text": "Eu fui buscar um copo d'água…", "quem": "kuka", "startFrame": 655, "endFrame": 709, "words": [{"text": "Eu", "startFrame": 655, "endFrame": 659}, {"text": "fui", "startFrame": 661, "endFrame": 664}, {"text": "buscar", "startFrame": 669, "endFrame": 673}, {"text": "um", "startFrame": 676, "endFrame": 678}, {"text": "copo", "startFrame": 682, "endFrame": 688}, {"text": "d'água…", "startFrame": 690, "endFrame": 709}]}, {"text": "…e parei no bairro vizinho.", "quem": "kuka", "startFrame": 720, "endFrame": 768, "words": [{"text": "…e", "startFrame": 724, "endFrame": 725}, {"text": "parei", "startFrame": 729, "endFrame": 734}, {"text": "no", "startFrame": 735, "endFrame": 737}, {"text": "bairro", "startFrame": 742, "endFrame": 747}, {"text": "vizinho.", "startFrame": 748, "endFrame": 768}]}, {"text": "Mas cheguei rapidinho!", "quem": "kuka", "startFrame": 779, "endFrame": 825, "words": [{"text": "Mas", "startFrame": 782, "endFrame": 786}, {"text": "cheguei", "startFrame": 788, "endFrame": 796}, {"text": "rapidinho!", "startFrame": 798, "endFrame": 825}]}]}, {"id": "oferta", "capitulo": "", "startFrame": 835, "endFrame": 1160, "lines": [{"text": "De 999 por apenas 49,90!", "quem": "doutor", "startFrame": 845, "endFrame": 967, "words": [{"text": "De", "startFrame": 845, "endFrame": 864}, {"text": "999", "startFrame": 864, "endFrame": 875}, {"text": "por", "startFrame": 875, "endFrame": 896}, {"text": "apenas", "startFrame": 896, "endFrame": 949}, {"text": "49,90!", "startFrame": 949, "endFrame": 967}]}, {"text": "E ligando AGORA, ganhe um capacete de brinde!", "quem": "doutor", "startFrame": 979, "endFrame": 1068, "words": [{"text": "E", "startFrame": 979, "endFrame": 980}, {"text": "ligando", "startFrame": 981, "endFrame": 993}, {"text": "AGORA,", "startFrame": 997, "endFrame": 1010}, {"text": "ganhe", "startFrame": 1012, "endFrame": 1017}, {"text": "um", "startFrame": 1020, "endFrame": 1022}, {"text": "capacete", "startFrame": 1026, "endFrame": 1041}, {"text": "de", "startFrame": 1044, "endFrame": 1046}, {"text": "brinde!", "startFrame": 1048, "endFrame": 1068}]}, {"text": "Manda dois!", "quem": "kuka", "startFrame": 1079, "endFrame": 1113, "words": [{"text": "Manda", "startFrame": 1081, "endFrame": 1088}, {"text": "dois!", "startFrame": 1091, "endFrame": 1112}]}, {"text": "Ligue já!", "quem": "doutor", "startFrame": 1124, "endFrame": 1150, "words": [{"text": "Ligue", "startFrame": 1124, "endFrame": 1134}, {"text": "já!", "startFrame": 1136, "endFrame": 1150}]}]}, {"id": "letrinhas", "capitulo": "", "startFrame": 1160, "endFrame"