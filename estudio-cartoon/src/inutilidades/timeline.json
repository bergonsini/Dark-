{"video": "tapete-turbo", "titulo": "Tapete Escorregador Turbo", "fps": 30, "durationInFrames": 1320, "durationSeconds": 44.0, "engine": "kokoro", "voz": {"estilo": "documentario", "ritmo": 1.0}, "scenes": [{"id": "gancho", "capitulo": "", "startFrame": 0, "endFrame": 100, "lines": [{"text": "Fui na cozinha… e atravessei três paredes.", "quem": "kuka", "startFrame": 3, "endFrame": 83, "words": [{"text": "Fui", "startFrame": 3, "endFrame": 12}, {"text": "na", "startFrame": 12, "endFrame": 17}, {"text": "cozinha…", "startFrame": 17, "endFrame": 31}, {"text": "e", "startFrame": 31, "endFrame": 36}, {"text": "atravessei", "startFrame": 36, "endFrame": 60}, {"text": "três", "startFrame": 60, "endFrame": 65}, {"text": "paredes.", "startFrame": 65, "endFrame": 83}]}]}, {"id": "problema", "capitulo": "", "startFrame": 100, "endFrame": 290, "lines": [{"text": "Cansado de levar CINCO segundos do quarto até a cozinha?", "quem": "doutor", "startFrame": 116, "endFrame": 219, "words": [{"text": "Cansado", "startFrame": 116, "endFrame": 133}, {"text": "de", "startFrame": 133, "endFrame": 138}, {"text": "levar", "startFrame": 138, "endFrame": 148}, {"text": "CINCO", "startFrame": 148, "endFrame": 157}, {"text": "segundos", "startFrame": 157, "endFrame": 178}, {"text": "do", "startFrame": 178, "endFrame": 181}, {"text": "quarto", "startFrame": 181, "endFrame": 194}, {"text": "até", "startFrame": 194, "endFrame": 200}, {"text": "a", "startFrame": 200, "endFrame": 205}, {"text": "cozinha?", "startFrame": 205, "endFrame": 219}]}, {"text": "Uma eternidade!", "quem": "doutor", "startFrame": 234, "endFrame": 274, "words": [{"text": "Uma", "startFrame": 234, "endFrame": 244}, {"text": "eternidade!", "startFrame": 244, "endFrame": 274}]}]}, {"id": "produto", "capitulo": "", "startFrame": 290, "endFrame": 461, "lines": [{"text": "Seus problemas ACABARAM!", "quem": "doutor", "startFrame": 306, "endFrame": 360, "words": [{"text": "Seus", "startFrame": 306, "endFrame": 314}, {"text": "problemas", "startFrame": 314, "endFrame": 336}, {"text": "ACABARAM!", "startFrame": 336, "endFrame": 360}]}, {"text": "Apresento o Tapete Escorregador Turbo!", "quem": "doutor", "startFrame": 371, "endFrame": 445, "words": [{"text": "Apresento", "startFrame": 371, "endFrame": 391}, {"text": "o", "startFrame": 391, "endFrame": 396}, {"text": "Tapete", "startFrame": 396, "endFrame": 409}, {"text": "Escorregador", "startFrame": 409, "endFrame": 430}, {"text": "Turbo!", "startFrame": 430, "endFrame": 445}]}]}, {"id": "demonstracao", "capitulo": "", "startFrame": 461, "endFrame": 628, "lines": [{"text": "É só pisar no tapete e…", "quem": "doutor", "startFrame": 477, "endFrame": 528, "words": [{"text": "É", "startFrame": 477, "endFrame": 483}, {"text": "só", "startFrame": 483, "endFrame": 487}, {"text": "pisar", "startFrame": 487, "endFrame": 502}, {"text": "no", "startFrame": 502, "endFrame": 508}, {"text": "tapete", "startFrame": 508, "endFrame": 525}, {"text": "e…", "startFrame": 525, "endFrame": 528}]}, {"text": "Cozinha em meio segundo!", "quem": "doutor", "startFrame": 564, "endFrame": 612, "words": [{"text": "Cozinha", "startFrame": 564, "endFrame": 578}, {"text": "em", "startFrame": 578, "endFrame": 583}, {"text": "meio", "startFrame": 583, "endFrame": 597}, {"text": "segundo!", "startFrame": 597, "endFrame": 612}]}]}, {"id": "depoimento", "capitulo": "", "startFrame": 628, "endFrame": 843, "lines": [{"text": "Eu fui buscar um copo d'água…", "quem": "kuka", "startFrame": 644, "endFrame": 703, "words": [{"text": "Eu", "startFrame": 644, "endFrame": 651}, {"text": "fui", "startFrame": 651, "endFrame": 659}, {"text": "buscar", "startFrame": 659, "endFrame": 675}, {"text": "um", "startFrame": 675, "endFrame": 682}, {"text": "copo", "startFrame": 682, "endFrame": 693}, {"text": "d'água…", "startFrame": 693, "endFrame": 704}]}, {"text": "…e parei no bairro vizinho.", "quem": "kuka", "startFrame": 715, "endFrame": 768, "words": [{"text": "…e", "startFrame": 715, "endFrame": 720}, {"text": "parei", "startFrame": 720, "endFrame": 731}, {"text": "no", "startFrame": 731, "endFrame": 737}, {"text": "bairro", "startFrame": 737, "endFrame": 752}, {"text": "vizinho.", "startFrame": 752, "endFrame": 768}]}, {"text": "Mas cheguei rapidinho!", "quem": "kuka", "startFrame": 779, "endFrame": 827, "words": [{"text": "Mas", "startFrame": 779, "endFrame": 785}, {"text": "cheguei", "startFrame": 785, "endFrame": 804}, {"text": "rapidinho!", "startFrame": 804, "endFrame": 827}]}]}, {"id": "oferta", "capitulo": "", "startFrame": 843, "endFrame": 1172, "lines": [{"text": "De 999 por apenas 49,90!", "quem": "doutor", "startFrame": 859, "endFrame": 984, "words": [{"text": "De", "startFrame": 859, "endFrame": 879}, {"text": "999", "startFrame": 879, "endFrame": 890}, {"text": "por", "startFrame": 890, "endFrame": 912}, {"text": "apenas", "startFrame": 912, "endFrame": 969}, {"text": "49,90!", "startFrame": 969, "endFrame": 984}]}, {"text": "E ligando AGORA, ganhe um capacete de brinde!", "quem": "doutor", "startFrame": 995, "endFrame": 1078, "words": [{"text": "E", "startFrame": 995, "endFrame": 998}, {"text": "ligando", "startFrame": 998, "endFrame": 1011}, {"text": "AGORA,", "startFrame": 1011, "endFrame": 1021}, {"text": "ganhe", "startFrame": 1024, "endFrame": 1034}, {"text": "um", "startFrame": 1034, "endFrame": 1039}, {"text": "capacete", "startFrame": 1039, "endFrame": 1060}, {"text": "de", "startFrame": 1060, "endFrame": 1066}, {"text": "brinde!", "startFrame": 1066, "endFrame": 1078}]}, {"text": "Manda dois!", "quem": "kuka", "startFrame": 1090, "endFrame": 1120, "words": [{"text": "Manda", "startFrame": 1090, "endFrame": 1108}, {"text": "dois!", "startFrame": 1108, "endFrame": 1120}]}, {"text": "Ligue já!", "quem": "doutor", "startFrame": 1131, "endFrame": 1156, "words": [{"text": "Ligue", "startFrame": 1131, "endFrame": 1149}, {"text": "já!", "startFrame": 1149, "endFrame": 1156}]}]}, {"id": "letrinhas", "capitulo": "", "startFrame": 1172, "endFrame":