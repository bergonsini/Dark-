{"video": "torradeira-lanca-pao", "titulo": "Torradeira Lança-Pão 3000", "fps": 30, "durationInFrames": 1260, "durationSeconds": 42.0, "engine": "kokoro", "voz": {"estilo": "documentario", "ritmo": 1.0}, "scenes": [{"id": "problema", "capitulo": "", "startFrame": 0, "endFrame": 189, "lines": [{"text": "Cansado de torradeira que não solta o pão?", "quem": "doutor", "startFrame": 3, "endFrame": 78, "words": [{"text": "Cansado", "startFrame": 3, "endFrame": 16}, {"text": "de", "startFrame": 16, "endFrame": 25}, {"text": "torradeira", "startFrame": 25, "endFrame": 44}, {"text": "que", "startFrame": 44, "endFrame": 47}, {"text": "não", "startFrame": 47, "endFrame": 58}, {"text": "solta", "startFrame": 58, "endFrame": 67}, {"text": "o", "startFrame": 67, "endFrame": 69}, {"text": "pão?", "startFrame": 69, "endFrame": 78}]}, {"text": "Você espera, espera… e ele queima lá dentro!", "quem": "doutor", "startFrame": 93, "endFrame": 169, "words": [{"text": "Você", "startFrame": 93, "endFrame": 104}, {"text": "espera,", "startFrame": 104, "endFrame": 115}, {"text": "espera…", "startFrame": 115, "endFrame": 130}, {"text": "e", "startFrame": 130, "endFrame": 131}, {"text": "ele", "startFrame": 131, "endFrame": 140}, {"text": "queima", "startFrame": 140, "endFrame": 150}, {"text": "lá", "startFrame": 150, "endFrame": 154}, {"text": "dentro!", "startFrame": 154, "endFrame": 169}]}]}, {"id": "produto", "capitulo": "", "startFrame": 189, "endFrame": 379, "lines": [{"text": "Seus problemas ACABARAM!", "quem": "doutor", "startFrame": 209, "endFrame": 263, "words": [{"text": "Seus", "startFrame": 209, "endFrame": 217}, {"text": "problemas", "startFrame": 217, "endFrame": 239}, {"text": "ACABARAM!", "startFrame": 239, "endFrame": 263}]}, {"text": "Apresento a Torradeira Lança-Pão 3000!", "quem": "doutor", "startFrame": 274, "endFrame": 359, "words": [{"text": "Apresento", "startFrame": 274, "endFrame": 299}, {"text": "a", "startFrame": 299, "endFrame": 303}, {"text": "Torradeira", "startFrame": 303, "endFrame": 330}, {"text": "Lança-Pão", "startFrame": 330, "endFrame": 355}, {"text": "3000!", "startFrame": 355, "endFrame": 359}]}]}, {"id": "demonstracao", "capitulo": "", "startFrame": 379, "endFrame": 728, "lines": [{"text": "Ela entrega a torrada direto na sua mão!", "quem": "doutor", "startFrame": 399, "endFrame": 475, "words": [{"text": "Ela", "startFrame": 399, "endFrame": 404}, {"text": "entrega", "startFrame": 404, "endFrame": 425}, {"text": "a", "startFrame": 425, "endFrame": 426}, {"text": "torrada", "startFrame": 426, "endFrame": 440}, {"text": "direto", "startFrame": 440, "endFrame": 451}, {"text": "na", "startFrame": 451, "endFrame": 457}, {"text": "sua", "startFrame": 457, "endFrame": 466}, {"text": "mão!", "startFrame": 466, "endFrame": 475}]}, {"text": "Quero no nível máximo!", "quem": "kuka", "startFrame": 486, "endFrame": 533, "words": [{"text": "Quero", "startFrame": 486, "endFrame": 495}, {"text": "no", "startFrame": 495, "endFrame": 501}, {"text": "nível", "startFrame": 501, "endFrame": 518}, {"text": "máximo!", "startFrame": 518, "endFrame": 533}]}, {"text": "Ué… tá chovendo pão?", "quem": "cleide", "startFrame": 566, "endFrame": 617, "words": [{"text": "Ué…", "startFrame": 566, "endFrame": 573}, {"text": "tá", "startFrame": 576, "endFrame": 580}, {"text": "chovendo", "startFrame": 580, "endFrame": 604}, {"text": "pão?", "startFrame": 604, "endFrame": 617}]}, {"text": "Entrega rápida… no apartamento de cima!", "quem": "doutor", "startFrame": 632, "endFrame": 708, "words": [{"text": "Entrega", "startFrame": 632, "endFrame": 644}, {"text": "rápida…", "startFrame": 644, "endFrame": 654}, {"text": "no", "startFrame": 657, "endFrame": 660}, {"text": "apartamento", "startFrame": 660, "endFrame": 691}, {"text": "de", "startFrame": 691, "endFrame": 700}, {"text": "cima!", "startFrame": 700, "endFrame": 708}]}]}, {"id": "oferta", "capitulo": "", "startFrame": 728, "endFrame": 1085, "lines": [{"text": "De 999 por apenas 34,90!", "quem": "doutor", "startFrame": 748, "endFrame": 867, "words": [{"text": "De", "startFrame": 748, "endFrame": 767}, {"text": "999", "startFrame": 767, "endFrame": 778}, {"text": "por", "startFrame": 778, "endFrame": 800}, {"text": "apenas", "startFrame": 800, "endFrame": 852}, {"text": "34,90!", "startFrame": 852, "endFrame": 867}]}, {"text": "E ligando AGORA, ganhe uma luva de goleiro!", "quem": "doutor", "startFrame": 879, "endFrame": 953, "words": [{"text": "E", "startFrame": 879, "endFrame": 882}, {"text": "ligando", "startFrame": 882, "endFrame": 894}, {"text": "AGORA,", "startFrame": 894, "endFrame": 903}, {"text": "ganhe", "startFrame": 907, "endFrame": 915}, {"text": "uma", "startFrame": 915, "endFrame": 921}, {"text": "luva", "startFrame": 921, "endFrame": 930}, {"text": "de", "startFrame": 930, "endFrame": 935}, {"text": "goleiro!", "startFrame": 935, "endFrame": 953}]}, {"text": "Manda duas! Uma é pra Dona Cleide!", "quem": "kuka", "startFrame": 965, "endFrame": 1029, "words": [{"text": "Manda", "startFrame": 965, "endFrame": 976}, {"text": "duas!", "startFrame": 976, "endFrame": 988}, {"text": "Uma", "startFrame": 988, "endFrame": 996}, {"text": "é", "startFrame": 996, "endFrame": 998}, {"text": "pra", "startFrame": 998, "endFrame": 1002}, {"text": "Dona", "startFrame": 1002, "endFrame": 1011}, {"text": "Cleide!", "startFrame": 1011, "endFrame": 1029}]}, {"text": "Ligue já!", "quem": "doutor", "startFrame": 1040, "endFrame": 1065, "words": [{"text": "Ligue", "startFrame": 1040, "endFrame": 1058}, {"text": "já!", "startFrame": 1058, "endFrame": 1065}]}]}, {"id": "letrinhas", "capitulo": "", "startFrame": 1085, "endFrame": 1260, "lines": [{"text": "Torrada pode chegar antes de você. Teto não incluso. Vizinha de cima também não.", "quem": "doutor", "startFrame": 1105, "endFrame": 1224, "words": [{"text": "Torrada", "startFrame": 1105, "endFrame": 1116}, {"text": "pode", "startFrame": 1116, "endFrame": 1122}, {"text": "chegar", "startFrame": 1122, "endFrame": 1132}, {