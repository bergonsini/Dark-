{"video": "escova-turbo", "titulo": "Escova de Dentes Turbo V8", "fps": 30, "durationInFrames": 1320, "durationSeconds": 44.0, "engine": "kokoro", "voz": {"estilo": "documentario", "ritmo": 1.0}, "scenes": [{"id": "gancho", "capitulo": "", "startFrame": 0, "endFrame": 90, "lines": [{"text": "Meus dentes nunca estiveram tão limpos.", "quem": "kuka", "startFrame": 3, "endFrame": 80, "words": [{"text": "Meus", "startFrame": 3, "endFrame": 12}, {"text": "dentes", "startFrame": 12, "endFrame": 27}, {"text": "nunca", "startFrame": 27, "endFrame": 35}, {"text": "estiveram", "startFrame": 35, "endFrame": 60}, {"text": "tão", "startFrame": 60, "endFrame": 68}, {"text": "limpos.", "startFrame": 68, "endFrame": 80}]}]}, {"id": "problema", "capitulo": "", "startFrame": 90, "endFrame": 288, "lines": [{"text": "Cansado de escovar os dentes por DOIS minutos inteiros?", "quem": "doutor", "startFrame": 101, "endFrame": 205, "words": [{"text": "Cansado", "startFrame": 101, "endFrame": 118}, {"text": "de", "startFrame": 118, "endFrame": 121}, {"text": "escovar", "startFrame": 121, "endFrame": 135}, {"text": "os", "startFrame": 135, "endFrame": 140}, {"text": "dentes", "startFrame": 140, "endFrame": 155}, {"text": "por", "startFrame": 155, "endFrame": 161}, {"text": "DOIS", "startFrame": 161, "endFrame": 173}, {"text": "minutos", "startFrame": 173, "endFrame": 187}, {"text": "inteiros?", "startFrame": 187, "endFrame": 205}]}, {"text": "Seu braço não aguenta mais?!", "quem": "doutor", "startFrame": 220, "endFrame": 277, "words": [{"text": "Seu", "startFrame": 220, "endFrame": 227}, {"text": "braço", "startFrame": 227, "endFrame": 238}, {"text": "não", "startFrame": 238, "endFrame": 250}, {"text": "aguenta", "startFrame": 250, "endFrame": 268}, {"text": "mais?!", "startFrame": 268, "endFrame": 277}]}]}, {"id": "produto", "capitulo": "", "startFrame": 288, "endFrame": 456, "lines": [{"text": "Seus problemas ACABARAM!", "quem": "doutor", "startFrame": 298, "endFrame": 352, "words": [{"text