{"video": "sistema-solar", "titulo": "Como surgiu o Sistema Solar?", "fps": 30, "durationInFrames": 1800, "durationSeconds": 60.0, "engine": "kokoro", "voz": {"estilo": "documentario", "ritmo": 1.0}, "scenes": [{"id": "gancho", "startFrame": 0, "endFrame": 88, "lines": [{"text": "De onde veio o Sistema Solar?", "startFrame": 3, "endFrame": 69, "words": [{"text": "De", "startFrame": 3, "endFrame": 6}, {"text": "onde", "startFrame": 6, "endFrame": 20}, {"text": "veio", "startFrame": 20, "endFrame": 31}, {"text": "o", "startFrame": 31, "endFrame": 36}, {"text": "Sistema", "startFrame": 36, "endFrame": 54}, {"text": "Solar?", "startFrame": 54, "endFrame": 69}]}]}, {"id": "nuvem", "startFrame": 88, "endFrame": 307, "lines": [{"text": "Há 4,6 bilhões de anos,", "startFrame": 108, "endFrame": 186, "words": [{"text": "Há", "startFrame": 108, "endFrame": 112}, {"text": "4,6", "startFrame": 112, "endFrame": 150}, {"text": "bilhões", "startFrame": 150, "endFrame": 167}, {"text": "de", "startFrame": 167, "endFrame": 175}, {"text": "anos,", "startFrame": 175, "endFrame": 186}]}, {"text": "existia só uma nuvem gigante de gás e poeira.", "startFrame": 190, "endFrame": 287, "words": [{"text": "existia", "startFrame": 190, "endFrame": 210}, {"text": "só", "startFrame": 210, "endFrame": 214}, {"text": "uma", "startFrame": 214, "endFrame": 221}, {"text": "nuvem", "startFrame": 221, "endFrame": 235}, {"text": "gigante", "startFrame": 235, "endFrame": 256}, {"text": "de", "startFrame": 256, "endFrame": 262}, {"text": "gás", "startFrame": 262, "endFrame": 265}, {"text": "e", "startFrame": 265, "endFrame": 270}, {"text": "poeira.", "startFrame": 270, "endFrame": 287}]}]}, {"id": "colapso", "startFrame": 307, "endFrame": 559, "lines": [{"text": "Até que algo, talvez uma estrela explodindo perto, deu um empurrão.", "startFrame": 327, "endFrame": 448, "words": [{"text": "Até", "startFrame": 327, "endFrame": 334}, {"text": "que", "startFrame": 334, "endFrame": 336}, {"text": "algo,", "startFr