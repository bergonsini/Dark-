{"video": "dedo-enrugado", "titulo": "Por que o dedo enruga na água?", "fps": 30, "durationInFrames": 1800, "durationSeconds": 60.0, "engine": "elevenlabs", "voz": {"estilo": "documentario", "ritmo": 1.0}, "scenes": [{"id": "gancho", "capitulo": "", "startFrame": 0, "endFrame": 80, "lines": [{"text": "Por que o dedo enruga na água?", "startFrame": 3, "endFrame": 58, "words": [{"text": "Por", "startFrame": 3, "endFrame": 8}, {"text": "que", "startFrame": 10, "endFrame": 13}, {"text": "o", "startFrame": 14, "endFrame": 15}, {"text": "dedo", "startFrame": 18, "endFrame": 25}, {"text": "enruga", "startFrame": 28, "endFrame": 39}, {"text": "na", "startFrame": 42, "endFrame": 44}, {"text": "água?", "startFrame": 46, "endFrame": 58}]}]}, {"id": "mito", "capitulo": "", "startFrame": 80, "endFrame": 235, "lines": [{"text": "Muita gente acha que é a pele bebendo água.", "startFrame": 103, "endFrame": 178, "words": [{"text": "Muita", "startFrame": 103, "endFrame": 112}, {"text": "gente", "startFrame": 115, "endFrame": 124}, {"text": "acha", "startFrame": 127, "endFrame": 134}, {"text": "que", "startFrame": 136, "endFrame": 139}, {"text": "é", "startFrame": 141, "endFrame": 143}, {"text": "a", "startFrame": 144, "endFrame": 146}, {"text": "pele", "startFrame": 148, "endFrame": 153}, {"text": "bebendo", "startFrame": 155, "endFrame": 167}, {"text": "água.", "startFrame": 170, "endFrame": 178}]}, {"text": "Mas não é!", "startFrame": 189, "endFrame": 213, "words": [{"text": "Mas", "startFrame": 189, "endFrame": 196}, {"text": "não", "startFrame": 199, "endFrame": 204}, {"text": "é!", "startFrame": 206, "endFrame": 213}]}]}, {"id": "nervo", "capitulo": "", "startFrame": 235, "endFrame": 523, "lines": [{"text": "Depois de uns minutinhos na água…", "startFrame": 258, "endFrame": 312, "words": [{"text": "Depois", "startFrame": 258, "endFrame": 269}, {"text": "de", "startFrame": 272, "endFrame": 273}, {"text": "uns", "startFrame": 274, "endFrame": 277}, {"text": "minutinhos", "startFrame": 279, "endFrame": 293}, {"text": "na", "startFrame": 296, "endFrame": 298}, {"text": "água…", "startFrame": 301, "endFrame": 312}]}, {"text": "Quem manda é o sistema nervoso.", "startFrame": 323, "endFrame": 379, "words": [{"text": "Quem", "startFrame": 323, "endFrame": 328}, {"text": "manda", "startFrame": 330, "endFrame": 340}, {"text": "é", "startFrame": 341, "endFrame": 342}, {"text": "o", "startFrame": 344, "endFrame": 345}, {"text": "sistema", "startFrame": 346, "endFrame": 359}, {"text": "nervoso.", "startFrame": 363, "endFrame": 379}]}, {"text": "Ele aperta os vasinhos de sangue debaixo da pele… e ela enruga.", "startFrame": 391, "endFrame": 500, "words": [{"text": "Ele", "startFrame": 391, "endFrame": 396}, {"text": "aperta", "startFrame": 399, "endFrame": 409}, {"text": "os", "startFrame": 411, "endFrame": 412}, {"text": "vasinhos", "startFrame": 416, "endFrame": 427}, {"text": "de", "startFrame": 428, "endFrame": 429}, {"text": "sangue", "startFrame": 434, "endFrame": 441}, {"text": "debaixo", "startFrame": 444, "endFrame": 453}, {"text": "da", "startFrame": 454, "endFrame": 456}, {"text": "pele…", "startFrame": 458, "endFrame": 475}, {"text": "e", "startFrame": 476, "endFrame": 477}, {"text": "ela", "startFrame": 480, "endFrame": 484}, {"text": "enruga.", "startFrame": 487, "endFrame": 500}]}]}, {"id": "prova", "capitulo": "", "startFrame": 523, "endFrame": 743, "lines": [{"text": "A prova: em 1935, médicos viram que dedo com o nervo cortado não enrugava.", "startFrame": 545, "endFrame": 721, "words": [{"text": "A", "startFrame": 545, "endFrame": 550}, {"text": "prova:", "startFrame": 550, "endFrame": 560}, {"text": "em", "startFrame": 567, "endFrame": 591}, {"text": "1935,", "startFrame": 591, "endFrame": 617}, {"text": "médicos", "startFrame": 621, "endFrame": 637}, {"text": "viram", "startFrame": 637, "endFrame": 646}, {"text": "que", "startFrame": 646, "endFrame": 654}, {"text": "dedo", "startFrame": 654, "endFrame": 662}, {"text": "com", "startFrame": 662, "endFrame": 666}, {"text": "o", "startFrame": 666, "endFrame": 671}, {"text": "nervo", "startFrame": 671, "endFrame": 683}, {"text": "cortado", "startFrame": 683, "endFrame": 694}, {"text": "não", "startFrame": 694, "endFrame": 701}, {"text": "enrugava.", "startFrame": 701, "endFrame": 721}]}]}, {"id": "pneu", "capitulo": "", "startFrame": 743, "endFrame": 1174, "lines": [{"text": "E pra que serve? Uma teoria diz que as rugas são tipo pneu de chuva…", "startFrame": 766, "endFrame": 892, "words": [{"text": "E", "startFrame": 769, "endFrame": 770}, {"text": "pra", "startFrame": 771, "endFrame": 772}, {"text": "que", "startFrame": 775, "endFrame": 777}, {"text": "serve?", "startFrame": 780, "endFrame": 800}, {"text": "Uma", "startFrame": 800, "endFrame": 806}, {"text": "teoria", "startFrame": 808, "endFrame": 820}, {"text": "diz", "startFrame": 822, "endFrame": 825}, {"text": "que", "startFrame": 828, "endFrame": 830}, {"text": "as", "startFrame": 832, "endFrame": 835}, {"text": "rugas", "startFrame": 836, "endFrame": 844}, {"text": "são", "startFrame": 847, "endFrame": 854}, {"text": "tipo", "startFrame": 859, "endFrame": 864}, {"text": "pneu", "startFrame": 866, "endFrame": 874}, {"text": "de", "startFrame": 876, "endFrame": 878}, {"text": "chuva…", "startFrame": 880, "endFrame": 892}]}, {"text": "e ajudam a segurar coisas molhadas.", "startFrame": 904, "endFrame": 967, "words": [{"text": "e", "startFrame": 904, "endFrame": 906}, {"text": "ajudam", "startFrame": 910, "endFrame": 921}, {"text": "a", "startFrame": 922, "endFrame": 923}, {"text": "segurar", "startFrame": 925, "endFrame": 935}, {"text": "coisas", "startFrame": 937, "endFrame": 947}, {"text": "molhadas.", "startFrame": 949, "endFrame": 967}]}, {"text": "Num teste, as pessoas passaram bolinhas molhadas de um pote pro outro mais rápido com o dedo enrugado!", "startFrame": 979, "endFrame": 1151, "words": [{"text": "Num", "startFrame": 979, "endFrame": 986}, {"text": "teste,", "startFrame": 993, "endFrame": 1002}, {"text": "as", "startFrame": 1003, "endFrame": 1005}, {"text": "pessoas", "startFrame": 1006, "endFrame": 1017}, {"text": "passaram", "startFrame": 1020, "endFrame": 1032}, {"text": "bolinhas", "startFrame": 1034, "endFrame": 1044}, {"text": "molhadas", "startFrame": 1046, "endFrame": 1058}, {"text": "de", "startFrame": 1060, "endFrame": 1063}, {"text": "um", "startFrame": 1065, "endFrame": 1068}, {"text": "pote", "startFrame": 1069, "endFrame": 1077}, {"text": "pro", "startFrame": 1080, "endFrame": 1082}, {"text": "outro", "startFrame": 1086, "endFrame": 1094}, {"text": "mais", "startFrame": 1096, "endFrame": 1101}, {"text": "rápido", "startFrame": 1104, "endFrame": 1116}, {"text": "com", "startFrame": 1118, "endFrame": 1120}, {"text": "o", "startFrame": 1122, "endFrame": 1123}, {"text": "dedo", "startFrame": 1125, "endFrame": 1132}, {"text": "enrugado!", "startFrame": 1133, "endFrame": 1151}]}]}, {"id": "digital", "capitulo": "", "startFrame": 1174, "endFrame": 1418, "lines": [{"text": "E o mais curioso: o seu dedo enruga sempre do mesmo jeito!", "startFrame": 1196, "endFrame": 1306, "words": [{"text": "E", "startFrame": 1198, "endFrame": 1199}, {"text": "o", "startFrame": 1200, "endFrame": 1201}, {"text": "mais", "startFrame": 1203, "endFrame": 1208}, {"text": "curioso:", "startFrame": 1211, "endFrame": 1230}, {"text": "o", "startFrame": 1231, "endFrame": 1232}, {"text": "seu", "startFrame": 1235, "endFrame": 1239}, {"text": "dedo", "startFrame": 1242, "endFrame": 1249}, {"text": "enruga", "startFrame": 1251, "endFrame": 1261}, {"text": "sempre", "startFrame": 1266, "endFrame": 1277}, {"text": "do", "startFrame": 1278, "endFrame": 1280}, {"text": "mesmo", "startFrame": 1283, "endFrame": 1290}, {"text": "jeito!", "startFrame": 1292, "endFrame": 1306}]}, {"text": "Tipo uma impressão digital… de banheira!", "startFrame": 1317, "endFrame": 1395, "words": [{"text": "Tipo", "startFrame": 1317, "endFrame": 1325}, {"text": "uma", "startFrame": 1327, "endFrame": 1329}, {"text": "impressão", "startFrame": 1332, "endFrame": 1344}, {"text": "digital…", "startFrame": 1353, "endFrame": 1365}, {"text": "de", "startFrame": 1368, "endFrame": 1373}, {"text": "banheira!", "startFrame": 1374, "endFrame": 1395}]}]}, {"id": "conclusao", "capitulo": "", "startFrame": 1418, "endFrame": 1800, "lines": [{"text": "Resumindo: no banho, seu dedo troca de pneu sozinho… e nem cobra a calibragem!", "startFrame": 1440, "endFrame": 1604, "words": [{"text": "Resumindo:", "startFrame": 1440, "endFrame": 1462}, {"text": "no", "startFrame": 1464, "endFrame": 1467}, {"text": "banho,", "startFrame": 1470, "endFrame": 1479}, {"text": "seu", "startFrame": 1481, "endFrame": 1486}, {"text": "dedo", "startFrame": 1488, "endFrame": 1493}, {"text": "troca", "startFrame": 1496, "endFrame": 1503}, {"text": "de", "startFrame": 1505, "endFrame": 1508}, {"text": "pneu", "startFrame": 1510, "endFrame": 1520}, {"text": "sozinho…", "startFrame": 1523, "endFrame": 1541}, {"text": "e", "startFrame": 1564, "endFrame": 1565}, {"text": "nem", "startFrame": 1568, "endFrame": 1572}, {"text": "cobra", "startFrame": 1576, "endFrame": 1580}, {"text": "a", "startFrame": 1581, "endFrame": 1582}, {"text": "calibragem!", "startFrame": 1584, "endFrame": 1604}]}, {"text": "E você, demora muito no banho? Conta aí!", "startFrame": 1615, "endFrame": 1695, "words": [{"text": "E", "startFrame": 1616, "endFrame": 1617}, {"text": "você,", "startFrame": 1618, "endFrame": 1636}, {"text": "demora", "startFrame": 1638, "endFrame": 1648}, {"text": "muito", "startFrame": 1650, "endFrame": 1659}, {"text": "no", "startFrame": 1660, "endFrame": 1662}, {"text": "banho?", "startFrame": 1665, "endFrame": 1679}, {"text": "Conta", "startFrame": 1683, "endFrame": 1686}, {"text": "aí!", "startFrame": 1688, "endFrame": 1695}]}]}], "mouth": [0.0, 0.0, 0.0, 0.098, 0.288, 0.712, 0.557, 0.249, 0.079, 0.043, 0.2, 0.308, 0.175, 0.85, 0.699, 0.71, 0.405, 0.15, 0.083, 0.609, 0.73, 0.762, 0.237, 0.121, 0.358