{"video": "espirro-sol", "titulo": "Por que o sol faz espirrar?", "fps": 30, "durationInFrames": 1620, "durationSeconds": 54.0, "engine": "kokoro", "voz": {"estilo": "documentario", "ritmo": 0.9}, "scenes": [{"id": "gancho", "capitulo": "", "startFrame": 0, "endFrame": 84, "lines": [{"text": "Por que o sol faz espirrar?", "startFrame": 3, "endFrame": 66, "words": [{"text": "Por", "startFrame": 3, "endFrame": 10}, {"text": "que", "startFrame": 10, "endFrame": 21}, {"text": "o", "startFrame": 21, "endFrame": 26}, {"text": "sol", "startFrame": 26, "endFrame": 33}, {"text": "faz", "startFrame": 33, "endFrame": 41}, {"text": "espirrar?", "startFrame": 41, "endFrame": 66}]}]}, {"id": "cinema", "capitulo": "", "startFrame": 84, "endFrame": 265, "lines": [{"text": "Você sai do cinema, bate aquele sol na cara…", "startFrame": 102, "endFrame": 203, "words": [{"text": "Você", "startFrame": 102, "endFrame": 112}, {"text": "sai", "startFrame": 112, "endFrame": 122}, {"text": "do", "startFrame": 122, "endFrame": 127}, {"text": "cinema,", "startFrame": 127, "endFrame": 140}, {"text": "bate", "startFrame": 144, "endFrame": 156}, {"text": "aquele", "startFrame": 156, "endFrame": 173}, {"text": "sol", "startFrame": 173, "endFrame": 183}, {"text": "na", "startFrame": 183, "endFrame": 188}, {"text": "cara…", "startFrame": 188, "endFrame": 203}]}, {"text": "e: atchim!", "startFrame": 214, "endFrame": 247, "words": [{"text": "e:", "startFrame": 214, "endFrame": 222}, {"text": "atchim!", "startFrame": 222, "endFrame": 247}]}]}, {"id": "um-em-quatro", "capitulo": "", "startFrame": 265, "endFrame": 512, "lines": [{"text": "Isso acontece com mais ou menos uma em cada quatro pessoas.", "startFrame": 282, "endFrame": 413, "words": [{"text": "Isso", "startFrame": 282, "endFrame": 291}, {"text": "acontece", "startFrame": 291, "endFrame": 312}, {"text": "com", "startFrame": 312, "endFrame": 321}, {"text": "mais", "startFrame": 321, "endFrame": 330}, {"text": "ou", "startFrame": 330, "endFrame": 3