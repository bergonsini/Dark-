: 719, "endFrame": 725}, {"text": "o", "startFrame": 725, "endFrame": 731}, {"text": "nervo", "startFrame": 731, "endFrame": 742}, {"text": "cortado", "startFrame": 742, "endFrame": 756}, {"text": "não", "startFrame": 756, "endFrame": 763}, {"text": "enrugava.", "startFrame": 763, "endFrame": 781}]}]}, {"id": "pneu", "capitulo": "", "startFrame": 801, "endFrame": 1261, "lines": [{"text": "E pra que serve? Uma teoria diz que as rugas são tipo pneu de chuva…", "startFrame": 821, "endFrame": 945, "words": [{"text": "E", "startFrame": 821, "endFrame": 825}, {"text": "pra", "startFrame": 825, "endFrame": 830}, {"text": "que", "startFrame": 830, "endFrame": 838}, {"text": "serve?", "startFrame": 838, "endFrame": 850}, {"text": "Uma", "startFrame": 854, "endFrame": 860}, {"text": "teoria", "startFrame": 860, "endFrame": 875}, {"text": "diz", "startFrame": 875, "endFrame": 882}, {"text": "que", "startFrame": 882, "endFrame": 888}, {"text": "as", "startFrame": 888, "endFrame": 893}, {"text": "rugas", "startFrame": 893, "endFrame": 904}, {"text": "são", "startFrame": 904, "endFrame": 911}, {"text": "tipo", "startFrame": 911, "endFrame": 923}, {"text": "pneu", "startFrame": 923, "endFrame": 932}, {"text": "de", "startFrame": 932, "endFrame": 938}, {"text": "chuva…", "startFrame": 938, "endFrame": 945}]}, {"text": "e ajudam a segurar coisas molhadas.", "startFrame": 957, "endFrame": 1036, "words": [{"text": "e", "startFrame": 957, "endFrame": 960}, {"text": "ajudam", "startFrame": 960, "endFrame": 977}, {"text": "a", "startFrame": 977, "endFrame": 980}, {"text": "segurar", "startFrame": 980, "endFrame": 994}, {"text": "coisas", "startFrame": 999, "endFrame": 1017}, {"text": "molhadas.", "startFrame": 1017, "endFrame": 1036}]}, {"text": "Num teste, as pessoas passaram bolinhas molhadas de um pote pro outro mais rápido com o dedo enrugado!", "startFrame": 1047, "endFrame": 1241, "words": [{"text": "Num", "startFrame": 1047, "endFrame": 1049}, {"text": "teste,", "startFrame": 1049, "endFrame": 1053}, {"text": "as", "startFrame": 1055, "endFrame": 1060}, {"text": "pessoas", "startFrame": 1060, "endFrame": 1077}, {"text": "passaram", "startFrame": 1077, "endFrame": 1098}, {"text": "bolinhas", "startFrame": 1098, "endFrame": 1119}, {"text": "molhadas", "startFrame": 1119, "endFrame": 1138}, {"text": "de", "startFrame": 1138, "endFrame": 1142}, {"text": "um", "startFrame": 1146, "endFrame": 1153}, {"text": "pote", "startFrame": 1153, "endFrame": 1161}, {"text": "pro", "startFrame": 1161, "endFrame": 1167}, {"text": "outro", "startFrame": 1167, "endFrame": 1177}, {"text": "mais", "startFrame": 1177, "endFrame": 1190}, {"text": "rápido", "startFrame": 1190, "endFrame": 1201}, {"text": "com", "startFrame": 1201, "endFrame": 1208}, {"text": "o", "startFrame": 1208, "endFrame": 1210}, {"text": "dedo", "startFrame": 1210, "endFrame": 1219}, {"text": "enrugado!", "startFrame": 1219, "endFrame": 1241}]}]}, {"id": "digital", "capitulo": "", "startFrame": 1261, "endFrame": 1501, "lines": [{"text": "E o mais curioso: o seu dedo enruga sempre do mesmo jeito!", "startFrame": 1281, "endFrame": 1395, "words": [{"text": "E", "startFrame": 1281, "endFrame": 1285}, {"text": "o", "startFrame": 1285, "endFrame": 1289}, {"text": "mais", "startFrame": 1289, "endFrame": 1297}, {"text": "curioso:", "startFrame": 1297, "endFrame": 1316}, {"text": "o", "startFrame": 1323, "endFrame": 1326}, {"text": "seu", "startFrame": 1326, "endFrame": 1333}, {"text": "dedo", "startFrame": 1333, "endFrame": 1338}, {"text": "enruga", "startFrame": 1338, "endFrame": 1356}, {"text": "sempre", "startFrame": 1356, "endFrame": 1368}, {"text": "do", "startFrame": 1368, "endFrame": 1375}, {"text": "mesmo", "startFrame": 1375, "endFrame": 1385}, {"text": "jeito!", "startFrame": 1385, "endFrame": 1395}]}, {"text": "Tipo uma impressão digital… de banheira!", "startFrame": 1406, "endFrame": 1481, "words": [{"text": "Tipo", "startFrame": 1406, "endFrame": 1412}, {"text": "uma", "startFrame": 1412, 