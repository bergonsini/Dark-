tartFrame": 514, "endFrame": 525}, {"text": "ela", "startFrame": 525, "endFrame": 531}, {"text": "chega", "startFrame": 531, "endFrame": 540}, {"text": "na", "startFrame": 540, "endFrame": 545}, {"text": "Terra,", "startFrame": 545, "endFrame": 554}, {"text": "bate", "startFrame": 554, "endFrame": 562}, {"text": "em", "startFrame": 562, "endFrame": 567}, {"text": "partículas", "startFrame": 567, "endFrame": 583}, {"text": "minúsculas", "startFrame": 583, "endFrame": 599}, {"text": "do", "startFrame": 599, "endFrame": 604}, {"text": "ar.", "startFrame": 604, "endFrame": 609}]}, {"text": "A luz azul quica muito mais que as outras cores,", "startFrame": 615, "endFrame": 681, "words": [{"text": "A", "startFrame": 615, "endFrame": 618}, {"text": "luz", "startFrame": 618, "endFrame": 623}, {"text": "azul", "startFrame": 623, "endFrame": 630}, {"text": "quica", "startFrame": 630, "endFrame": 638}, {"text": "muito", "startFrame": 638, "endFrame": 646}, {"text": "mais", "startFrame": 646, "endFrame": 653}, {"text": "que", "startFrame": 653, "endFrame": 659}, {"text": "as", "startFrame": 659, "endFrame": 663}, {"text": "outras", "startFrame": 663, "endFrame": 673}, {"text": "cores,", "startFrame": 673, "endFrame": 681}]}, {"text": "e se espalha pelo céu inteiro!", "startFrame": 686, "endFrame": 723, "words": [{"text": "e", "startFrame": 686, "endFrame": 689}, {"text": "se", "startFrame": 689, "endFrame": 693}, {"text": "espalha", "startFrame": 693, "endFrame": 702}, {"text": "pelo", "startFrame": 702, "endFrame": 708}, {"text": "céu", "startFrame": 708, "endFrame": 713}, {"text": "inteiro!", "startFrame": 713, "endFrame": 723}]}, {"text": "Já o vermelho passa quase reto, como se nem visse o ar.", "startFrame": 728, "endFrame": 805, "words": [{"text": "Já", "startFrame": 728, "endFrame": 733}, {"text": "o", "startFrame": 733, "endFrame": 736}, {"text": "vermelho", "startFrame": 736, "endFrame": 748}, {"text": "passa", "startFrame": 748, "endFrame": 756}, {"text": "quase", "sta