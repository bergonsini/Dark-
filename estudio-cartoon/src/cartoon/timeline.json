Frame": 1107, "endFrame": 1280, "words": [{"text": "Em", "startFrame": 1107, "endFrame": 1137}, {"text": "1847,", "startFrame": 1137, "endFrame": 1161}, {"text": "uma", "startFrame": 1165, "endFrame": 1172}, {"text": "fábrica", "startFrame": 1172, "endFrame": 1186}, {"text": "inglesa", "startFrame": 1186, "endFrame": 1197}, {"text": "criou", "startFrame": 1197, "endFrame": 1207}, {"text": "uma", "startFrame": 1207, "endFrame": 1211}, {"text": "das", "startFrame": 1211, "endFrame": 1217}, {"text": "primeiras", "startFrame": 1217, "endFrame": 1233}, {"text": "barras", "startFrame": 1233, "endFrame": 1243}, {"text": "de", "startFrame": 1243, "endFrame": 1249}, {"text": "chocolate", "startFrame": 1249, "endFrame": 1267}, {"text": "pra", "startFrame": 1267, "endFrame": 1271}, {"text": "comer.", "startFrame": 1271, "endFrame": 1280}]}, {"text": "E em 1875, na Suíça, nasceu o chocolate ao leite!", "startFrame": 1291, "endFrame": 1426, "words": [{"text": "E", "startFrame": 1291, "endFrame": 1300}, {"text": "em", "startFrame": 1300, "endFrame": 1315}, {"text": "1875,", "startFrame": 1315, "endFrame": 1325}, {"text": "na", "startFrame": 1325, "endFrame": 1338}, {"text": "Suíça,", "startFrame": 1338, "endFrame": 1370}, {"text": "nasceu", "startFrame": 1373, "endFrame": 1384}, {"text": "o", "startFrame": 1384, "endFrame": 1388}, {"text": "chocolate", "startFrame": 1388, "endFrame": 1412}, {"text": "ao", "startFrame": 1412, "endFrame": 1416}, {"text": "leite!", "startFrame": 1416, "endFrame": 1426}]}]}, {"id": "conclusao", "capitulo": "", "startFrame": 1449, "endFrame": 1800, "lines": [{"text": "Resumindo: de bebida amarga e dinheiro… a docinho de sobremesa!", "startFrame": 1471, "endFrame": 1587, "words": [{"text": "Resumindo:", "startFrame": 1471, "endFrame": 1493}, {"text": "de", "startFrame": 1494, "endFrame": 1495}, {"text": "bebida", "startFrame": 1498, "endFrame": 1507}, {"text": "amarga", "startFrame": 1510, "endFrame": 1522}, {"text": "e", "startFrame": 1523, "endFrame"