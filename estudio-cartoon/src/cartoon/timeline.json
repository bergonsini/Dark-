{"video": "cebola", "titulo": "Por que a cebola faz chorar?", "fps": 30, "durationInFrames": 1800, "durationSeconds": 60.0, "engine": "kokoro", "voz": {"estilo": "documentario", "ritmo": 1.0}, "scenes": [{"id": "gancho", "capitulo": "", "startFrame": 0, "endFrame": 90, "lines": [{"text": "Por que a cebola faz a gente chorar?", "startFrame": 3, "endFrame": 74, "words": [{"text": "Por", "startFrame": 3, "endFrame": 8}, {"text": "que", "startFrame": 8, "endFrame": 14}, {"text": "a", "startFrame": 14, "endFrame": 20}, {"text": "cebola", "startFrame": 20, "endFrame": 33}, {"text": "faz", "startFrame": 33, "endFrame": 43}, {"text": "a", "startFrame": 43, "endFrame": 45}, {"text": "gente", "startFrame": 45, "endFrame": 63}, {"text": "chorar?", "startFrame": 63, "endFrame": 74}]}]}, {"id": "armadilha", "capitulo": "", "startFrame": 90, "endFrame": 381, "lines": [{"text": "Ela nem tá triste… mas esconde uma armadilha química.", "startFrame": 106, "endFrame": 214, "words": [{"text": "Ela", "startFrame": 106, "endFrame": 114}, {"text": "nem", "startFrame": 114, "endFrame": 124}, {"text": "tá", "startFrame": 124, "endFrame": 131}, {"text": "triste…", "startFrame": 131, "endFrame": 147}, {"text": "mas", "startFrame": 150, "endFrame": 155}, {"text": "esconde", "startFrame": 155, "endFrame": 168}, {"text": "uma", "startFrame": 168, "endFrame": 177}, {"text": "armadilha", "startFrame": 177, "endFrame": 202}, {"text": "química.", "startFrame": 202, "endFrame": 214}]}, {"text": "Inteira, ela guarda os ingredientes separadinhos, cada um no seu cantinho.", "startFrame": 226, "endFrame": 365, "words": [{"text": "Inteira,", "startFrame": 226, "endFrame": 244}, {"text": "ela", "startFrame": 246, "endFrame": 254}, {"text": "guarda", "startFrame": 254, "endFrame": 265}, {"text": "os", "startFrame": 265, "endFrame": 270}, {"text": "ingredientes", "startFrame": 270, "endFrame": 295}, {"text": "separadinhos,", "startFrame": 295, "endFrame": 316}, {"text": "cada", "startFrame": 322, "endFrame": 329}, {"text": "um", "startFrame": 329, "endFrame": 338}, {"text": "no", "startFrame": 338, "endFrame": 341}, {"text": "seu", "startFrame": 341, "endFrame": 346}, {"text": "cantinho.", "startFrame": 346, "endFrame": 365}]}]}, {"id": "corte", "capitulo": "", "startFrame": 381, "endFrame": 529, "lines": [{"text": "Mas quando a faca corta, as células se rompem… e tudo se mistura!", "startFrame": 397, "endFrame": 513, "words": [{"text": "Mas", "startFrame": 397, "endFrame": 403}, {"text": "quando", "startFrame": 403, "endFrame": 412}, {"text": "a", "startFrame": 412, "endFrame": 414}, {"text": "faca", "startFrame": 414, "endFrame": 421}, {"text": "corta,", "startFrame": 421, "endFrame": 433}, {"text": "as", "startFrame": 439, "endFrame": 445}, {"text": "células", "startFrame": 445, "endFrame": 461}, {"text": "se", "startFrame": 461, "endFrame": 465}, {"text": "rompem…", "startFrame": 465, "endFrame": 481}, {"text": "e", "startFrame": 483, "endFrame": 487}, {"text": "tudo", "startFrame": 487, "endFrame": 493}, {"text": "se", "startFrame": 493, "endFrame": 500}, {"text": "mistura!", "startFrame": 500, "endFrame": 513}]}]}, {"id": "gas", "capitulo": "", "startFrame": 529, "endFrame": 744, "lines": [{"text": "Uma enzima transforma essa mistura num gás invisível…", "startFrame": 545, "endFrame": 651, "words": [{"text": "Uma", "startFrame": 545, "endFrame": 552}, {"text": "enzima", "startFrame": 552, "endFrame": 565}, {"text": "transforma", "startFrame": 565, "endFrame": 586}, {"text": "essa", "startFrame": 590, "endFrame": 597}, {"text": "mistura", "startFrame": 597, "endFrame": 616}, {"text": "num", "startFrame": 616, "endFrame": 620}, {"text": "gás", "startFrame": 620, "endFrame": 628}, {"text": "invisível…", "startFrame": 628, "endFrame": 651}]}, {"text": "que voa direto pros seus olhos!", "startFrame": 663, "endFrame": 728, "words": [{"text": "que", "startFrame": 663, "endFrame": 670}, {"text": "voa", "startFrame": 670, "endFrame": 678}, {"text": "direto", "startFrame": 678, "endFrame": 694}, {"text": "pros", "startFrame": 694, "endFrame": 706}, {"text": "seus", "startFrame": 706, "endFrame": 717}, {"text": "olhos!", "startFrame": 717, "endFrame": 728}]}]}, {"id": "olho", "capitulo": "", "startFrame": 744, "endFrame": 928, "lines": [{"text": "O gás irrita os nervos do olho, e o corpo reage: solta lágrimas pra lavar tudo!", "startFrame": 760, "endFrame": 912, "words": [{"text": "O", "startFrame": 760, "endFrame": 764}, {"text": "gás", "startFrame": 764, "endFrame": 769}, {"text": "irrita", "startFrame": 769, "endFrame": 780}, {"text": "os", "startFrame": 780, "endFrame": 786}, {"text": "nervos", "startFrame": 786, "endFrame": 799}, {"text": "do", "startFrame": 799, "endFrame": 803}, {"text": "olho,", "startFrame": 803, "endFrame": 812}, {"text": "e", "startFrame": 818, "endFrame": 823}, {"text": "o", "startFrame": 823, "endFrame": 825}, {"text": "corpo", "startFrame": 825, "endFrame": 840}, {"text": "reage:", "startFrame": 840, "endFrame": 850}, {"text": "solta", "startFrame": 854, "endFrame": 863}, {"text": "lágrimas", "startFrame": 863, "endFrame": 883}, {"text": "pra", "startFrame": 883, "endFrame": 891}, {"text": "lavar", "startFrame": 891, "endFrame": 900}, {"text": "tudo!", "startFrame": 900, "endFrame": 912}]}]}, {"id": "descoberta", "capitulo": "", "startFrame": 928, "endFrame": 1295, "lines": [{"text": "Essa enzima só foi descoberta em 2002, por cientistas japoneses.", "startFrame": 944, "endFrame": 1093, "words": [{"text": "Essa", "startFrame": 944, "endFrame": 957}, {"text": "enzima", "startFrame": 957, "endFrame": 980}, {"text": "só", "startFrame": 980, "endFrame": 985}, {"text": "foi", "startFrame": 985, "endFrame": 992}, {"text": "descoberta", "startFrame": 992, "endFrame": 1025}, {"text": "em", "startFrame": 1025, "endFrame": 1032}, {"text": "2002,", "startFrame": 1032, "endFrame": 1037}, {"text": "por", "startFrame": 1043, "endFrame": 1049}, {"text": "cientistas", "startFrame": 1049, "endFrame": 1072}, {"text": "japoneses.", "startFrame": 1072, "endFrame": 1093}]}, {"text": "E a descoberta ganhou até o IgNobel, o prêmio das pesquisas que fazem rir e depois pensar!", "startFrame": 1105, "endFrame": 1279, "words": [{"text": "E", "startFrame": 1105, "endFrame": 1110}, {"text": "a", "startFrame": 1110, "endFrame": 1112}, {"text": "descoberta", "startFrame": 1112, "endFrame": 1130}, {"text": "ganhou", "startFrame": 1130, "endFrame": 1144}, {"text": "até", "startFrame": 1144, "endFrame": 1153}, {"text": "o", "startFrame": 1153, "endFrame": 1155}, {"text": "IgNobel,", "startFrame": 1155, "endFrame": 1170}, {"text": "o", "startFrame": 1179, "endFrame": 1183}, {"text": "prêmio", "startFrame": 1183, "endFrame": 1198}, {"text": "das", "startFrame": 1198, "endFrame": 1204}, {"text": "pesquisas", "startFrame": 1204, "endFrame": 1223}, {"text": "que", "startFrame": 1223, "endFrame": 1231}, {"text": "fazem", "startFrame": 1231, "endFrame": 1242}, {"text": "rir", "startFrame": 1242, "endFrame": 1250}, {"text": "e", "startFrame": 1250, "endFrame": 1253}, {"text": "depois", "startFrame": 1253, "endFrame": 1264}, {"text": "pensar!", "startFrame": 1264, "endFrame": 1279}]}]}, {"id": "dicas", "capitulo": "", "startFrame": 1295, "endFrame": 1560, "lines": [{"text": "Quer chorar menos? Use faca bem afiada, que estraga menos células.", "startFrame": 1311, "endFrame": 1440, "words": [{"text": "Quer", "startFrame": 1311, "endFrame": 1317}, {"text": "chorar", "startFrame": 1317, "endFrame": 1330}, {"text": "menos?", "startFrame": 1330, "endFrame": 1345}, {"text": "Use", "startFrame": 1352, "endFrame": 1361}, {"text": "faca", "startFrame": 1361, "endFrame": 1369}, {"text": "bem", "startFrame": 1369, "endFrame": 1380}, {"text": "afiada,", "startFrame": 1380, "endFrame": 1394}, {"text": "que", "startFrame": 1394, "endFrame": 1400}, {"text": "estraga", "startFrame": 1400, "endFrame": 1413}, {"text": "menos", "startFrame": 1413, "endFrame": 1426}, {"text": "células.", "startFrame": 1426, "endFrame": 1440}]}, {"text": "E deixe a cebola na geladeira antes de cortar.", "startFrame": 1451, "endFrame": 1544, "words": [{"text": "E", "startFrame": 1451, "endFrame": 1456}, {"text": "deixe", "startFrame": 1456, "endFrame": 1463}, {"text": "a", "startFrame": 1463, "endFrame": 1470}, {"text": "cebola", "startFrame": 1470, "endFrame": 1483}, {"text": "na", "startFrame": 1483, "endFrame": 1487}, {"text": "geladeira", "startFrame": 1487, "endFrame": 1511}, {"text": "antes", "startFrame": 1511, "endFrame": 1523}, {"text": "de", "startFrame": 1523, "endFrame": 1527}, {"text": "cortar.", "startFrame": 1527, "endFrame": 1544}]}]}, {"id": "conclusao", "capitulo": "", "startFrame": 1560, "endFrame": 1800, "lines": [{"text": "Resumindo: não é tristeza, é química pura!", "startFrame": 1576, "endFrame": 1657, "words": [{"text": "Resumindo:", "startFrame": 1576, "endFrame": 1601}, {"text": "não", "startFrame": 1601, "endFrame": 1614}, {"text": "é", "startFrame": 1614, "endFrame": 1619}, {"text": "tristeza,", "startFrame": 1619, "endFrame": 1641}, {"text": "é", "startFrame": 1644, "endFrame": 1646}, {"text": "química", "startFrame": 1646, "endFrame": 1654}, {"text": "pura!", "startFrame": 1654, "endFrame": 1657}]}, {"text": "E aí, qual comida te faz chorar? Conta aí!", "startFrame": 1669, "endFrame": 1746, "words": [{"text": "E", "startFrame": 1669, "endFrame": 1673}, {"text": "aí,", "startFrame": 1673, "endFrame": 1680}, {"text": "qual", "startFrame": 1682, "endFrame": 1688}, {"text": "comida", "startFrame": 1688, "endFrame": 1704}, {"text": "te", "startFrame": 1704, "endFrame": 1706}, {"text": "faz", "startFrame": 1706, "endFrame": 1712}, {"text": "chorar?", "startFrame": 1712, "endFrame": 1722}, {"text": "Conta", "startFrame": 1725, "endFrame": 1739}, {"text": "aí!", "startFrame": 1739, "endFrame": 1746}]}]}], "mouth": [0.0, 0.0, 0.0, 0.0, 0.655, 1.0, 0.773, 0.344, 0.0, 0.198, 0.308, 0.912, 0.968, 0.72, 0.618, 0.71, 0.743, 0.578, 0.782, 0.37, 0.28, 0.222, 0.694, 0.685, 0.818, 0.764, 0.766, 