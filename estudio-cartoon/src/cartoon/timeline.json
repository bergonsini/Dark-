{"titulo": "Por que o céu é azul?", "fps": 30, "durationInFrames": 1805, "durationSeconds": 60.178, "engine": "kokoro", "voz": {"estilo": "documentario", "ritmo": 1.12}, "scenes": [{"id": "gancho", "startFrame": 0, "endFrame": 78, "lines": [{"text": "Se o Sol é branco, por que o céu é azul?", "startFrame": 3, "endFrame": 70, "words": [{"text": "Se", "startFrame": 3, "endFrame": 6}, {"text": "o", "startFrame": 6, "endFrame": 11}, {"text": "Sol", "startFrame": 11, "endFrame": 17}, {"text": "é", "startFrame": 17, "endFrame": 19}, {"text": "branco,", "startFrame": 19, "endFrame": 33}, {"text": "por", "startFrame": 33, "endFrame": 38}, {"text": "que", "startFrame": 38, "endFrame": 43}, {"text": "o", "startFrame": 43, "endFrame": 46}, {"text": "céu", "startFrame": 46, "endFrame": 58}, {"text": "é", "startFrame": 58, "endFrame": 60}, {"text": "azul?", "startFrame": 60, "endFrame": 70}]}]}, {"id": "problema", "startFrame": 78, "endFrame": 262, "lines": [{"text": "Parece mágica, mas é física!", "startFrame": 86, "endFrame": 146, "words": [{"text": "Parece", "startFrame": 86, "endFrame": 108}, {"text": "mágica,", "startFrame": 108, "endFrame": 127}, {"text": "mas", "startFrame": 129, "endFrame": 134}, {"text": "é", "startFrame": 134, "endFrame": 137}, {"text": "física!", "startFrame": 137, "endFrame": 146}]}, {"text": "E tudo começa no Sol.", "startFrame": 158, "endFrame": 206, "words": [{"text": "E", "startFrame": 158, "endFrame": 163}, {"text": "tudo", "startFrame": 163, "endFrame": 174}, {"text": "começa", "startFrame": 174, "endFrame": 192}, {"text": "no", "startFrame": 192, "endFrame": 200}, {"text": "Sol.", "startFrame": 200, "endFrame": 206}]}, {"text": "Bora descobrir?", "startFrame": 218, "endFrame": 254, "words": [{"text": "Bora", "startFrame": 218, "endFrame": 228}, {"text": "descobrir?", "startFrame": 228, "endFrame": 254}]}]}, {"id": "prisma", "startFrame": 262, "endFrame": 529, "lines": [{"text": "A luz do Sol parece branca,", "startFrame": 270, "endFrame": 324, "words": [{"text": "A", "startFrame": 270, "endFrame": 275}, {"text": "luz", "startFrame": 275, "endFrame": 282}, {"text": "do", "startFrame": 282, "endFrame": 288}, {"text": "Sol", "startFrame": 288, "endFrame": 294}, {"text": "parece", "startFrame": 294, "endFrame": 308}, {"text": "branca,", "startFrame": 308, "endFrame": 324}]}, {"text": "mas mistura todas as cores do arco-íris:", "startFrame": 328, "endFrame": 405, "words": [{"text": "mas", "startFrame": 328, "endFrame": 333}, {"text": "mistura", "startFrame": 333, "endFrame": 350}, {"text": "todas", "startFrame": 350, "endFrame": 362}, {"text": "as", "startFrame": 362, "endFrame": 367}, {"text": "cores", "startFrame": 367, "endFrame": 378}, {"text": "do", "startFrame": 378, "endFrame": 381}, {"text": "arco-íris:", "startFrame": 381, "endFrame": 405}]}, {"text": "vermelho, laranja, amarelo, verde, azul e violeta, tudo junto!", "startFrame": 409, "endFrame": 521, "words": [{"text": "vermelho,", "startFrame": 409, "endFrame": 427}, {"text": "laranja,", "startFrame": 427, "endFrame": 439}, {"text": "amarelo,", "startFrame": 439, "endFrame": 456}, {"text": "verde,", "startFrame": 456, "endFrame": 469}, {"text": "azul", "startFrame": 469, "endFrame": 475}, {"text": "e", "startFrame": 475, "endFrame": 481}, {"text": "violeta,", "startFrame": 481, "endFrame": 495}, {"text": "tudo", "startFrame": 498, "endFrame": 507}, {"text": "junto!", "startFrame": 507, "endFrame": 521}]}]}, {"id": "espalhamento", "startFrame": 529, "endFrame": 826, "lines": [{"text": "No ar, ela bate em partículas minúsculas.", "startFrame": 537, "endFrame": 616, "words": [{"text": "No", "startFrame": 537, "endFrame": 543}, {"text": "ar,", "startFrame": 543, "endFrame": 548}, {"text": "ela", "startFrame": 548, "endFrame": 555}, {"text": "bate", "startFrame": 555, "endFrame": 562}, {"text": "em", "startFrame": 562, "endFrame": 571}, {"text": "partículas", "startFrame": 571, "endFrame": 594}, {"text": "minúsculas.", "startFrame": 594, "endFrame": 616}]}, {"text": "A luz azul quica muito mais,", "startFrame": 628, "endFrame": 685, "words": [{"text": "A", "startFrame": 628, "endFrame": 631}, {"text": "luz", "startFrame": 631, "endFrame": 636}, {"text": "azul", "startFrame": 636, "endFrame": 650}, {"text": "quica", "startFrame": 650, "endFrame": 660}, {"text": "muito", "startFrame": 660, "endFrame": 675}, {"text": "mais,", "startFrame": 675, "endFrame": 685}]}, {"text": "e se espalha pelo céu inteiro!", "startFrame": 689, "endFrame": 746, "words": [{"text": "e", "startFrame": 689, "endFrame": 693}, {"text": "se", "startFrame": 693, "endFrame": 695}, {"text": "espalha", "startFrame": 695, "endFrame": 711}, {"text": "pelo", "startFrame": 711, "endFrame": 721}, {"text": "céu", "startFrame": 721, "endFrame": 730}, {"text": "inteiro!", "startFrame": 730, "endFrame": 746}]}, {"text": "Já o vermelho passa quase reto.", "startFrame": 757, "endFrame": 817, "words": [{"text": "Já", "startFrame": 757, "endFrame": 764}, {"text": "o", "startFrame": 764, "endFrame": 766}, {"text": "vermelho", "startFrame": 766, "endFrame": 788}, {"text": "passa", "startFrame": 788, "endFrame": 795}, {"text": "quase", "startFrame": 795, "endFrame": 809}, {"text": "reto.", "startFrame": 809, "endFrame": 817}]}]}, {"id": "violeta", "startFrame": 826, "endFrame": 1017, "lines": [{"text": "E o violeta? Espalha ainda mais,", "startFrame": 834, "endFrame": 891, "words": [{"text": "E", "startFrame": 834, "endFrame": 836}, {"text": "o", "startFrame": 836, "endFrame": 838}, {"text": "violeta?", "startFrame": 838, "endFrame": 849}, {"text": "Espalha", "startFrame": 851, "endFrame": 869}, {"text": "ainda", "startFrame": 869, "endFrame": 883}, {"text": "mais,", "startFrame": 883, "endFrame": 891}]}, {"text": "mas o Sol manda pouco violeta, e nossos olhos preferem o azul.", "startFrame": 895, "endFrame": 1009, "words": [{"text": "mas", "startFrame": 895, "endFrame": 899}, {"text": "o", "startFrame": 899, "endFrame": 905}, {"text": "Sol", "startFrame": 905, "endFrame": 910}, {"text": "manda", "startFrame": 910, "endFrame": 921}, {"text": "pouco", "startFrame": 921, "endFrame": 930}, {"text": "violeta,", "startFrame": 930, "endFrame": 946}, {"text": "e", "startFrame": 951, "endFrame": 955}, {"text": "nossos", "startFrame": 955, "endFrame": 965}, {"text": "olhos", "startFrame": 965, "endFrame": 977}, {"text": "preferem", "startFrame": 977, "endFrame": 997}, {"text": "o", "startFrame": 997, "endFrame": 1000}, {"text": "azul.", "startFrame": 1000, "endFrame": 1009}]}]}, {"id": "por-do-sol", "startFrame": 1017, "endFrame": 1289, "lines": [{"text": "No fim da tarde, a luz atravessa muito mais ar.", "startFrame": 1025, "endFrame": 1113, "words": [{"text": "No", "startFrame": 1025, "endFrame": 1030}, {"text": "fim", "startFrame": 1030, "endFrame": 1035}, {"text": "da", "startFrame": 1035, "endFrame": 1040}, {"text": "tarde,", "startFrame": 1040, "endFrame": 1054}, {"text": "a", "startFrame": 1057, "endFrame": 1061}, {"text": "luz", "startFrame": 1061, "endFrame": 1068}, {"text": "atravessa", "startFrame": 1068, "endFrame": 1088}, {"text": "muito", "startFrame": 1088, "endFrame": 1100}, {"text": "mais", "startFrame": 1100, "endFrame": 1110}, {"text": "ar.", "startFrame": 1110, "endFrame": 1113}]}, {"text": "O azul se perde, e sobram o laranja e o vermelho.", "startFrame": 1125, "endFrame": 1213, "words": [{"text": "O", "startFrame": 1125, "endFrame": 1129}, {"text": "azul", "startFrame": 1129, "endFrame": 1137}, {"text": "se", "startFrame": 1137, "endFrame": 1142}, {"text": "perde,", "startFrame": 1142, "endFrame": 1154}, {"text": "e", "startFrame": 1159, "endFrame": 1162}, {"text": "sobram", "startFrame": 1162, "endFrame": 1173}, {"text": "o", "startFrame": 1173, "endFrame": 1179}, {"text": "laranja", "startFrame": 1179, "endFrame": 1191}, {"text": "e", "startFrame": 1191, "endFrame": 1195}, {"text": "o", "startFrame": 1195, "endFrame": 1197}, {"text": "vermelho.", "startFrame": 1197, "endFrame": 1213}]}, {"text": "Por isso o céu fica dourado!", "startFrame": 1225, "endFrame": 1281, "words": [{"text": "Por", "startFrame": 1225, "endFrame": 1233}, {"text": "isso", "startFrame": 1233, "endFrame": 1240}, {"text": "o", "startFrame": 1240, "endFrame": 1243}, {"text": "céu", "startFrame": 1243, "endFrame": 1251}, {"text": "fica", "startFrame": 1251, "endFrame": 1261}, {"text": "dourado!", "startFrame": 1261, "endFrame": 1281}]}]}, {"id": "marte", "startFrame": 1289, "endFrame": 1475, "lines": [{"text": "Em Marte é ao contrário: céu cor de caramelo, e pôr do sol azul!", "startFrame": 1297, "endFrame": 1411, "words": [{"text": "Em", "startFrame": 1297, "endFrame": 1302}, {"text": "Marte", "startFrame": 1302, "endFrame": 1314}, {"text": "é", "startFrame": 1314, "endFrame": 1319}, {"text": "ao", "startFrame": 1319, "endFrame": 1324}, {"text": "contrário:", "startFrame": 1324, "endFrame": 1338}, {"text": "céu", "startFrame": 1344, "endFrame": 1353}, {"text": "cor", "startFrame": 1353, "endFrame": 1359}, {"text": "de", "startFrame": 1359, "endFrame": 1362}, {"text": "caramelo,", "startFrame": 1362, "endFrame": 1381}, {"text": "e", "startFrame": 1381, "endFrame": 1384}, {"text": "pôr", "startFrame": 1384, "endFrame": 1391}, {"text": "do", "startFrame": 1391, "endFrame": 1395}, {"text": "sol", "startFrame": 1395, "endFrame": 1401}, {"text": "azul!", "startFrame": 1401, "endFrame": 1411}]}, {"text": "Culpa da poeira fina.", "startFrame": 1422, "endFrame": 1467, "words": [{"text": "Culpa", "startFrame": 1422, "endFrame": 1434}, {"text": "da", "startFrame": 1434, "endFrame": 1439}, {"text": "poeira", "startFrame": 1439, "endFrame": 1458}, {"text": "fina.", "startFrame": 1458, "endFrame": 1467}]}]}, {"id": "conclusao", "startFrame": 1475, "endFrame": 1805, "lines": [{"text": "Resumindo: o ar espalha a luz azul para todo lado.", "startFrame": 1483, "endFrame": 1572, "words": [{"text": "Resumindo:", "startFrame": 1483, "endFrame": 1502}, {"text": "o", "startFrame": 1504, "endFrame": 1507}, {"text": "ar", "st