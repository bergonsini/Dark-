, {"text": "de", "startFrame": 1140, "endFrame": 1147}, {"text": "vida!", "startFrame": 1147, "endFrame": 1156}]}]}, {"id": "cuidado", "capitulo": "", "startFrame": 1175, "endFrame": 1465, "lines": [{"text": "Mas atenção: não é mágica! O gato pode se machucar feio.", "startFrame": 1194, "endFrame": 1316, "words": [{"text": "Mas", "startFrame": 1194, "endFrame": 1199}, {"text": "atenção:", "startFrame": 1199, "endFrame": 1220}, {"text": "não", "startFrame": 1220, "endFrame": 1233}, {"text": "é", "startFrame": 1233, "endFrame": 1235}, {"text": "mágica!", "startFrame": 1235, "endFrame": 1248}, {"text": "O", "startFrame": 1254, "endFrame": 1258}, {"text": "gato", "startFrame": 1258, "endFrame": 1269}, {"text": "pode", "startFrame": 1269, "endFrame": 1282}, {"text": "se", "startFrame": 1282, "endFrame": 1286}, {"text": "machucar", "startFrame": 1286, "endFrame": 1301}, {"text": "feio.", "startFrame": 1301, "endFrame": 1316}]}, {"text": "Tem gato em casa? Tela de proteção na janela, sempre!", "startFrame": 1327, "endFrame": 1446, "words": [{"text": "Tem", "startFrame": 1327, "endFrame": 1337}, {"text": "gato", "startFrame": 1337, "endFrame": 1345}, {"text": "em", "startFrame": 1345, "endFrame": 1357}, {"text": "casa?", "startFrame": 1357, "endFrame": 1368}, {"text": "Tela", "startFrame": 1376, "endFrame": 1388}, {"text": "de", "startFrame": 1388, "endFrame": 1392}, {"text": "proteção", "startFrame": 1392, "endFrame": 1417}, {"text": "na", "startFrame": 1417, "endFrame": 1421}, {"text": "janela,", "startFrame": 1421, "endFrame": 1435}, {"text": "sempre!", "startFrame": 1437, "endFrame": 1446}]}]}, {"id": "conclusao", "capitulo": "", "startFrame": 1465, "endFrame": 1800, "lines": [{"text": "Resumindo: ouvido que sabe onde é o chão, e um corpo que gira em duas partes!", "startFrame": 1484, "endFrame": 1637, "words": [{"text": "Resumindo:", "startFrame": 1484, "endFrame": 1502}, {"text": "ouvido", "startFrame": 1502, "endFrame": 1520}, {"text": "que", "startFrame": 1520, "end