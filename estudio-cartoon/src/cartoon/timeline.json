{"titulo": "Por que o céu é azul?", "fps": 30, "durationInFrames": 1800, "durationSeconds": 60.0, "engine": "mbrola", "scenes": [{"id": "gancho", "startFrame": 0, "endFrame": 83, "lines": [{"text": "Se a luz do Sol é branca, por que o céu é azul?", "startFrame": 3, "endFrame": 67, "words": [{"text": "Se", "startFrame": 3, "endFrame": 7}, {"text": "a", "startFrame": 7, "endFrame": 10}, {"text": "luz", "startFrame": 10, "endFrame": 16}, {"text": "do", "startFrame": 16, "endFrame": 20}, {"text": "Sol", "startFrame": 20, "endFrame": 25}, {"text": "é", "startFrame": 25, "endFrame": 28}, {"text": "branca,", "startFrame": 28, "endFrame": 37}, {"text": "por", "startFrame": 37, "endFrame": 43}, {"text": "que", "startFrame": 43, "endFrame": 48}, {"text": "o", "startFrame": 48, "endFrame": 51}, {"text": "céu", "startFrame": 51, "endFrame": 57}, {"text": "é", "startFrame": 57, "endFrame": 60}, {"text": "azul?", "startFrame": 60, "endFrame": 67}]}]}, {"id": "problema", "startFrame": 83, "endFrame": 242, "lines": [{"text": "Parece mágica, mas é física!", "startFrame": 99, "endFrame": 145, "words": [{"text": "Parece", "startFrame": 99, "endFrame": 111}, {"text": "mágica,", "startFrame": 111, "endFrame": 123}, {"text": "mas", "startFrame": 123, "endFrame": 130}, {"text": "é", "startFrame": 130, "endFrame": 134}, {"text": "física!", "startFrame": 134, "endFrame": 145}]}, {"text": "E tudo começa lá no Sol.", "startFrame": 151, "endFrame": 186, "words": [{"text": "E", "startFrame": 151, "endFrame": 154}, {"text": "tudo", "startFrame": 154, "endFrame": 161}, {"text": "começa", "startFrame": 161, "endFrame": 171}, {"text": "lá", "startFrame": 171, "endFrame": 176}, {"text": "no", "startFrame": 176, "endFrame": 180}, {"text": "Sol.", "startFrame": 180, "endFrame": 186}]}, {"text": "Bora descobrir juntos?", "startFrame": 192, "endFrame": 226, "words": [{"text": "Bora", "startFrame": 192, "endFrame": 200}, {"text": "descobrir", "startFrame": 200, "endFrame": 215}, {"text": "juntos?", "star