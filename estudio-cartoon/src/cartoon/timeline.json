{"video": "mar-salgado", "titulo": "Por que o mar é salgado?", "fps": 30, "durationInFrames": 1800, "durationSeconds": 60.0, "engine": "elevenlabs", "voz": {"estilo": "documentario", "ritmo": 1.0}, "scenes": [{"id": "gancho", "capitulo": "", "startFrame": 0, "endFrame": 106, "lines": [{"text": "Por que o mar é salgado… e o rio não?", "startFrame": 3, "endFrame": 84, "words": [{"text": "Por", "startFrame": 9, "endFrame": 10}, {"text": "que", "startFrame": 11, "endFrame": 12}, {"text": "o", "startFrame": 15, "endFrame": 17}, {"text": "mar", "startFrame": 20, "endFrame": 22}, {"text": "é", "startFrame": 24, "endFrame": 27}, {"text": "salgado…", "startFrame": 28, "endFrame": 60}, {"text": "e", "startFrame": 61, "endFrame": 63}, {"text": "o", "startFrame": 65, "endFrame": 66}, {"text": "rio", "startFrame": 68, "endFrame": 75}, {"text": "não?", "startFrame": 76, "endFrame": 84}]}]}, {"id": "chuva", "capitulo": "", "startFrame": 106, "endFrame": 333, "lines": [{"text": "Tudo começa com a chuva.", "startFrame": 129, "endFrame": 170, "words": [{"text": "Tudo", "startFrame": 129, "endFrame": 136}, {"text": "começa", "startFrame": 141, "endFrame": 150}, {"text": "com", "startFrame": 152, "endFrame": 153}, {"text": "a", "startFrame": 155, "endFrame": 158}, {"text": "chuva.", "startFrame": 160, "endFrame": 170}]}, {"text": "Ela é levemente ácida e vai desgastando as rochas, bem devagarinho.", "startFrame": 182, "endFrame": 310, "words": [{"text": "Ela", "startFrame": 182, "endFrame": 189}, {"text": "é", "startFrame": 191, "endFrame": 194}, {"text": "levemente", "startFrame": 197, "endFrame": 213}, {"text": "ácida", "startFrame": 218, "endFrame": 233}, {"text": "e", "startFrame": 235, "endFrame": 237}, {"text": "vai", "startFrame": 238, "endFrame": 242}, {"text": "desgastando", "startFrame": 244, "endFrame": 261}, {"text": "as", "startFrame": 263, "endFrame": 266}, {"text": "rochas,", "startFrame": 269, "endFrame": 284}, {"text": "bem", "startFrame": 285, "endFrame": 290}, {"text": "devagarinho.", "startFrame": 292, "endFrame": 310}]}]}, {"id": "rios", "capitulo": "", "startFrame": 333, "endFrame": 555, "lines": [{"text": "Os rios carregam esses sais até o mar.", "startFrame": 355, "endFrame": 425, "words": [{"text": "Os", "startFrame": 355, "endFrame": 360}, {"text": "rios", "startFrame": 363, "endFrame": 370}, {"text": "carregam", "startFrame": 372, "endFrame": 384}, {"text": "esses", "startFrame": 389, "endFrame": 394}, {"text": "sais", "startFrame": 396, "endFrame": 403}, {"text": "até", "startFrame": 406, "endFrame": 412}, {"text": "o", "startFrame": 413, "endFrame": 415}, {"text": "mar.", "startFrame": 419, "endFrame": 425}]}, {"text": "Um pouquinho por vez, durante milhões de anos!", "startFrame": 437, "endFrame": 533, "words": [{"text": "Um", "startFrame": 437, "endFrame": 442}, {"text": "pouquinho", "startFrame": 443, "endFrame": 456}, {"text": "por", "startFrame": 458, "endFrame": 461}, {"text": "vez,", "startFrame": 470, "endFrame": 482}, {"text": "durante", "startFrame": 483, "endFrame": 494}, {"text": "milhões", "startFrame": 496, "endFrame": 514}, {"text": "de", "startFrame": 516, "endFrame": 518}, {"text": "anos!", "startFrame": 521, "endFrame": 533}]}]}, {"id": "evapora", "capitulo": "", "startFrame": 555, "endFrame": 755, "lines": [{"text": "No mar, o Sol evapora a água… mas o sal fica!", "startFrame": 578, "endFrame": 682, "words": [{"text": "No", "startFrame": 578, "endFrame": 583}, {"text": "mar,", "startFrame": 585, "endFrame": 595}, {"text": "o", "startFrame": 597, "endFrame": 599}, {"text": "Sol", "startFrame": 602, "endFrame": 607}, {"text": "evapora", "startFrame": 609, "endFrame": 626}, {"text": "a", "startFrame": 627, "endFrame": 629}, {"text": "água…", "startFrame": 631, "endFrame": 643}, {"text": "mas", "startFrame": 645, "endFrame": 652}, {"text": "o", "startFrame": 655, "endFrame": 657}, {"text": "sal", "startFrame": 658, "endFrame": 667}, {"text": "fica!", "startFrame": 669, "endFrame": 682}]}, {"text": "E vai se acumulando.", "startFrame": 694, "endFrame": 733, "words": [{"text": "E", "startFrame": 694, "endFrame": 696}, {"text": "vai", "startFrame": 701, "endFrame": 703}, {"text": "se", "startFrame": 706, "endFrame": 708}, {"text": "acumulando.", "startFrame": 711, "endFrame": 733}]}]}, {"id": "fundo", "capitulo": "", "startFrame": 755, "endFrame": 937, "lines": [{"text": "E tem mais: no fundo do mar, fontes quentes também soltam minerais.", "startFrame": 778, "endFrame": 914, "words": [{"text": "E", "startFrame": 780, "endFrame": 781}, {"text": "tem", "startFrame": 785, "endFrame": 788}, {"text": "mais:", "startFrame": 791, "endFrame": 812}, {"text": "no", "startFrame": 815, "endFrame": 820}, {"text": "fundo", "startFrame": 822, "endFrame": 827}, {"text": "do", "startFrame": 828, "endFrame": 829}, {"text": "mar,", "startFrame": 832, "endFrame": 844}, {"text": "fontes", "startFrame": 847, "endFrame": 856}, {"text": "quentes", "startFrame": 858, "endFrame": 870}, {"text": "também", "startFrame": 873, "endFrame": 884}, {"text": "soltam", "startFrame": 886, "endFrame": 894}, {"text": "minerais.", "startFrame": 896, "endFrame": 914}]}]}, {"id": "quanto", "capitulo": "", "startFrame": 937, "endFrame": 1243, "lines": [{"text": "Hoje, cada litro de água do mar tem uns 35 gramas de sal!", "startFrame": 959, "endFrame": 1076, "words": [{"text": "Hoje,", "startFrame": 959, "endFrame": 970}, {"text": "cada", "startFrame": 974, "endFrame": 983}, {"text": "litro", "startFrame": 983, "endFrame": 991}, {"text": "de", "startFrame": 991, "endFrame": 994}, {"text": "água", "startFrame": 994, "endFrame": 1003}, {"text": "do", "startFrame": 1003, "endFrame": 1010}, {"text": "mar", "startFrame": 1010, "endFrame": 1014}, {"text": "tem", "startFrame": 1014, "endFrame": 1022}, {"text": "uns", "startFrame": 1022, "endFrame": 1027}, {"text": "35", "startFrame": 1027, "endFrame": 1053}, {"text": "gramas", "startFrame": 1053, "endFrame": 1062}, {"text": "de", "startFrame": 1062, "endFrame": 1067}, {"text": "sal!", "startFrame": 1067, "endFrame": 1076}]}, {"text": "Espalhado na terra, daria uma camada do tamanho de um prédio de 40 andares!", "startFrame": 1088, "endFrame": 1220, "words": [{"text": "Espalhado", "startFrame": 1093, "endFrame": 1104}, {"text": "na", "startFrame": 1105, "endFrame": 1107}, {"text": "terra,", "startFrame": 1109, "endFrame": 1121}, {"text": "daria", "startFrame": 1122, "endFrame": 1131}, {"text": "uma", "startFrame": 1132, "endFrame": 1133}, {"text": "camada", "startFrame": 1135, "endFrame": 1147}, {"text": "do", "startFrame": 1150, "endFrame": 1152}, {"text": "tamanho", "startFrame": 1155, "endFrame": 1162}, {"text": "de", "startFrame": 1164, "endFrame": 1167}, {"text": "um", "startFrame": 1169, "endFrame": 1171}, {"text": "prédio", "startFrame": 1173, "endFrame": 1181}, {"text": "de", "startFrame": 1183, "endFrame": 1186}, {"text": "40", "startFrame": 1187, "endFrame": 1203}, {"text": "andares!", "startFrame": 1205, "endFrame": 1220}]}]}, {"id": "rio", "capitulo": "", "startFrame": 1243, "endFrame": 1478, "lines": [{"text": "E o rio? Ele também leva sal, mas a chuva renova a água o tempo todo.", "startFrame": 1265, "endFrame": 1394, "words": [{"text": "E", "startFrame": 1267, "endFrame": 1268}, {"text": "o", "startFrame": 1269, "endFrame": 1271}, {"text": "rio?", "startFrame": 1272, "endFrame": 1286}, {"text": "Ele", "startFrame": 1290, "endFrame": 1293}, {"text": "também", "startFrame": 1296, "endFrame": 1303}, {"text": "leva", "startFrame": 1305, "endFrame": 1313}, {"text": "sal,", "startFrame": 1316, "endFrame": 1327}, {"text": "mas", "startFrame": 1331, "endFrame": 1334}, {"text": "a", "startFrame": 1337, "endFrame": 1339}, {"text": "chuva", "startFrame": 1341, "endFrame": 1349}, {"text": "renova", "startFrame": 1351, "endFrame": 1361}, {"text": "a", "startFrame": 1363, "endFrame": 1364}, {"text": "água", "startFrame": 1365, "endFrame": 1372}, {"text": "o", "startFrame": 1373, "endFrame": 1375}, {"text": "tempo", "startFrame": 1377, "endFrame": 1382}, {"text": "todo.", "startFrame": 1386, "endFrame": 1394}]}, {"text": "Por isso ele continua docinho.", "startFrame": 1405, "endFrame": 1456, "words": [{"text": "Por", "startFrame": 1405, "endFrame": 1410}, {"text": "isso", "startFrame": 1412, "endFrame": 1417}, {"text": "ele", "startFrame": 1420, "endFrame": 1422}, {"text": "continua", "startFrame": 1427, "endFrame": 1436}, {"text": "docinho.", "startFrame": 1439, "endFrame": 1456}]}]}, {"id": "conclusao", "capitulo": "", "startFrame": 1478, "endFrame": 1800, "lines": [{"text": "Resumindo: o mar guarda o sal de milhões de anos de chuva.", "startFrame": 1501, "endFrame": 1609, "words": [{"text": "Resumindo:", "startFrame": 1501, "endFrame": 1522}, {"text": "o", "startFrame": 1524, "endFrame": 1525}, {"text": "mar", "startFrame": 1527, "endFrame": 1534}, {"text": "guarda", "startFrame": 1539, "endFrame": 1546}, {"text": "o", "startFrame": 1548, "endFrame": 1549}, {"text": "sal", "startFrame": 1551, "endFrame": 1556}, {"text": "de", "startFrame": 1558, "endFrame": 1561}, {"text": "milhões", "startFrame": 1562, "endFrame": 1575}, {"text": "de", "startFrame": 1578, "endFrame": 1580}, {"text": "anos", "startFrame": 1582, "endFrame": 1587}, {"text": "de", "startFrame": 1590, "endFrame": 1592}, {"text": "chuva.", "startFrame": 1594, "endFrame": 1609}]}, {"text": "Você já engoliu água do mar sem querer? Conta aí!", "startFrame": 1620, "endFrame": 1730, "words": [{"text": "Você", "startFrame": 1646, "endFrame": 1651}, {"text": "já", "startFrame": 1654, "endFrame": 1656}, {"text": "engoliu", "startFrame": 1658, "endFrame": 1668}, {"text": "água", "startFrame": 1670, "endFrame": 1675}, {"text": "do", "startFrame": 1678, "endFrame": 1680}, {"text": "mar", "startFrame": 1682, "endFrame": 1685}, {"text": "sem", "startFrame": 1687, "endFrame": 1692}, {"text": "querer?", "startFrame": 1694, "endFrame": 1711}, {"text": "Conta", "startFrame": 1715, "endFrame": 1718}, {"text": "aí!", "startFrame": 1721, "endF