{"video": "vulcoes", "titulo": "Por que vulcões existem?", "fps": 30, "durationInFrames": 1800, "durationSeconds": 60.0, "engine": "elevenlabs", "voz": {"estilo": "documentario", "ritmo": 1.0}, "scenes": [{"id": "gancho", "startFrame": 0, "endFrame": 77, "lines": [{"text": "Por que a Terra cospe fogo?", "startFrame": 3, "endFrame": 68, "words": [{"text": "Por", "startFrame": 3, "endFrame": 9}, {"text": "que", "startFrame": 11, "endFrame": 12}, {"text": "a", "startFrame": 14, "endFrame": 17}, {"text": "Terra", "startFrame": 19, "endFrame": 29}, {"text": "cospe", "startFrame": 33, "endFrame": 45}, {"text": "fogo?", "startFrame": 50, "endFrame": 68}]}]}, {"id": "descida", "startFrame": 77, "endFrame": 252, "lines": [{"text": "Pra entender os vulcões,", "startFrame": 87, "endFrame": 132, "words": [{"text": "Pra", "startFrame": 87, "endFrame": 89}, {"text": "entender", "startFrame": 91, "endFrame": 103}, {"text": "os", "startFrame": 105, "endFrame": 106}, {"text": "vulcões,", "startFrame": 108, "endFrame": 132}]}, {"text": "a gente precisa descer até o centro do planeta.", "startFrame": 136, "endFrame": 242, "words": [{"text": "a", "startFrame": 136, "endFrame": 139}, {"text": "gente", "startFrame": 140, "endFrame": 146}, {"text": "precisa", "startFrame": 148, "endFrame": 160}, {"text": "descer", "startFrame": 165, "endFrame": 172}, {"text": "até", "startFrame": 175, "endFrame": 183}, {"text": "o", "startFrame": 184, "endFrame": 192}, {"text": "centro", "startFrame": 194, "endFrame": 206}, {"text": "do", "startFrame": 208, "endFrame": 211}, {"text": "planeta.", "startFrame": 216, "endFrame": 242}]}]}, {"id": "interior", "startFrame": 252, "endFrame": 461, "lines": [{"text": "Lá embaixo, a Terra é quente como a superfície do Sol.", "startFrame": 262, "endFrame": 382, "words": [{"text": "Lá", "startFrame": 262, "endFrame": 265}, {"text": "embaixo,", "startFrame": 266, "endFrame": 288}, {"text": "a", "startFrame": 290, "endFrame": 292}, {"text": "Terra", "startFrame": 293, "endFrame": 300}, {"text": "é", "startFrame": 305, "endFrame": 306}, {"text": "quente", "startFrame": 307, "endFrame": 319}, {"text": "como", "startFrame": 322, "endFrame": 324}, {"text": "a", "startFrame": 326, "endFrame": 329}, {"text": "superfície", "startFrame": 335, "endFrame": 348}, {"text": "do", "startFrame": 350, "endFrame": 355}, {"text": "Sol.", "startFrame": 358, "endFrame": 382}]}, {"text": "E esse calor quer escapar.", "startFrame": 393, "endFrame": 451, "words": [{"text": "E", "startFrame": 393, "endFrame": 395}, {"text": "esse", "startFrame": 398, "endFrame": 405}, {"text": "calor", "startFrame": 409, "endFrame": 419}, {"text": "quer", "startFrame": 422, "endFrame": 424}, {"text": "escapar.", "startFrame": 428, "endFrame": 451}]}]}, {"id": "placas", "startFrame": 461, "endFrame": 676, "lines": [{"text": "A casca da Terra é quebrada em placas gigantes,", "startFrame": 471, "endFrame": 567, "words": [{"text": "A", "startFrame": 471, "endFrame": 473}, {"text": "casca", "startFrame": 476, "endFrame": 485}, {"text": "da", "startFrame": 488, "endFrame": 490}, {"text": "Terra", "startFrame": 493, "endFrame": 502}, {"text": "é", "startFrame": 505, "endFrame": 507}, {"text": "quebrada", "startFrame": 509, "endFrame": 519}, {"text": "em", "startFrame": 521, "endFrame": 524}, {"text": "placas", "startFrame": 525, "endFrame": 536}, {"text": "gigantes,", "startFrame": 538, "endFrame": 567}]}, {"text": "que se movem devagar, como unhas crescendo.", "startFrame": 571, "endFrame": 666, "words": [{"text": "que", "startFrame": 571, "endFrame": 574}, {"text": "se", "startFrame": 576, "endFrame": 578}, {"text": "movem", "startFrame": 581, "endFrame": 593}, {"text": "devagar,", "startFrame": 596, "endFrame": 618}, {"text": "como", "startFrame": 619, "endFrame": 629}, {"text": "unhas", "startFrame": 631, "endFrame": 641}, {"text": "crescendo.", "startFrame": 643, "endFrame": 666}]}]}, {"id": "magma", "startFrame": 676, "endFrame": 1048, "lines": [{"text": "Quando uma placa afunda embaixo da outra, a rocha derrete e vira magma.", "startFrame": 685, "endFrame": 839, "words": [{"text": "Quando", "startFrame": 685, "endFrame": 692}, {"text": "uma", "startFrame": 696, "endFrame": 700}, {"text": "placa", "startFrame": 702, "endFrame": 712}, {"text": "afunda", "startFrame": 716, "endFrame": 726}, {"text": "embaixo", "startFrame": 728, "endFrame": 740}, {"text": "da", "startFrame": 743, "endFrame": 745}, {"text": "outra,", "startFrame": 748, "endFrame": 766}, {"text": "a", "startFrame": 767, "endFrame": 768}, {"text": "rocha", "startFrame": 769, "endFrame": 779}, {"text": "derrete", "startFrame": 782, "endFrame": 800}, {"text": "e", "startFrame": 802, "endFrame": 803}, {"text": "vira", "startFrame": 805, "endFrame": 812}, {"text": "magma.", "startFrame": 815, "endFrame": 839}]}, {"text": "Mais leve, ele sobe,", "startFrame": 850, "endFrame": 912, "words": [{"text": "Mais", "startFrame": 850, "endFrame": 860}, {"text": "leve,", "startFrame": 862, "endFrame": 882}, {"text": "ele", "startFrame": 885, "endFrame": 888}, {"text": "sobe,", "startFrame": 891, "endFrame": 912}]}, {"text": "junta pressão…", "startFrame": 917, "endFrame": 957, "words": [{"text": "junta", "startFrame": 917, "endFrame": 929}, {"text": "pressão…", "startFrame": 937, "endFrame": 957}]}, {"text": "e explode: erupção!", "startFrame": 968, "endFrame": 1038, "words": [{"text": "e", "startFrame": 968, "endFrame": 971}, {"text": "explode:", "startFrame": 981, "endFrame": 1004}, {"text": "erupção!", "startFrame": 1007, "endFrame": 1038}]}]}, {"id": "brasil", "startFrame": 1048, "endFrame": 1393, "lines": [{"text": "E o Brasil? Fica no meio de uma placa, longe das bordas.", "startFrame": 1058, "endFrame": 1188, "words": [{"text": "E", "startFrame": 1058, "endFrame": 1060}, {"text": "o", "startFrame": 1062, "endFrame": 1063}, {"text": "Brasil?", "startFrame": 1065, "endFrame": 1092}, {"text": "Fica", "startFrame": 1093, "endFrame": 1099}, {"text": "no", "startFrame": 1102, "endFra