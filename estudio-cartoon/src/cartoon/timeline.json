{"video": "mar-salgado", "titulo": "Por que o mar é salgado?", "fps": 30, "durationInFrames": 1800, "durationSeconds": 60.0, "engine": "kokoro", "voz": {"estilo": "documentario", "ritmo": 1.0}, "scenes": [{"id": "gancho", "capitulo": "", "startFrame": 0, "endFrame": 96, "lines": [{"text": "Por que o mar é salgado… e o rio não?", "startFrame": 3, "endFrame": 74, "words": [{"text": "Por", "startFrame": 3, "endFrame": 8}, {"text": "que", "startFrame": 8, "endFrame": 14}, {"text": "o", "startFrame": 14, "endFrame": 17}, {"text": "mar", "startFrame": 17, "endFrame": 25}, {"text": "é", "startFrame": 25, "endFrame": 28}, {"text": "salgado…", "startFrame": 28, "endFrame": 46}, {"text": "e", "startFrame": 48, "endFrame": 53}, {"text": "o", "startFrame": 53, "endFrame": 55}, {"text": "rio", "startFrame": 55, "endFrame": 64}, {"text": "não?", "startFrame": 64, "endFrame": 74}]}]}, {"id": "chuva", "capitulo": "", "startFrame": 96, "endFrame": 333, "lines": [{"text": "Tudo começa com a chuva.", "startFrame": 119, "endFrame": 173, "words": [{"text": "Tudo", "startFrame": 119, "endFrame": 129}, {"text": "começa", "startFrame": 129, "endFrame": 147}, {"text": "com", "startFrame": 147, "endFrame": 158}, {"text": "a", "startFrame": 158, "endFrame": 162}, {"text": "chuva.", "startFrame": 162, "endFrame": 173}]}, {"text": "Ela é levemente ácida e vai desgastando as rochas, bem devagarinho.", "startFrame": 184, "endFrame": 310, "words": [{"text": "Ela", "startFrame": 184, "endFrame": 192}, {"text": "é", "startFrame": 192, "endFrame": 196}, {"text": "levemente", "startFrame": 196, "endFrame": 216}, {"text": "ácida", "startFrame": 216, "endFrame": 229}, {"text": "e", "startFrame": 229, "endFrame": 233}, {"text": "vai", "startFrame": 233, "endFrame": 243}, {"text": "desgastando", "startFrame": 243, "endFrame": 261}, {"text": "as", "startFrame": 261, "endFrame": 266}, {"text": "rochas,", "startFrame": 266, "endFrame": 276}, {"text": "bem", "startFrame": 276, "endFrame": 287}, {"text": "devagarinho.", "startFrame": 287, "endFrame": 310}]}]}, {"id": "rios", "capitulo": "", "startFrame": 333, "endFrame": 560, "lines": [{"text": "Os rios carregam esses sais até o mar.", "startFrame": 355, "endFrame": 434, "words": [{"text": "Os", "startFrame": 355, "endFrame": 362}, {"text": "rios", "startFrame": 362, "endFrame": 372}, {"text": "carregam", "startFrame": 372, "endFrame": 391}, {"text": "esses", "startFrame": 391, "endFrame": 405}, {"text": "sais", "startFrame": 405, "endFrame": 415}, {"text": "até", "startFrame": 415, "endFrame": 425}, {"text": "o", "startFrame": 425, "endFrame": 429}, {"text": "mar.", "startFrame": 429, "endFrame": 434}]}, {"text": "Um pouquinho por vez, durante milhões de anos!", "startFrame": 445, "endFrame": 538, "words": [{"text": "Um", "startFrame": 445, "endFrame": 451}, {"text": "pouquinho", "startFrame": 451, "endFrame": 470}, {"text": "por", "startFrame": 470, "endFrame": 477}, {"text": "vez,", "startFrame": 477, "endFrame": 482}, {"text": "durante", "startFrame": 487, "endFrame": 505}, {"text": "milhões", "startFrame": 505, "endFrame": 523}, {"text": "de", "startFrame": 523, "endFrame": 528}, {"text": "anos!", "startFrame": 528, "endFrame": 538}]}]}, {"id": "evapora", "capitulo": "", "startFrame": 560, "endFrame": 758, "lines": [{"text": "No mar, o Sol evapora a água… mas o sal fica!", "startFrame": 583, "endFrame": 677, "words": [{"text": "No", "startFrame": 583, "endFrame": 588}, {"text": "mar,", "startFrame": 588, "endFrame": 596}, {"text": "o", "startFrame": 598, "endFrame": 604}, {"text": "Sol", "startFrame": 604, "endFrame": 616}, {"text": "evapora", "startFrame": 616, "endFrame": 645}, {"text": "a", "startFrame": 645, "endFrame": 652}, {"text": "água…", "startFrame": 652, "endFrame": 667}, {"text": "mas", "startFrame": 669, "endFrame": 671}, {"text": "o", "startFrame": 671, "endFrame": 672}, {"text": "sal", "startFrame": 672, "endFrame": 676}, {"text": "fica!", "startFrame": 676, "endFrame": 677}]}, {"text": "E vai se acumulando.", "startFrame": 689, "endFrame": 735, "words": [{"text": "E", "startFrame": 689, "endFrame": 694}, {"text": "vai", "startFrame": 694, "endFrame": 701}, {"text": "se", "startFrame": 701, "endFrame": 705}, {"text": "acumulando.", "startFrame": 705, "endFrame": 735}]}]}, {"id": "fundo", "capitulo": "", "startFrame": 758, "endFrame": 933, "lines": [{"text": "E tem mais: no fundo do mar, fontes quentes também soltam minerais.", "startFrame": 780, "endFrame": 910, "words": [{"text": "E", "startFrame": 780, "endFrame": 785}, {"text": "tem", "startFrame": 785, "endFrame": 791}, {"text": "mais:", "startFrame": 791, "endFrame": 801}, {"text": "no", "startFrame": 801, "endFrame": 807}, {"text": "fundo", "startFrame": 807, "endFrame": 818}, {"text": "do", "startFrame": 818, "endFrame": 826}, {"text": "mar,", "startFrame": 826, "endFrame": 831}, {"text": "fontes", "startFrame": 835, "endFrame": 847}, {"text": "quentes", "startFrame": 847, "endFrame": 861}, {"text": "também", "startFrame": 861, "endFrame": 877}, {"text": "soltam", "startFrame": 877, "endFrame": 894}, {"text": "minerais.", "startFrame": 894, "endFrame": 910}]}]}, {"id": "quanto", "capitulo": "", "startFrame": 933, "endFrame": 1260, "lines": [{"text": "Hoje, cada litro de água do mar tem uns 35 gramas de sal!", "startFrame": 955, "endFrame": 1082, "words": [{"text": "Hoje,", "startFrame": 955, "endFrame": 967}, {"text": "cada", "startFrame": 970, "endFrame": 975}, {"text": "litro", "startFrame": 975, "endFrame": 984}, {"text": "de", "startFrame": 984, "endFrame": 989}, {"text": "água", "startFrame": 989, "endFrame": 998}, {"text": "do", "startFrame": 998, "endFrame": 1000}, {"text": "mar", "startFrame": 1000, "endFrame": 1003}, {"text": "tem", "startFrame": 1003, "endFrame": 1013}, {"text": "uns", "startFrame": 1017, "endFrame": 1025}, {"text": "35", "startFrame": 1025, "endFrame": 1054}, {"text": "gramas", "startFrame": 1054, "endFrame": 1066}, {"text": "de", "startFrame": 1066, "endFrame": 1075}, {"text": "sal!", "startFrame": 1075, "endFrame": 1082}]}, {"text": "Espalhado na terra, daria uma camada do tamanho de um prédio de 40 andares!", "startFrame": 1093, "endFrame": 1238, "words": [{"text": "Espalhado", "startFrame": 1093, "endFrame": 1115}, {"text": "na", "startFrame": 1115, "endFrame": 1119}, {"text": "terra,", "startFrame": 1119, "endFrame": 1129}, {"text": "daria", "startFrame": 1137, "endFrame": 1147}, {"text": "uma", "startFrame": 1147, "endFrame": 1152}, {"text": "camada", "startFrame": 1152, "endFrame": 1167}, {"text": "do", "startFrame": 1167, "endFrame": 1170}, {"text": "tamanho", "startFrame": 1170, "endFrame": 1181}, {"text": "de", "startFrame": 1181, "endFrame": 1186}, {"text": "um", "startFrame": 1186, "endFrame": 1192}, {"text": "prédio", "startFrame": 1192, "endFrame": 1203}, {"text": "de", "startFrame": 1203, "endFrame": 1208}, {"text": "40", "startFrame": 1208, "endFrame": 1225}, {"text": "andares!", "startFrame": 1225, "endFrame": 1238}]}]}, {"id": "rio", "capitulo": "", "startFrame": 1260, "endFrame": 1501, "lines": [{"text": "E o rio? Ele também leva sal, mas a chuva renova a água o tempo todo.", "startFrame": 1283, "endFrame": 1409, "words": [{"text": "E", "startFrame": 1283, "endFrame": 1286}, {"text": "o", "startFrame": 1286, "endFrame": 1291}, {"text": "rio?", "startFrame": 1291, "endFrame": 1299}, {"text": "Ele", "startFrame": 1301, "endFrame": 1306}, {"text": "também", "startFrame": 1306, "endFrame": 1323}, {"text": "leva", "startFrame": 1323, "endFrame": 1330}, {"text": "sal,", "startFrame": 1330, "endFrame": 1336}, {"text": "mas", "startFrame": 1341, "endFrame": 1345}, {"text": "a", "startFrame": 1345, "endFrame": 1349}, {"text": "chuva", "startFrame": 1349, "endFrame": 1357}, {"text": "renova", "startFrame": 1357, "endFrame": 1370}, {"text": "a", "startFrame": 1370, "endFrame": 1375}, {"text": "água", "startFrame": 1375, "endFrame": 1385}, {"text": "o", "startFrame": 1385, "endFrame": 1387}, {"text": "tempo", "startFrame": 1387, "endFrame": 1401}, {"text": "todo.", "startFrame": 1401, "endFrame": 1409}]}, {"text": "Por isso ele continua docinho.", "startFrame": 1420, "endFrame": 1478, "words": [{"text": "Por", "startFrame": 1420, "endFrame": 1426}, {"text": "isso", "startFrame": 1426, "endFrame": 1432}, {"text": "ele", "startFrame": 1432, "endFrame": 1440}, {"text": "continua", "startFrame": 1440, "endFrame": 1461}, {"text": "docinho.", "startFrame": 1461, "endFrame": 1478}]}]}, {"id": "conclusao", "capitulo": "", "startFrame": 1501, "endFrame": 1800, "lines": [{"text": "Resumindo: o mar guarda o sal de milhões de anos de chuva.", "startFrame": 1523, "endFrame": 1632, "words": [{"text": "Resumindo:", "startFrame": 1523, "endFrame": 1543}, {"text": "o", "startFrame": 1547, "endFrame": 1551}, {"text": "mar", "startFrame": 1551, "endFrame": 1558}, {"text": "guarda", "startFrame": 1558, "endFrame": 1573}, {"text": "o", "startFrame": 1573, "endFrame": 1575}, {"text": "sal", "startFrame": 1575, "endFrame": 1582}, {"text": "de", "startFrame": 1582, "endFrame": 1589}, {"text": "milhões", "startFrame": 1589, "endFrame": 1601}, {"text": "de", "startFrame": 1601, "endFrame": 1608}, {"text": "anos", "startFrame": 1608, "endFrame": 1618}, {"text": "de", "startFrame": 1618, "endFrame": 1624}, {"text": "chuva.", "startFrame": 1624, "endFrame": 1632}]}, {"text": "Você já engoliu água do mar sem querer? Conta aí!", "startFrame": 1643, "endFrame": 1734, "words": [{"text": "Você", "startFrame": 1643, "endFrame": 1652}, {"text": "já", "startFrame": 1652, "endFrame": 1654}, {"text": "engoliu", "startFrame": 1654, "endFrame": 1672}, {"text": "água", "startFrame": 1672, "endFrame": 1680}, {"text": "do", "startFrame": 1680, "endFrame": 1687}, {"text": "mar", "startFrame": 1687, "endFrame": 1692}, {"text": "sem", "startFrame": 1692, "endFrame": 1697}, {"text": "querer?", "startFrame": 1697, "endFrame": 1708}, {"text": "Conta", "startFrame": 1713, "endFrame": 1727}, {"text": "aí!", "startFrame": 1727, "endFrame": 173