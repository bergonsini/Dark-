{"video": "gelo-boia", "titulo": "Por que o gelo boia?", "fps": 30, "durationInFrames": 1800, "durationSeconds": 60.0, "engine": "kokoro", "voz": {"estilo": "documentario", "ritmo": 1.0}, "scenes": [{"id": "gancho", "capitulo": "", "startFrame": 0, "endFrame": 68, "lines": [{"text": "Por que o gelo boia?", "startFrame": 3, "endFrame": 45, "words": [{"text": "Por", "startFrame": 3, "endFrame": 9}, {"text": "que", "startFrame": 9, "endFrame": 16}, {"text": "o", "startFrame": 16, "endFrame": 20}, {"text": "gelo", "startFrame": 20, "endFrame": 29}, {"text": "boia?", "startFrame": 29, "endFrame": 45}]}]}, {"id": "estranho", "capitulo": "", "startFrame": 68, "endFrame": 328, "lines": [{"text": "Era pra afundar! Quase tudo, quando vira sólido, fica mais apertado e mais pesado.", "startFrame": 90, "endFrame": 244, "words": [{"text": "Era", "startFrame": 90, "endFrame": 98}, {"text": "pra", "startFrame": 98, "endFrame": 104}, {"text": "afundar!", "startFrame": 104, "endFrame": 119}, {"text": "Quase", "startFrame": 125, "endFrame": 130}, {"text": "tudo,", "startFrame": 130, "endFrame": 132}, {"text": "quando", "startFrame": 134, "endFrame": 146}, {"text": "vira", "startFrame": 146, "endFrame": 158}, {"text": "sólido,", "startFrame": 158, "endFrame": 175}, {"text": "fica", "startFrame": 175, "endFrame": 183}, {"text": "mais", "startFrame": 183, "endFrame": 194}, {"text": "apertado", "startFrame": 194, "endFrame": 215}, {"text": "e", "startFrame": 215, "endFrame": 218}, {"text": "mais", "startFrame": 218, "endFrame": 228}, {"text": "pesado.", "startFrame": 228, "endFrame": 244}]}, {"text": "A água faz o contrário.", "startFrame": 255, "endFrame": 306, "words": [{"text": "A", "startFrame": 255, "endFrame": 260}, {"text": "água", "startFrame": 260, "endFrame": 273}, {"text": "faz", "startFrame": 273, "endFrame": 280}, {"text": "o", "startFrame": 280, "endFrame": 283}, {"text": "contrário.", "startFrame": 283, "endFrame": 306}]}]}, {"id": "ciranda", "capitulo": "", "startFrame": 328, "endFrame": 678, "lines": [{"text": "Quando congela, as moléculas de água se dão as mãos, tipo roda de ciranda.", "startFrame": 351, "endFrame": 489, "words": [{"text": "Quando", "startFrame": 351, "endFrame": 364}, {"text": "congela,", "startFrame": 364, "endFrame": 377}, {"text": "as", "startFrame": 377, "endFrame": 382}, {"text": "moléculas", "startFrame": 382, "endFrame": 399}, {"text": "de", "startFrame": 399, "endFrame": 401}, {"text": "água", "startFrame": 401, "endFrame": 411}, {"text": "se", "startFrame": 411, "endFrame": 414}, {"text": "dão", "startFrame": 414, "endFrame": 427}, {"text": "as", "startFrame": 427, "endFrame": 429}, {"text": "mãos,", "startFrame": 429, "endFrame": 441}, {"text": "tipo", "startFrame": 446, "endFrame": 458}, {"text": "roda", "startFrame": 458, "endFrame": 466}, {"text": "de", "startFrame": 466, "endFrame": 473}, {"text": "ciranda.", "startFrame": 473, "endFrame": 489}]}, {"text": "Fica tudo espaçoso, com buraco no meio, e o gelo ocupa uns nove por cento a mais.", "startFrame": 500, "endFrame": 655, "words": [{"text": "Fica", "startFrame": 500, "endFrame": 510}, {"text": "tudo", "startFrame": 510, "endFrame": 515}, {"text": "espaçoso,", "startFrame": 515, "endFrame": 538}, {"text": "com", "startFrame": 538, "endFrame": 540}, {"text": "buraco", "startFrame": 540, "endFrame": 555}, {"text": "no", "startFrame": 555, "endFrame": 559}, {"text": "meio,", "startFrame": 559, "endFrame": 571}, {"text": "e", "startFrame": 580, "endFrame": 583}, {"text": "o", "startFrame": 583, "endFrame": 587}, {"text": "gelo", "startFrame": 587, "endFrame": 595}, {"text": "ocupa", "startFrame": 595, "endFrame": 608}, {"text": "uns", "startFrame": 608, "endFrame": 616}, {"text": "nove", "startFrame": 616, "endFrame": 624}, {"text": "por", "startFrame": 624, "endFrame": 629}, {"text": "cento", "startFrame": 629, "endFrame": 644}, {"text": "a", "startFrame": 644, "endFrame": 647}, {"text": "mais.", "startFrame": 647, "endFrame": 655}]}]}, {"id": "boia", "capitulo": "", "startFrame": 678, "endFrame": 1003, "lines": [{"text": "Mais espaço com o mesmo peso: o gelo fica mais leve que a água e flutua.", "startFrame": 700, "endFrame": 842, "words": [{"text": "Mais", "startFrame": 700, "endFrame": 709}, {"text": "espaço", "startFrame": 709, "endFrame": 726}, {"text": "com", "startFrame": 726, "endFrame": 732}, {"text": "o", "startFrame": 732, "endFrame": 737}, {"text": "mesmo", "startFrame": 737, "endFrame": 747}, {"text": "peso:", "startFrame": 747, "endFrame": 756}, {"text": "o", "startFrame": 765, "endFrame": 769}, {"text": "gelo", "startFrame": 769, "endFrame": 778}, {"text": "fica", "startFrame": 778, "endFrame": 785}, {"text": "mais", "startFrame": 785, "endFrame": 795}, {"text": "leve", "startFrame": 795, "endFrame": 806}, {"text": "que", "startFrame": 806, "endFrame": 812}, {"text": "a", "startFrame": 812, "endFrame": 814}, {"text": "água", "startFrame": 814, "endFrame": 822}, {"text": "e", "startFrame": 822, "endFrame": 829}, {"text": "flutua.", "startFrame": 829, "endFrame": 842}]}, {"text": "Só uns dez por cento ficam pra fora. É a famosa ponta do iceberg!", "startFrame": 853, "endFrame": 981, "words": [{"text": "Só", "startFrame": 853, "endFrame": 857}, {"text": "uns", "startFrame": 857, "endFrame": 863}, {"text": "dez", "startFrame": 863, "endFrame": 870}, {"text": "por", "startFrame": 870, "endFrame": 874}, {"text": "cento", "startFrame": 874, "endFrame": 890}, {"text": "ficam", "startFrame": 890, "endFrame": 905}, {"text": "pra", "startFrame": 905, "endFrame": 908}, {"text": "fora.", "startFrame": 908, "endFrame": 918}, {"text": "É", "startFrame": 926, "endFrame": 931}, {"text": "a", "startFrame": 931, "endFrame": 933}, {"text": "famosa", "startFrame": 933, "endFrame": 947}, {"text": "ponta", "startFrame": 947, "endFrame": 956}, {"text": "do", "startFrame": 956, "endFrame": 962}, {"text": "iceberg!", "startFrame": 962, "endFrame": 981}]}]}, {"id": "garrafa", "capitulo": "", "startFrame": 1003, "endFrame": 