{"titulo": "Por que o céu é azul?", "fps": 30, "durationInFrames": 2126, "durationSeconds": 70.863, "engine": "elevenlabs", "voz": {"estilo": "documentario", "ritmo": 1.07}, "scenes": [{"id": "gancho", "startFrame": 0, "endFrame": 97, "lines": [{"text": "Se o Sol é branco, por que o céu é azul?", "startFrame": 3, "endFrame": 88, "words": [{"text": "Se", "startFrame": 3, "endFrame": 8}, {"text": "o", "startFrame": 9, "endFrame": 10}, {"text": "Sol", "startFrame": 12, "endFrame": 16}, {"text": "é", "startFrame": 19, "endFrame": 21}, {"text": "branco,", "startFrame": 23, "endFrame": 46}, {"text": "por", "startFrame": 48, "endFrame": 50}, {"text": "que", "startFrame": 52, "endFrame": 55}, {"text": "o", "startFrame": 57, "endFrame": 59}, {"text": "céu", "startFrame": 61, "endFrame": 68}, {"text": "é", "startFrame": 70, "endFrame": 71}, {"text": "azul?", "startFrame": 73, "endFrame": 88}]}]}, {"id": "problema", "startFrame": 97, "endFrame": 297, "lines": [{"text": "Parece mágica, mas é física!", "startFrame": 105, "endFrame": 179, "words": [{"text": "Parece", "startFrame": 105, "endFrame": 118}, {"text": "mágica,", "startFrame": 121, "endFrame": 142}, {"text": "mas", "startFrame": 143, "endFrame": 148}, {"text": "é", "startFrame": 152, "endFrame": 153}, {"text": "física!", "startFrame": 154, "endFrame": 179}]}, {"text": "E tudo começa no Sol.", "startFrame": 191, "endFrame": 247, "words": [{"text": "E", "startFrame": 191, "endFrame": 194}, {"text": "tudo", "startFrame": 197, "endFrame": 204}, {"text": "começa", "startFrame": 206, "endFrame": 220}, {"text": "no", "startFrame": 223, "endFrame": 227}, {"text": "Sol.", "startFrame": 237, "endFrame": 247}]}, {"text": "Bora descobrir?", "startFrame": 258, "endFrame": 289, "words": [{"text": "Bora", "startFrame": 258, "endFrame": 265}, {"text": "descobrir?", "startFrame": 268, "endFrame": 289}]}]}, {"id": "prisma", "startFrame": 297, "endFrame": 638, "lines": [{"text": "A luz do Sol parece branca,", "startFrame": 306, "endFrame": 367, "words": [{"text": "A", "startFrame": 306, "endFrame": 308}, {"text": "luz", "startFrame": 310, "endFrame": 315}, {"text": "do", "startFrame": 318, "endFrame": 321}, {"text": "Sol", "startFrame": 326, "endFrame": 330}, {"text": "parece", "startFrame": 332, "endFrame": 346}, {"text": "branca,", "startFrame": 348, "endFrame": 366}]}, {"text": "mas mistura todas as cores do arco-íris:", "startFrame": 371, "endFrame": 458, "words": [{"text": "mas", "startFrame": 371, "endFrame": 375}, {"text": "mistura", "startFrame": 377, "endFrame": 395}, {"text": "todas", "startFrame": 398, "endFrame": 406}, {"text": "as", "startFrame": 409, "endFrame": 413}, {"text": "cores", "startFrame": 415, "endFrame": 422}, {"text": "do", "startFrame": 424, "endFrame": 426}, {"text": "arco-íris:", "startFrame": 427, "endFrame": 458}]}, {"text": "vermelho, laranja, amarelo, verde, azul e violeta, tudo junto!", "startFrame": 463, "endFrame": 630, "words": [{"text": "vermelho,", "startFrame": 463, "endFrame": 487}, {"text": "laranja,", "startFrame": 491, "endFrame": 510}, {"text": "amarelo,", "startFrame": 512, "endFrame": 537}, {"text": "verde,", "startFrame": 541, "endFrame": 555}, {"text": "azul", "startFrame": 557, "endFrame": 568}, {"text": "e", "startFrame": 570, "endFrame": 573}, {"text": "violeta,", "startFrame": 575, "endFrame": 599}, {"text": "tudo", "startFrame": 602, "endFrame": 611}, {"text": "junto!", "startFrame": 612, "endFrame": 629}]}]}, {"id": "espalhamento", "startFrame": 638, "endFrame": 984, "lines": [{"text": "No ar, ela bate em partículas minúsculas.", "startFrame": 646, "endFrame": 740, "words": [{"text": "No", "startFrame": 646, "endFrame": 651}, {"text": "ar,", "startFrame": 653, "endFrame": 664}, {"text": "ela", "startFrame": 666, "endFrame": 673}, {"text": "bate", "startFrame": 675, "endFrame": 682}, {"text": "em", "startFrame": 684, "endFrame": 686}, {"text": "partículas", "startFrame": 690, "endFrame": 704}, {"text": "minúsculas.", "startFrame": 709, "endFrame": 740}]}, {"text": "A luz azul quica muito mais,", "startFrame": 751, "endFrame": 817, "words": [{"text": "A", "startFrame": 751, "endFrame": 754}, {"text": "luz", "startFrame": 755, "endFrame": 760}, {"text": "azul", "startFrame": 765, "endFrame": 774}, {"text": "quica", "startFrame": 775, "endFrame": 785}, {"text": "muito", "startFrame": 787, "endFrame": 799}, {"text": "mais,", "startFrame": 802, "endFrame": 816}]}, {"text": "e se espalha pelo céu inteiro!", "startFrame": 821, "endFrame": 895, "words": [{"text": "e", "startFrame": 821, "endFrame": 823}, {"text": "se", "startFrame": 825, "endFrame": 828}, {"text": "espalha", "startFrame": 831, "endFrame": 843}, {"text": "pelo", "startFrame": 846, "endFrame": 852}, {"text": "céu", "startFrame": 855, "endFrame": 860}, {"text": "inteiro!", "startFrame": 861, "endFrame": 894}]}, {"text": "Já o vermelho passa quase reto.", "startFrame": 906, "endFrame": 976, "words": [{"text": "Já", "startFrame": 906, "endFrame": 910}, {"text": "o", "startFrame": 913, "endFrame": 914}, {"text": "vermelho", "startFrame": 915, "endFrame": 933}, {"text": "passa", "startFrame": 936, "endFrame": 944}, {"text": "quase", "startFrame": 946, "endFrame": 958}, {"text": "reto.", "startFrame": 962, "endFrame": 976}]}]}, {"id": "violeta", "startFrame": 984, "endFrame": 1234, "lines": [{"text": "E o violeta? Espalha ainda mais,", "startFrame": 992, "endFrame": 1082, "words": [{"text": "E", "startFrame": 992, "endFrame": 994}, {"text": "o", "startFrame": 995, "endFrame": 996}, {"text": "violeta?", "startFrame": 998, "endFrame": 1026}, {"text": "Espalha", "startFrame": 1030, "endFrame": 1044}, {"text": "ainda", "startFrame": 1049, "endFrame": 1059}, {"text": "mais,", "startFrame": 1061, "endFrame": 1082}]}, {"text": "mas o Sol manda pouco violeta, e nossos olhos preferem o azul.", "startFrame": 1086, "endFrame": 1226, "words": [{"text": "mas", "startFrame": 1086, "endFrame": 1091}, {"text": "o", "startFrame": 1093, "endFrame": 1095}, {"text": "Sol", "