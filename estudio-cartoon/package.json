{
  "name": "estudio-cartoon",
  "version": "1.0.0",
  "description": "Estúdio de vídeos educativos animados em 2D (skill cartoon-explainer) com Remotion",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.78.0",
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@react-three/fiber": "^9.8.2",
    "@remotion/cli": "4.0.543",
    "@remotion/three": "^4.0.543",
    "@remotion/transitions": "^4.0.543",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.543",
    "three": "^0.171.0"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.543",
    "@types/react": "19.3.0",
    "@types/three": "^0.171.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "audio": "python3 .claude/skills/cartoon-explainer/scripts/generate_audio.py",
    "studio": "remotion studio",
    "still": "remotion still CartoonExplainer out/thumb.png --frame=45",
    "render": "remotion render CartoonExplainer out/video.mp4",
    "qa": "python3 .claude/skills/cartoon-explainer/scripts/qa_check.py out/video.mp4",
    "video": "npm run audio && npm run render && npm run qa",
    "typecheck": "tsc --noEmit",
    "voz:instalar": "python3 .claude/skills/cartoon-explainer/scripts/instalar_voz.py",
    "titorei:audio": "python3 .claude/skills/cartoon-explainer/scripts/generate_audio.py --roteiro titorei/roteiro.json",
    "titorei:render": "remotion render TitoRei out/titorei.mp4",
    "titorei:qa": "python3 .claude/skills/cartoon-explainer/scripts/qa_check.py out/titorei.mp4 --timeline src/titorei/timeline.json --audio public/titorei/audio",
    "titorei:video": "npm run titorei:audio && npm run titorei:render && npm run titorei:qa",
    "inutilidades:audio": "python3 .claude/skills/cartoon-explainer/scripts/generate_audio.py --roteiro inutilidades/roteiro.json",
    "inutilidades:render": "remotion render Inutilidades out/inutilidades.mp4 --concurrency=4",
    "inutilidades:qa": "python3 .claude/skills/cartoon-explainer/scripts/qa_check.py out/inutilidades.mp4 --timeline src/inutilidades/timeline.json --audio public/inutilidades/audio",
    "inutilidades:video": "npm run inutilidades:audio && npm run inutilidades:render && npm run inutilidades:qa",
    "panela:audio": "python3 .claude/skills/cartoon-explainer/scripts/generate_audio.py --roteiro panela/roteiro.json",
    "panela:render": "remotion render PanelaDepressao out/panela.mp4 --concurrency=2",
    "panela:qa": "python3 .claude/skills/cartoon-explainer/scripts/qa_check.py out/panela.mp4 --timeline src/panela/timeline.json --audio public/panela/audio",
    "desafio:audio": "python3 .claude/skills/desafio/scripts/desafio_audio.py",
    "desafio:render": "remotion render Desafio out/desafio.mp4 --concurrency=4",
    "desafio:qa": "python3 .claude/skills/desafio/scripts/desafio_qa.py",
    "desafio:video": "npm run desafio:audio && npm run desafio:render && npm run desafio:qa"
  },
  "allowScripts": {
    "esbuild": false
  }
}
