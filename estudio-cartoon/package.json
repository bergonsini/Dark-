{
  "name": "estudio-cartoon",
  "version": "1.0.0",
  "description": "Estúdio de vídeos educativos animados em 2D (skill cartoon-explainer) com Remotion",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@remotion/cli": "4.0.543",
    "@remotion/transitions": "^4.0.543",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.543"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.543",
    "@types/react": "19.3.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "audio": "python3 .claude/skills/cartoon-explainer/scripts/generate_audio.py",
    "studio": "remotion studio",
    "still": "remotion still CartoonExplainer out/thumb.png --frame=45",
    "render": "remotion render CartoonExplainer out/video.mp4",
    "qa": "python3 .claude/skills/cartoon-explainer/scripts/qa_check.py out/video.mp4",
    "video": "npm run audio && npm run render && npm run qa",
    "typecheck": "tsc --noEmit"
  },
  "allowScripts": {
    "esbuild": false
  }
}
